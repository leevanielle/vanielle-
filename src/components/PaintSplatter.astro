<span class="paint-splatter" data-paint-splatter aria-hidden="true">
  <canvas></canvas>
</span>

<script>
  import {
    Mesh,
    OrthographicCamera,
    PlaneGeometry,
    Scene,
    ShaderMaterial,
    WebGLRenderer,
  } from "three";

  const vertexShader = /* glsl */ `
    varying vec2 vUv;

    void main() {
      vUv = uv;
      gl_Position = vec4(position, 1.0);
    }
  `;

  const fragmentShader = /* glsl */ `
    precision highp float;

    uniform float uTime;
    uniform float uReveal;
    uniform float uAspect;
    varying vec2 vUv;

    float hash(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }

    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
        mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0)), f.x),
        f.y
      );
    }

    float fbm(vec2 p) {
      float value = 0.0;
      float amplitude = 0.5;
      mat2 turn = mat2(0.82, -0.57, 0.57, 0.82);
      for (int i = 0; i < 5; i++) {
        value += amplitude * noise(p);
        p = turn * p * 2.03 + 7.1;
        amplitude *= 0.5;
      }
      return value;
    }

    float drop(vec2 p, vec2 center, float radius) {
      float wobble = noise((p - center) * 22.0) * 0.025;
      return 1.0 - smoothstep(radius - 0.025, radius + 0.02, length(p - center) + wobble);
    }

    void main() {
      vec2 p = vec2((vUv.x - 0.5) * uAspect, vUv.y - 0.5);
      float drift = uTime * 0.035;
      float broad = fbm(vec2(p.x * 1.4 + drift, p.y * 3.1 - drift));
      float fine = fbm(vec2(p.x * 4.0 - drift, p.y * 8.0 + drift));

      vec2 warped = p;
      warped.y += sin(p.x * 3.2 + broad * 3.4) * 0.055;
      warped.x += (broad - 0.5) * 0.12;

      float halfWidth = uAspect * 0.5;
      float ellipse = length(vec2(warped.x / (halfWidth * 0.84), warped.y / 0.4));
      float roughEdge = 0.86 + broad * 0.18 + fine * 0.055;
      float paint = 1.0 - smoothstep(roughEdge - 0.055, roughEdge + 0.035, ellipse);

      float brush = 1.0 - smoothstep(
        0.25 + broad * 0.08,
        0.34 + broad * 0.1,
        abs(warped.y + sin(p.x * 6.0 + fine * 2.0) * 0.035)
      );
      float taper = 1.0 - smoothstep(0.72, 0.98, abs(p.x) / halfWidth);
      paint = max(paint, brush * taper * 0.94);

      paint = max(paint, drop(p, vec2(-halfWidth * 0.83, 0.39), 0.075));
      paint = max(paint, drop(p, vec2(-halfWidth * 0.68, -0.43), 0.045));
      paint = max(paint, drop(p, vec2(halfWidth * 0.72, 0.37), 0.06));
      paint = max(paint, drop(p, vec2(halfWidth * 0.87, -0.31), 0.035));
      paint = max(paint, drop(p, vec2(halfWidth * 0.45, -0.47), 0.028));
      paint = max(paint, drop(p, vec2(-halfWidth * 0.31, 0.46), 0.03));

      float sweep = 1.0 - smoothstep(uReveal - 0.08, uReveal + 0.055, vUv.x + (fine - 0.5) * 0.08);
      paint *= sweep;

      float marble = fbm(vec2(p.x * 2.3 + broad, p.y * 7.0 - broad + drift));
      float vein = smoothstep(0.68, 0.96, sin((marble + p.x * 0.13) * 31.0) * 0.5 + 0.5);
      vec3 deepRed = vec3(0.52, 0.035, 0.025);
      vec3 vermilion = vec3(0.87, 0.055, 0.035);
      vec3 highlight = vec3(1.0, 0.18, 0.12);
      vec3 color = mix(deepRed, vermilion, 0.48 + broad * 0.52);
      color = mix(color, highlight, vein * 0.34);

      float bristle = smoothstep(0.72, 1.0, fine) * 0.15;
      float alpha = clamp(paint * (0.9 + bristle), 0.0, 0.98);
      gl_FragColor = vec4(color, alpha);
    }
  `;

  const instances = document.querySelectorAll<HTMLElement>(
    "[data-paint-splatter]:not([data-ready])"
  );

  instances.forEach(root => {
    root.dataset.ready = "true";
    const canvas = root.querySelector<HTMLCanvasElement>("canvas");
    if (!canvas) return;

    let renderer: WebGLRenderer | undefined;
    let frame = 0;
    let active = true;
    let lastFrame = 0;
    const startedAt = performance.now();
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    try {
      renderer = new WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
        premultipliedAlpha: true,
      });
    } catch {
      root.classList.add("is-fallback");
      return;
    }

    renderer.setClearColor(0x000000, 0);
    renderer.setPixelRatio(
      Math.min(
        window.devicePixelRatio || 1,
        window.innerWidth < 700 ? 1.25 : 1.7
      )
    );

    const scene = new Scene();
    const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const uniforms = {
      uTime: { value: 0 },
      uReveal: { value: reducedMotion ? 1.1 : 0 },
      uAspect: { value: 3.4 },
    };
    const material = new ShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms,
      transparent: true,
      depthTest: false,
      depthWrite: false,
    });
    const geometry = new PlaneGeometry(2, 2);
    scene.add(new Mesh(geometry, material));

    const resize = () => {
      if (!renderer) return;
      const width = Math.max(1, root.clientWidth);
      const height = Math.max(1, root.clientHeight);
      renderer.setSize(width, height, false);
      uniforms.uAspect.value = width / height;
      renderer.render(scene, camera);
    };

    const render = (now: number) => {
      if (!renderer || !active) return;
      frame = requestAnimationFrame(render);
      if (now - lastFrame < 32) return;
      lastFrame = now;

      const elapsed = (now - startedAt) / 1000;
      const reveal = Math.min(1, elapsed / 0.95);
      uniforms.uReveal.value = 1.08 * (1.0 - Math.pow(1.0 - reveal, 3.0));
      uniforms.uTime.value = elapsed;
      renderer.render(scene, camera);
    };

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(root);

    const intersectionObserver = new IntersectionObserver(entries => {
      active = entries[0]?.isIntersecting ?? false;
      if (active && !reducedMotion && !frame) {
        frame = requestAnimationFrame(render);
      }
      if (!active && frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
    });
    intersectionObserver.observe(root);

    resize();
    if (reducedMotion) {
      renderer.render(scene, camera);
    } else {
      frame = requestAnimationFrame(render);
    }

    const cleanup = () => {
      active = false;
      if (frame) cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      geometry.dispose();
      material.dispose();
      renderer?.dispose();
    };

    document.addEventListener("astro:before-swap", cleanup, { once: true });
  });
</script>

<style>
  .paint-splatter {
    position: absolute;
    z-index: 0;
    inset: -0.2em -0.24em -0.14em -0.22em;
    display: block;
    pointer-events: none;
    transform: rotate(-1.2deg) scale(1.03);
    transform-origin: center;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .paint-splatter.is-fallback::before {
    content: "";
    position: absolute;
    inset: 15% -3%;
    background: #cf2f21;
    clip-path: polygon(
      0 37%,
      8% 22%,
      22% 28%,
      34% 14%,
      51% 25%,
      67% 11%,
      81% 29%,
      100% 20%,
      95% 71%,
      80% 78%,
      63% 68%,
      46% 83%,
      27% 69%,
      11% 81%
    );
  }
</style>
