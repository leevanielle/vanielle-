<span class="paint-splatter" data-paint-splatter aria-hidden="true">
  <canvas></canvas>
</span>

<script>
  import {
    Mesh,
    OrthographicCamera,
    PlaneGeometry,
    Scene,
    ShaderMaterial,
    WebGLRenderer,
  } from "three";

  const vertexShader = /* glsl */ `
    varying vec2 vUv;

    void main() {
      vUv = uv;
      gl_Position = vec4(position, 1.0);
    }
  `;

  const fragmentShader = /* glsl */ `
    precision highp float;

    uniform float uTime;
    uniform float uReveal;
    uniform float uAspect;
    varying vec2 vUv;

    float hash(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }

    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
        mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0)), f.x),
        f.y
      );
    }

    float fbm(vec2 p) {
      float value = 0.0;
      float amplitude = 0.5;
      mat2 turn = mat2(0.82, -0.57, 0.57, 0.82);
      for (int i = 0; i < 5; i++) {
        value += amplitude * noise(p);
        p = turn * p * 2.03 + 7.1;
        amplitude *= 0.5;
      }
      return value;
    }

    float drop(vec2 p, vec2 center, float radius) {
      float wobble = (noise((p - center) * 24.0) - 0.5) * 0.035;
      return 1.0 - smoothstep(radius - 0.01, radius + 0.012, length(p - center) + wobble);
    }

    float ray(vec2 p, vec2 direction, float start, float finish, float width) {
      vec2 side = vec2(-direction.y, direction.x);
      float along = dot(p, direction);
      float across = abs(dot(p, side));
      float progress = smoothstep(start, finish, along);
      float taper = mix(width, width * 0.08, progress);
      float sides = 1.0 - smoothstep(taper, taper + 0.012, across);
      float begins = smoothstep(start - 0.08, start + 0.02, along);
      float ends = 1.0 - smoothstep(finish - 0.035, finish + 0.025, along);
      return sides * begins * ends;
    }

    float capsule(vec2 p, vec2 a, vec2 b, float radius) {
      vec2 pa = p - a;
      vec2 ba = b - a;
      float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
      return 1.0 - smoothstep(radius - 0.01, radius + 0.012, length(pa - ba * h));
    }

    void main() {
      vec2 p = vec2((vUv.x - 0.5) * uAspect, vUv.y - 0.5);
      float drift = uTime * 0.035;
      float broad = fbm(vec2(p.x * 1.4 + drift, p.y * 3.1 - drift));
      float fine = fbm(vec2(p.x * 4.0 - drift, p.y * 8.0 + drift));
      float halfWidth = uAspect * 0.5;
      vec2 q = vec2(p.x / (halfWidth * 0.78), p.y / 0.48);
      q.x += (broad - 0.5) * 0.045;
      q.y += (fine - 0.5) * 0.035;

      vec2 body = vec2(q.x * 0.75, q.y);
      float angle = atan(body.y, body.x);
      float radius = length(body);
      float edgeNoise = fbm(vec2(cos(angle), sin(angle)) * 3.8 + 5.7);
      float jaggedEdge = 0.73
        + sin(angle * 5.0 + 0.7) * 0.07
        + sin(angle * 11.0 - 1.2) * 0.045
        + sin(angle * 19.0 + 2.4) * 0.025
        + (edgeNoise - 0.5) * 0.15;
      float paint = 1.0 - smoothstep(jaggedEdge - 0.012, jaggedEdge + 0.018, radius);

      paint = max(paint, ray(q, normalize(vec2(-0.82, 0.57)), 0.45, 1.18, 0.085));
      paint = max(paint, ray(q, normalize(vec2(-0.48, 0.88)), 0.48, 1.05, 0.06));
      paint = max(paint, ray(q, normalize(vec2(0.12, 0.99)), 0.5, 1.02, 0.045));
      paint = max(paint, ray(q, normalize(vec2(0.64, 0.77)), 0.46, 1.08, 0.065));
      paint = max(paint, ray(q, normalize(vec2(0.98, 0.21)), 0.5, 1.24, 0.055));
      paint = max(paint, ray(q, normalize(vec2(0.91, -0.41)), 0.47, 1.12, 0.05));
      paint = max(paint, ray(q, normalize(vec2(-0.95, -0.32)), 0.46, 1.13, 0.07));
      paint = max(paint, ray(q, normalize(vec2(-0.58, -0.82)), 0.5, 1.03, 0.055));

      float heavyDrip = capsule(q, vec2(0.15, -0.32), vec2(0.27, -0.88), 0.075);
      heavyDrip = max(heavyDrip, drop(q, vec2(0.27, -0.89), 0.1));
      paint = max(paint, heavyDrip);

      paint = max(paint, drop(q, vec2(-0.69, 0.88), 0.075));
      paint = max(paint, drop(q, vec2(-0.91, 0.76), 0.052));
      paint = max(paint, drop(q, vec2(-1.04, 0.64), 0.038));
      paint = max(paint, drop(q, vec2(0.71, 0.87), 0.044));
      paint = max(paint, drop(q, vec2(1.04, 0.63), 0.055));
      paint = max(paint, drop(q, vec2(1.2, 0.18), 0.032));
      paint = max(paint, drop(q, vec2(-1.13, -0.46), 0.03));

      float revealFront = uReveal * 1.5;
      float impactReveal = 1.0 - smoothstep(
        revealFront - 0.18,
        revealFront + 0.025,
        radius + (fine - 0.5) * 0.08
      );
      paint *= impactReveal;

      float marble = fbm(vec2(p.x * 2.3 + broad, p.y * 7.0 - broad + drift));
      float vein = smoothstep(0.68, 0.96, sin((marble + p.x * 0.13) * 31.0) * 0.5 + 0.5);
      vec3 deepRed = vec3(0.52, 0.035, 0.025);
      vec3 vermilion = vec3(0.87, 0.055, 0.035);
      vec3 highlight = vec3(1.0, 0.18, 0.12);
      vec3 color = mix(deepRed, vermilion, 0.48 + broad * 0.52);
      color = mix(color, highlight, vein * 0.34);

      float bristle = smoothstep(0.72, 1.0, fine) * 0.15;
      float alpha = clamp(paint * (0.9 + bristle), 0.0, 0.98);
      gl_FragColor = vec4(color, alpha);
    }
  `;

  const instances = document.querySelectorAll<HTMLElement>(
    "[data-paint-splatter]:not([data-ready])"
  );

  instances.forEach(root => {
    root.dataset.ready = "true";
    const canvas = root.querySelector<HTMLCanvasElement>("canvas");
    if (!canvas) return;

    let renderer: WebGLRenderer | undefined;
    let frame = 0;
    let active = true;
    let lastFrame = 0;
    const startedAt = performance.now();
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    try {
      renderer = new WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
        premultipliedAlpha: true,
      });
    } catch {
      root.classList.add("is-fallback");
      return;
    }

    renderer.setClearColor(0x000000, 0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2.5));

    const scene = new Scene();
    const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const uniforms = {
      uTime: { value: 0 },
      uReveal: { value: reducedMotion ? 1.1 : 0 },
      uAspect: { value: 3.4 },
    };
    const material = new ShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms,
      transparent: true,
      depthTest: false,
      depthWrite: false,
    });
    const geometry = new PlaneGeometry(2, 2);
    scene.add(new Mesh(geometry, material));

    const resize = () => {
      if (!renderer) return;
      const width = Math.max(1, root.clientWidth);
      const height = Math.max(1, root.clientHeight);
      renderer.setSize(width, height, false);
      uniforms.uAspect.value = width / height;
      renderer.render(scene, camera);
    };

    const render = (now: number) => {
      if (!renderer || !active) return;
      frame = requestAnimationFrame(render);
      if (now - lastFrame < 32) return;
      lastFrame = now;

      const elapsed = (now - startedAt) / 1000;
      const reveal = Math.min(1, elapsed / 0.95);
      uniforms.uReveal.value = 1.08 * (1.0 - Math.pow(1.0 - reveal, 3.0));
      uniforms.uTime.value = elapsed;
      renderer.render(scene, camera);
    };

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(root);

    const intersectionObserver = new IntersectionObserver(entries => {
      active = entries[0]?.isIntersecting ?? false;
      if (active && !reducedMotion && !frame) {
        frame = requestAnimationFrame(render);
      }
      if (!active && frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
    });
    intersectionObserver.observe(root);

    resize();
    if (reducedMotion) {
      renderer.render(scene, camera);
    } else {
      frame = requestAnimationFrame(render);
    }

    const cleanup = () => {
      active = false;
      if (frame) cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      geometry.dispose();
      material.dispose();
      renderer?.dispose();
    };

    document.addEventListener("astro:before-swap", cleanup, { once: true });
  });
</script>

<style>
  .paint-splatter {
    position: absolute;
    z-index: 0;
    inset: -0.8em -0.5em -0.65em -0.48em;
    display: block;
    pointer-events: none;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .paint-splatter.is-fallback::before {
    content: "";
    position: absolute;
    inset: 7% -1% 5%;
    background: #cf2f21;
    clip-path: polygon(
      0 44%,
      16% 37%,
      5% 23%,
      28% 32%,
      25% 5%,
      41% 27%,
      49% 0,
      55% 28%,
      76% 10%,
      70% 34%,
      100% 27%,
      82% 48%,
      96% 63%,
      71% 59%,
      66% 84%,
      54% 65%,
      49% 100%,
      42% 65%,
      20% 84%,
      27% 60%,
      4% 68%,
      20% 51%
    );
  }
  .paint-splatter.is-fallback::after {
    content: "";
    position: absolute;
    width: 0.075em;
    aspect-ratio: 1;
    border-radius: 50%;
    top: 2%;
    left: 20%;
    background: #cf2f21;
    box-shadow:
      -0.18em 0.08em 0 -0.015em #cf2f21,
      0.7em -0.04em 0 -0.018em #cf2f21,
      1.7em 0.22em 0 -0.022em #cf2f21;
  }
</style>
