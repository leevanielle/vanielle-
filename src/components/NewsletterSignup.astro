---
interface Props {
  variant?: "default" | "editorial";
  idPrefix?: string;
}

const { variant = "default", idPrefix = "newsletter" } = Astro.props;
const newsletterAction = import.meta.env.PUBLIC_NEWSLETTER_ACTION?.trim();
const isConfigured = Boolean(newsletterAction);
const basePath = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const emailId = `${idPrefix}-email`;
const helpId = `${idPrefix}-help`;
const statusId = `${idPrefix}-status`;
const companyId = `${idPrefix}-company`;
---

<form
  class:list={[
    "newsletter-form",
    variant === "editorial" && "newsletter-form--editorial",
  ]}
  action={isConfigured ? newsletterAction : undefined}
  method="post"
  data-configured={String(isConfigured)}
  novalidate
>
  <label class="email-label" for={emailId}>Email address</label>
  <div class="field-row">
    <input
      id={emailId}
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      placeholder="you@example.com"
      aria-describedby={`${helpId} ${statusId}`}
      required
    />
    <button type="submit" aria-label="Join the field notes">
      {
        variant === "editorial" ? (
          <span aria-hidden="true">→</span>
        ) : (
          <>
            Send me the next note <span aria-hidden="true">→</span>
          </>
        )
      }
    </button>
  </div>

  <input type="hidden" name="source" value={`website-${variant}`} />
  <div class="honeypot" aria-hidden="true">
    <label for={companyId}>Company website</label>
    <input
      id={companyId}
      name="company_website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="form-meta">
    <p id={helpId} class="help">
      {
        variant === "editorial"
          ? "Occasional. No spam. "
          : "No spam. Unsubscribe anytime. "
      }
      <a href={`${basePath}privacy`}>Privacy</a>.
    </p>
  </div>

  <p id={statusId} class="status" role="status" aria-live="polite"></p>
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>(
    ".newsletter-form:not([data-bound])"
  );

  forms.forEach(form => {
    form.dataset.bound = "true";
    const email = form.querySelector<HTMLInputElement>("input[type='email']");
    const status = form.querySelector<HTMLParagraphElement>(".status");
    const button = form.querySelector<HTMLButtonElement>(
      "button[type='submit']"
    );
    const originalButton = button?.innerHTML ?? "";

    email?.addEventListener("input", () => {
      if (!status) return;
      email.removeAttribute("aria-invalid");
      status.textContent = "";
    });

    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (!email || !status) return;

      if (!email.validity.valid) {
        status.textContent =
          "Enter a valid email address, such as you@example.com.";
        email.setAttribute("aria-invalid", "true");
        email.focus();
        return;
      }

      email.removeAttribute("aria-invalid");

      if (form.dataset.configured !== "true") {
        status.textContent =
          "The signup design is ready; the mailing-list connection is the final step.";
        return;
      }

      if (button) {
        button.disabled = true;
        button.textContent = "Joining…";
      }
      status.textContent = "Adding you to the field notes…";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const payload = await response.json().catch(() => ({}));

        if (!response.ok || payload.ok !== true) {
          throw new Error(payload.error || "Unable to subscribe right now.");
        }

        form.reset();
        status.textContent =
          "You’re on the list. Watch your inbox for the next note.";
        window.dispatchEvent(
          new CustomEvent("vanielle:analytics", {
            detail: {
              event: "newsletter_signup_completed",
              properties: {
                form_variant: form.classList.contains(
                  "newsletter-form--editorial"
                )
                  ? "editorial"
                  : "default",
              },
            },
          })
        );
      } catch (error) {
        status.textContent =
          error instanceof Error
            ? error.message
            : "Unable to subscribe right now. Please try again.";
      } finally {
        if (button) {
          button.disabled = false;
          button.innerHTML = originalButton;
        }
      }
    });
  });
</script>

<style>
  .newsletter-form {
    color: #fbf8ef;
  }
  .newsletter-form:not(.newsletter-form--editorial) .email-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .field-row {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) auto;
    gap: 0.6rem;
  }
  input,
  .newsletter-form .field-row button {
    min-height: 52px;
    border-radius: 0;
    font: inherit;
  }
  input {
    width: 100%;
    border: 1px solid #8b857a;
    padding: 0 0.95rem;
    background: #fbf8ef;
    color: #171713;
    box-shadow: none;
  }
  input::placeholder {
    color: #777064;
  }
  input[aria-invalid="true"] {
    border-color: #ef746d;
    box-shadow: inset 0 0 0 1px #ef746d;
  }
  .newsletter-form .field-row button {
    border: 1px solid #cf2f21;
    padding: 0 1rem;
    background: #cf2f21;
    color: white;
    cursor: pointer;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.015em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background 170ms ease,
      border-color 170ms ease,
      transform 170ms ease;
  }
  .newsletter-form .field-row button:hover {
    border-color: #e63b2c;
    background: #e63b2c;
    transform: translateY(-2px);
  }
  .newsletter-form .field-row button:disabled {
    opacity: 0.72;
    cursor: wait;
    transform: none;
  }
  .form-meta {
    margin-top: 0.62rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .help,
  .status {
    margin: 0;
    font-size: 0.65rem;
    line-height: 1.45;
  }
  .help {
    color: #aaa59b;
  }
  .help a {
    color: #d6d1c8;
    text-underline-offset: 3px;
  }
  .status {
    min-height: 1.05rem;
    margin-top: 0.4rem;
    color: #efaaa5;
    font-weight: 650;
  }

  .newsletter-form--editorial {
    width: 100%;
    max-width: 560px;
    color: #191915;
    font-family: "Instrument Sans", sans-serif;
  }
  .newsletter-form--editorial .email-label {
    margin-bottom: 0.5rem;
    display: block;
    color: #716a60;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .newsletter-form--editorial .field-row {
    grid-template-columns: minmax(0, 1fr) 62px;
    gap: 0;
    padding: 5px;
    border: 1px solid rgba(25, 25, 21, 0.62);
    background: #fffdf8;
    box-shadow: 0 16px 40px rgba(52, 43, 31, 0.08);
  }
  .newsletter-form--editorial input {
    min-width: 0;
    min-height: 56px;
    border: 0;
    padding: 0 1rem;
    background: transparent;
    font-size: 0.95rem;
  }
  .newsletter-form--editorial input:focus {
    outline: 2px solid #ef746d;
    outline-offset: -2px;
  }
  .newsletter-form--editorial .field-row button {
    width: 62px;
    min-height: 56px;
    border: 0;
    padding: 0;
    font-family: "Instrument Sans", sans-serif;
    font-size: 1.35rem;
  }
  .newsletter-form--editorial .field-row button:hover {
    border-color: #191915;
    background: #191915;
    transform: translateX(2px);
  }
  .newsletter-form--editorial .help {
    color: #6f685e;
  }
  .newsletter-form--editorial .help a {
    color: #191915;
  }
  .newsletter-form--editorial .status {
    color: #cf2f21;
  }

  @media (max-width: 560px) {
    .field-row {
      grid-template-columns: 1fr;
    }
    .newsletter-form .field-row button {
      width: 100%;
    }
    .newsletter-form--editorial .field-row {
      grid-template-columns: minmax(0, 1fr) 56px;
    }
    .newsletter-form--editorial .field-row button {
      width: 56px;
    }
    .form-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .newsletter-form .field-row button {
      transition: none;
    }
  }
</style>
