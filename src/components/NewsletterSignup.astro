---
const newsletterAction = import.meta.env.PUBLIC_NEWSLETTER_ACTION?.trim();
const isConfigured = Boolean(newsletterAction);
const basePath = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<form
  id="newsletter-form"
  class="newsletter-form"
  action={isConfigured ? newsletterAction : undefined}
  method="post"
  data-configured={String(isConfigured)}
  novalidate
>
  <label for="newsletter-email">Email address</label>
  <div class="field-row">
    <input
      id="newsletter-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      placeholder="you@example.com"
      aria-describedby="newsletter-help newsletter-status"
      required
    />
    <button type="submit">
      Send me the next note <span aria-hidden="true">→</span>
    </button>
  </div>

  <div class="form-meta">
    <p id="newsletter-help" class="help">
      No spam. Unsubscribe anytime. <a href={`${basePath}privacy`}>Privacy</a>.
    </p>
    {
      !isConfigured && (
        <p class="preview-note">Preview build · Connection pending</p>
      )
    }
  </div>

  <p id="newsletter-status" class="status" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("#newsletter-form");
  const email = document.querySelector<HTMLInputElement>("#newsletter-email");
  const status =
    document.querySelector<HTMLParagraphElement>("#newsletter-status");

  email?.addEventListener("input", () => {
    if (!status) return;
    email.removeAttribute("aria-invalid");
    status.textContent = "";
  });

  form?.addEventListener("submit", event => {
    if (!email || !status) return;

    if (!email.validity.valid) {
      event.preventDefault();
      status.textContent =
        "Enter a valid email address, such as you@example.com.";
      email.setAttribute("aria-invalid", "true");
      email.focus();
      return;
    }

    email.removeAttribute("aria-invalid");

    if (form.dataset.configured !== "true") {
      event.preventDefault();
      status.textContent =
        "The signup design is ready; the mailing-list connection is the final step.";
      return;
    }

    const button = form.querySelector<HTMLButtonElement>(
      "button[type='submit']"
    );
    if (button) {
      button.disabled = true;
      button.textContent = "Joining…";
    }
  });
</script>

<style>
  .newsletter-form {
    color: #fbf8ef;
  }
  label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .field-row {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) auto;
    gap: 0.6rem;
  }
  input,
  .newsletter-form .field-row button {
    min-height: 52px;
    border-radius: 0;
    font: inherit;
  }
  input {
    width: 100%;
    border: 1px solid #8b857a;
    padding: 0 0.95rem;
    background: #fbf8ef;
    color: #171713;
    box-shadow: none;
  }
  input::placeholder {
    color: #777064;
  }
  input[aria-invalid="true"] {
    border-color: #ef746d;
    box-shadow: inset 0 0 0 1px #ef746d;
  }
  .newsletter-form .field-row button {
    border: 1px solid #cf2f21;
    padding: 0 1rem;
    background: #cf2f21;
    color: white;
    cursor: pointer;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.015em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background 170ms ease,
      border-color 170ms ease,
      transform 170ms ease;
  }
  .newsletter-form .field-row button:hover {
    border-color: #e63b2c;
    background: #e63b2c;
    transform: translateY(-2px);
  }
  .newsletter-form .field-row button:disabled {
    opacity: 0.72;
    cursor: wait;
    transform: none;
  }
  .form-meta {
    margin-top: 0.62rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .help,
  .preview-note,
  .status {
    margin: 0;
    font-size: 0.65rem;
    line-height: 1.45;
  }
  .help {
    color: #aaa59b;
  }
  .help a {
    color: #d6d1c8;
    text-underline-offset: 3px;
  }
  .preview-note {
    color: #d9a738;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.55rem;
    letter-spacing: 0.04em;
    text-align: right;
    text-transform: uppercase;
  }
  .status {
    min-height: 1.05rem;
    margin-top: 0.4rem;
    color: #efaaa5;
    font-weight: 650;
  }

  @media (max-width: 560px) {
    .field-row {
      grid-template-columns: 1fr;
    }
    .newsletter-form .field-row button {
      width: 100%;
    }
    .form-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
    .preview-note {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .newsletter-form .field-row button {
      transition: none;
    }
  }
</style>
