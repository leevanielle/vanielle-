---
const newsletterAction = import.meta.env.PUBLIC_NEWSLETTER_ACTION?.trim();
const isConfigured = Boolean(newsletterAction);
const basePath = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<div class="signup-card">
  <div class="signup-topline">
    <span>Low frequency</span>
    <span>No noise</span>
  </div>
  <form
    id="newsletter-form"
    action={isConfigured ? newsletterAction : undefined}
    method="post"
    data-configured={String(isConfigured)}
    novalidate
  >
    <label for="newsletter-email">Email address</label>
    <div class="field-row">
      <input
        id="newsletter-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder="you@example.com"
        aria-describedby="newsletter-help newsletter-status"
        required
      />
      <button type="submit"
        >Get the field notes <span aria-hidden="true">→</span></button
      >
    </div>
    <p id="newsletter-help" class="help">
      Unsubscribe anytime. Your address is never sold. <a
        href={`${basePath}privacy`}>Privacy details</a
      >.
    </p>
    <p id="newsletter-status" class="status" role="status" aria-live="polite">
    </p>
  </form>
  {
    !isConfigured && (
      <p class="preview-note">
        Preview mode: connect the newsletter provider before launch.
      </p>
    )
  }
</div>

<script>
  const form = document.querySelector<HTMLFormElement>("#newsletter-form");
  const email = document.querySelector<HTMLInputElement>("#newsletter-email");
  const status =
    document.querySelector<HTMLParagraphElement>("#newsletter-status");

  form?.addEventListener("submit", event => {
    if (!email || !status) return;

    if (!email.validity.valid) {
      event.preventDefault();
      status.textContent =
        "Enter a valid email address, such as you@example.com.";
      email.setAttribute("aria-invalid", "true");
      email.focus();
      return;
    }

    email.removeAttribute("aria-invalid");

    if (form.dataset.configured !== "true") {
      event.preventDefault();
      status.textContent =
        "Signup is in preview mode while the email list is connected.";
      return;
    }

    const button = form.querySelector<HTMLButtonElement>(
      "button[type='submit']"
    );
    if (button) {
      button.disabled = true;
      button.textContent = "Joining…";
    }
  });
</script>

<style>
  .signup-card {
    padding: clamp(1.35rem, 4vw, 2rem);
    border: 1px solid #191915;
    border-radius: 4px;
    background: #cf2f21;
    color: white;
    box-shadow: 12px 12px 0 #d4a33b;
  }
  .signup-topline {
    display: flex;
    justify-content: space-between;
    padding-bottom: 2.8rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  label {
    display: block;
    margin-bottom: 0.65rem;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }
  input,
  button {
    min-height: 50px;
    border: 0;
    border-radius: 4px;
    font: inherit;
  }
  input {
    width: 100%;
    padding: 0 1rem;
    background: white;
    color: #171828;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }
  input::placeholder {
    color: #8a8c9b;
  }
  input[aria-invalid="true"] {
    box-shadow: inset 0 0 0 2px #d4a33b;
  }
  button {
    width: 100%;
    padding: 0 1.1rem;
    background: #171828;
    color: white;
    cursor: pointer;
    font-size: 0.83rem;
    font-weight: 750;
    white-space: nowrap;
  }
  button:hover {
    background: #282a40;
  }
  button:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  .help,
  .status,
  .preview-note {
    margin: 0.75rem 0 0;
    font-size: 0.72rem;
    line-height: 1.45;
  }
  .help {
    color: #f9ded8;
  }
  .help a {
    color: white;
    text-underline-offset: 3px;
  }
  .status {
    min-height: 1.1em;
    color: #fff1ef;
    font-weight: 650;
  }
  .preview-note {
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    color: #f1c8c2;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
