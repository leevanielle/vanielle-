---
interface Props {
  showSocials?: boolean;
}

const { showSocials = true } = Astro.props;
---

<footer class="journal-footer">
  <div>
    <strong>Vanielle Lee</strong>
    <span>AI engineer · Founder · CTO · Author</span>
  </div>
  {
    showSocials && (
      <nav aria-label="Social links">
        <a
          href="https://x.com/lee_vanielle"
          target="_blank"
          rel="noopener noreferrer">X</a
        >
        <a
          href="https://www.threads.com/@leevanielle"
          target="_blank"
          rel="noopener noreferrer">Threads</a
        >
        <a
          href="https://github.com/leevanielle"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </nav>
    )
  }
</footer>

<style>
  .journal-footer {
    width: min(100% - 2rem, 1240px);
    max-width: none;
    min-height: 130px;
    margin-inline: auto;
    padding: 1.5rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid rgba(25, 25, 21, 0.46);
    color: #191915;
    font-family: "Instrument Sans", sans-serif;
  }
  .journal-footer > div {
    display: grid;
    gap: 0.25rem;
  }
  .journal-footer strong {
    font-size: 0.86rem;
  }
  .journal-footer span {
    color: #746e64;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.55rem;
    text-transform: uppercase;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a {
    color: #191915;
    font-size: 0.74rem;
    text-decoration: none;
  }
  nav a:hover {
    color: #cf2f21;
  }

  @media (max-width: 620px) {
    .journal-footer {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 1rem;
    }
  }
</style>
