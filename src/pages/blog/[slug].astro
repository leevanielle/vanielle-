---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { slugifyStr } from "@utils/slugify";

export interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const allPosts = getSortedPosts(await getCollection("blog"));
const currentIndex = allPosts.findIndex(item => item.slug === post.slug);
const nextPost = allPosts[(currentIndex + 1) % allPosts.length];

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;
const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(date);
---

<Layout
  title={`${title} — Vanielle Lee`}
  {author}
  {description}
  {pubDatetime}
  {modDatetime}
  {canonicalURL}
  ogImage={ogUrl}
>
  <div class="article-page">
    <div class="cinema-entry" aria-hidden="true">
      <span>Field note / {tags[0] ?? "journal"}</span>
    </div>

    <main>
      <header class="article-heading">
        <div class="article-heading-bar">
          <a href="/" data-astro-reload>
            <span aria-hidden="true">←</span>
            <strong>Journal index</strong>
            <small>All field notes</small>
          </a>
          <span class="article-type">Field note</span>
        </div>

        <div class="article-heading-grid">
          <aside class="article-meta" aria-label="Article details">
            <span class="article-meta-label">Filed</span>
            <time datetime={pubDatetime.toISOString()}
              >{formatDate(pubDatetime)}</time
            >
            <span>By {author}</span>
            <span class="field-marker" aria-hidden="true">
              <i></i><b></b>
            </span>
          </aside>

          <div class="article-lede">
            <h1>{title}</h1>
            <p class="article-description">{description}</p>
          </div>
        </div>
      </header>

      <article class="article-body" role="article">
        <Content />
      </article>

      <section class="after-note" aria-label="Continue reading">
        <div class="join-note">
          <p>Next transmission</p>
          <h2>Get the next note.</h2>
          <NewsletterSignup />
        </div>
        {
          nextPost && nextPost.slug !== post.slug && (
            <a class="next-note" href={`/blog/${nextPost.slug}/`}>
              <span>Continue reading</span>
              <strong>{nextPost.data.title}</strong>
              <i>↗</i>
            </a>
          )
        }
      </section>
    </main>
  </div>
</Layout>

<style>
  :global(body) {
    background: #0f0f0d;
  }
  .article-page {
    --ink: #f2ede3;
    --paper: #151512;
    --paper-deep: #211f1a;
    --red: #ef746d;
    --amber: #d9a738;
    --muted: #aaa296;
    --body-copy: #d4cec2;
    --rule: rgba(242, 237, 227, 0.22);
    min-height: 100svh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    color-scheme: dark;
    font-family: "Instrument Sans", sans-serif;
  }
  .article-page ::selection {
    background: var(--red);
    color: #151512;
  }
  .cinema-entry {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    place-items: center;
    background: #0f0f0d;
    color: var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
    animation: clear-frame 0.95s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }
  main,
  .after-note {
    max-width: none;
  }
  main {
    width: min(100% - 2rem, 1240px);
    margin-inline: auto;
  }
  .article-heading {
    padding: clamp(2rem, 4vw, 3.75rem) 0 0;
  }
  .article-heading-bar {
    min-height: 66px;
    padding: 0 0 1.15rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .article-heading-bar > a {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0.08rem 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .article-heading-bar > a > span {
    grid-row: 1 / span 2;
    color: var(--red);
    font-size: 1.4rem;
    transition: transform 180ms ease;
  }
  .article-heading-bar > a > strong,
  .article-heading-bar > a > small,
  .article-type,
  .article-meta {
    font-family: "IBM Plex Mono", monospace;
    text-transform: uppercase;
  }
  .article-heading-bar > a > strong {
    font-size: clamp(0.88rem, 1.2vw, 1.02rem);
    letter-spacing: 0.04em;
  }
  .article-heading-bar > a > small {
    color: var(--muted);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
  }
  .article-heading-bar > a:hover > span {
    transform: translateX(-0.35rem);
  }
  .article-heading-bar > a:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 7px;
  }
  .article-type {
    color: var(--red);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }
  .article-heading-grid {
    display: grid;
    grid-template-columns: minmax(150px, 0.2fr) minmax(0, 1fr);
    border-bottom: 1px solid var(--rule);
  }
  .article-meta {
    min-height: 100%;
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.25rem, 3vw, 2.25rem) 2rem 0;
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.7rem;
    border-right: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    line-height: 1.55;
  }
  .article-meta-label {
    margin-bottom: 0.25rem;
    color: var(--red);
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .field-marker {
    position: relative;
    width: 84px;
    height: 84px;
    margin-top: auto;
    display: grid;
    place-items: center;
    border: 1px solid var(--rule);
    border-radius: 50%;
  }
  .field-marker::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 1px;
    height: clamp(2rem, 5vw, 4rem);
    background: linear-gradient(to top, var(--rule), transparent);
  }
  .field-marker i {
    width: 52px;
    height: 52px;
    border: 1px solid rgba(207, 47, 33, 0.72);
    border-radius: 50%;
  }
  .field-marker b {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--red);
  }
  .article-lede {
    position: relative;
    isolation: isolate;
    padding: clamp(2.75rem, 6vw, 5.5rem) 0 clamp(3rem, 6vw, 5rem)
      clamp(2rem, 6vw, 5.75rem);
  }
  .article-lede::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image:
      linear-gradient(rgba(242, 237, 227, 0.055) 1px, transparent 1px),
      linear-gradient(
        90deg,
        rgba(242, 237, 227, 0.055) 1px,
        transparent 1px
      );
    background-size: 44px 44px;
    mask-image: linear-gradient(125deg, rgba(0, 0, 0, 0.7), transparent 72%);
  }
  h1,
  h2,
  :global(.article-body h2),
  :global(.article-body h3) {
    font-family: "Bodoni Moda", Didot, serif;
    font-weight: 500;
  }
  h1 {
    margin: 0;
    max-width: 980px;
    font-size: clamp(3.75rem, 6.5vw, 6.25rem);
    letter-spacing: -0.03em;
    line-height: 1;
    text-wrap: balance;
  }
  .article-description {
    max-width: 720px;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.65;
  }
  :global(.article-body) {
    max-width: 740px;
    margin: clamp(3rem, 6vw, 5rem) auto clamp(5rem, 8vw, 7rem);
    color: var(--body-copy);
    font-family: "Instrument Sans", sans-serif;
    font-size: clamp(1.05rem, 1.45vw, 1.18rem);
    line-height: 1.82;
  }
  :global(.article-body p) {
    margin: 0 0 1.55em;
  }
  :global(.article-body > p:first-child::first-letter) {
    margin: 0.06em 0.1em 0 0;
    float: left;
    color: var(--red);
    font-family: "Bodoni Moda", Didot, serif;
    font-size: 4.6em;
    line-height: 0.72;
  }
  :global(.article-body h2) {
    margin: 2.2em 0 0.55em;
    font-size: clamp(2.3rem, 4.5vw, 4rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }
  :global(.article-body h3) {
    margin: 2em 0 0.55em;
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  :global(.article-body a) {
    color: var(--red);
    text-underline-offset: 4px;
  }
  :global(.article-body strong) {
    color: var(--ink);
  }
  :global(.article-body code) {
    background: #282620;
    color: #f3b2ad;
  }
  :global(.article-body pre) {
    padding: 1.2rem 1.35rem;
    overflow-x: auto;
    border: 1px solid var(--rule);
    background: #0f0f0d;
  }
  :global(.article-body pre code) {
    padding: 0;
    background: transparent;
    color: var(--body-copy);
  }
  :global(.article-body blockquote) {
    margin: 2.5rem 0;
    padding: 1.2rem 0 1.2rem 1.6rem;
    border-left: 3px solid var(--red);
    color: #c2baad;
    font-family: "Bodoni Moda", Didot, serif;
    font-size: 1.35em;
    line-height: 1.45;
  }
  :global(.article-body hr) {
    width: 90px;
    margin: 4rem auto;
    border: 0;
    border-top: 1px solid var(--red);
  }
  :global(.article-body img) {
    width: min(100%, 980px);
    max-width: none;
    height: auto;
    margin: 3rem 50%;
    display: block;
    transform: translateX(-50%);
    border: 1px solid var(--rule);
  }
  :global(.article-body li) {
    margin-bottom: 0.45em;
  }
  .after-note {
    margin: 0 0 clamp(6rem, 10vw, 9rem);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    border: 1px solid var(--rule);
    box-shadow: 8px 8px 0 rgba(239, 116, 109, 0.78);
  }
  .join-note,
  .next-note {
    min-height: 330px;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .join-note {
    background: #0f0f0d;
    color: var(--ink);
  }
  .join-note > p,
  .next-note > span {
    margin: 0 0 1rem;
    display: block;
    color: #ef746d;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .join-note h2 {
    margin: 0 0 2rem;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    letter-spacing: -0.06em;
    line-height: 0.92;
  }
  .next-note {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--rule);
    background: var(--paper-deep);
    color: var(--ink);
    text-decoration: none;
  }
  :global(.join-note .newsletter-form input) {
    padding-inline: 1.15rem;
    border-color: #615c53;
    background: #1d1c18;
    color: var(--ink);
  }
  :global(.join-note .newsletter-form input::placeholder) {
    color: #827b70;
  }
  .next-note > span {
    color: var(--red);
  }
  .next-note > strong {
    max-width: 380px;
    font-family: "Bodoni Moda", Didot, serif;
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1;
  }
  .next-note > i {
    margin-top: auto;
    align-self: flex-end;
    color: var(--red);
    font-size: 2rem;
    font-style: normal;
  }
  @keyframes clear-frame {
    0%,
    35% {
      clip-path: inset(0);
    }
    100% {
      clip-path: inset(0 0 100% 0);
    }
  }
  @media (max-width: 760px) {
    .article-heading-bar {
      min-height: 58px;
    }
    .article-heading-grid {
      grid-template-columns: 1fr;
    }
    .article-meta {
      min-height: auto;
      padding: 1.4rem 0;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.35rem 1rem;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }
    .article-meta-label {
      grid-row: 1 / span 2;
      padding-right: 1rem;
      border-right: 1px solid var(--rule);
    }
    .field-marker {
      display: none;
    }
    .article-lede {
      padding: clamp(2.2rem, 8vw, 3.5rem) 0 clamp(2.5rem, 8vw, 3.5rem);
    }
    .after-note {
      grid-template-columns: 1fr;
    }
    .next-note {
      border-top: 1px solid var(--rule);
      border-left: 0;
    }
  }
  @media (max-width: 560px) {
    .article-heading {
      padding-top: 1rem;
    }
    .article-heading-bar > a > small,
    .article-type {
      display: none;
    }
    h1 {
      font-size: clamp(3.15rem, 15vw, 4.7rem);
      letter-spacing: -0.025em;
      line-height: 1.02;
    }
    .join-note,
    .next-note {
      min-height: 300px;
      padding: 1.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cinema-entry {
      display: none;
    }
  }
</style>
