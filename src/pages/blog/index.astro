---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import JournalHeader from "@components/JournalHeader.astro";
import JournalFooter from "@components/JournalFooter.astro";
import getSortedPosts from "@utils/getSortedPosts";

const posts = getSortedPosts(await getCollection("blog"));
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(date);
---

<Layout
  title="Journal — Vanielle Lee"
  description="Field notes by Vanielle Lee on AI, engineering leadership, careers, and building across cultures."
>
  <div class="journal-page">
    <div class="cinema-entry" aria-hidden="true">
      <span>Vanielle Lee / Journal</span>
    </div>

    <JournalHeader />

    <main>
      <section class="journal-hero" aria-labelledby="journal-title">
        <div class="hero-copy">
          <p class="kicker">Field notes / ongoing</p>
          <h1 id="journal-title">Notes from <em>inside</em> the system.</h1>
          <p class="intro">
            AI, engineering leadership, ambition, and the strange work of
            building a life across cultures.
          </p>
          <a href="#reading-room">Start reading <span>↓</span></a>
        </div>

        <figure class="portrait-note">
          <div class="portrait-orbit" aria-hidden="true"></div>
          <img
            src="/assets/vanielle-profile.jpg"
            width="894"
            height="547"
            alt="Vanielle Lee smiling in a dark turtleneck"
          />
          <figcaption>
            <span>Human in the loop</span>
            <strong>Writing from experience</strong>
          </figcaption>
        </figure>

        <div class="hero-marks" aria-hidden="true">
          <i></i><i></i><i></i>
        </div>
      </section>

      <section
        class="reading-room"
        id="reading-room"
        aria-labelledby="latest-heading"
      >
        <header>
          <p>Index / {String(posts.length).padStart(2, "0")} notes</p>
          <h2 id="latest-heading">Latest writing</h2>
        </header>

        <div class="post-index">
          {
            posts.map((post, index) => (
              <a
                class={`post-row post-tone-${(index % 3) + 1}`}
                href={`/blog/${post.slug}/`}
              >
                <div class="post-field" aria-hidden="true">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <div class="field-orbit">
                    <i />
                  </div>
                  <b>{post.data.tags[0] ?? "field note"}</b>
                </div>
                <article>
                  <p>
                    <time datetime={post.data.pubDatetime.toISOString()}>
                      {formatDate(post.data.pubDatetime)}
                    </time>
                    <span>·</span>
                    <span>{post.data.tags.join(" / ")}</span>
                  </p>
                  <h3>{post.data.title}</h3>
                  <div>{post.data.description}</div>
                  <strong>
                    Read the note <i>↗</i>
                  </strong>
                </article>
              </a>
            ))
          }
        </div>
      </section>

      <section class="journal-signup" id="join" aria-labelledby="signup-title">
        <div>
          <p>Next transmission</p>
          <h2 id="signup-title">Get the useful parts.</h2>
          <span>Occasional notes. No content treadmill.</span>
        </div>
        <NewsletterSignup />
      </section>
    </main>

    <JournalFooter />
  </div>
</Layout>

<style>
  :global(body) {
    background: #f4edcf;
  }
  .journal-page {
    --ink: #191915;
    --paper: #fbf8ef;
    --red: #cf2f21;
    --amber: #d9a738;
    --salmon: #ef746d;
    min-height: 100svh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family: "Instrument Sans", sans-serif;
  }
  .cinema-entry {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--paper);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
    animation: clear-frame 1.15s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }
  .journal-hero,
  .reading-room,
  .journal-signup {
    max-width: none;
  }
  .journal-hero {
    position: relative;
    width: min(100% - 2rem, 1240px);
    min-height: 710px;
    margin-inline: auto;
    padding: clamp(5.5rem, 10vw, 9rem) clamp(0rem, 3vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(280px, 0.82fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
  }
  .hero-copy {
    position: relative;
    z-index: 2;
  }
  .kicker,
  .reading-room > header p,
  .journal-signup > div > p {
    margin: 0 0 1.25rem;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  h1,
  h2,
  h3 {
    font-family: "Bodoni Moda", Didot, serif;
    font-weight: 500;
  }
  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(4.5rem, 8.8vw, 8.2rem);
    letter-spacing: -0.075em;
    line-height: 0.84;
  }
  h1 em {
    color: var(--red);
    font-weight: 400;
  }
  .intro {
    max-width: 580px;
    margin: 2rem 0 1.6rem;
    color: #5f594f;
    font-size: clamp(1rem, 1.5vw, 1.22rem);
    line-height: 1.7;
  }
  .hero-copy > a {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.64rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
  }
  .hero-copy > a span {
    color: var(--red);
  }
  .portrait-note {
    position: relative;
    z-index: 2;
    margin: 0;
    justify-self: center;
  }
  .portrait-note img {
    position: relative;
    z-index: 2;
    width: clamp(260px, 27vw, 390px);
    aspect-ratio: 1;
    display: block;
    border: 1px solid var(--ink);
    border-radius: 50%;
    object-fit: cover;
    object-position: 53% center;
    filter: grayscale(1) contrast(1.08);
  }
  .portrait-orbit {
    position: absolute;
    width: 112%;
    aspect-ratio: 1;
    top: -6%;
    left: -6%;
    border: 1px solid rgba(207, 47, 33, 0.52);
    border-radius: 50%;
    animation: orbit-drift 9s ease-in-out infinite;
  }
  .portrait-orbit::before {
    content: "";
    position: absolute;
    width: 12px;
    aspect-ratio: 1;
    top: 14%;
    right: 12%;
    border-radius: 50%;
    background: var(--amber);
  }
  .portrait-note figcaption {
    position: relative;
    z-index: 3;
    width: 82%;
    margin: -1.25rem auto 0;
    padding: 0.75rem 0.9rem;
    display: grid;
    gap: 0.15rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    font-family: "IBM Plex Mono", monospace;
    text-transform: uppercase;
  }
  .portrait-note figcaption span {
    color: var(--red);
    font-size: 0.52rem;
  }
  .portrait-note figcaption strong {
    font-size: 0.58rem;
  }
  .hero-marks {
    position: absolute;
    inset: 8% -15% auto auto;
    width: min(58vw, 720px);
    aspect-ratio: 1;
    opacity: 0.1;
  }
  .hero-marks i {
    position: absolute;
    inset: 0;
    border: 1px solid var(--red);
    border-radius: 50%;
  }
  .hero-marks i:nth-child(2) {
    inset: 20%;
    border-color: var(--amber);
  }
  .hero-marks i:nth-child(3) {
    inset: 40%;
    background: var(--salmon);
  }
  .reading-room {
    width: min(100% - 2rem, 1120px);
    margin-inline: auto;
    padding: clamp(7rem, 12vw, 11rem) 0;
  }
  .reading-room > header {
    margin-bottom: clamp(3rem, 7vw, 6rem);
    display: grid;
    grid-template-columns: 0.45fr 1.55fr;
    align-items: end;
  }
  .reading-room > header p {
    margin: 0 0 0.65rem;
  }
  .reading-room h2 {
    margin: 0;
    font-size: clamp(3.7rem, 7vw, 7rem);
    letter-spacing: -0.07em;
    line-height: 0.9;
  }
  .post-index {
    border-top: 1px solid rgba(25, 25, 21, 0.54);
  }
  .post-row {
    min-height: 300px;
    padding: clamp(1.4rem, 3vw, 2.4rem) 0;
    display: grid;
    grid-template-columns: minmax(190px, 0.5fr) minmax(0, 1.5fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
    border-bottom: 1px solid rgba(25, 25, 21, 0.54);
    color: var(--ink);
    text-decoration: none;
  }
  .post-field {
    position: relative;
    aspect-ratio: 1.25;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid rgba(25, 25, 21, 0.24);
    font-family: "IBM Plex Mono", monospace;
    transition: transform 280ms ease;
  }
  .post-tone-1 .post-field {
    background: #eee4d2;
  }
  .post-tone-2 .post-field {
    background: #e4ebe0;
  }
  .post-tone-3 .post-field {
    background: #f1d8d1;
  }
  .post-field > span {
    color: var(--red);
    font-size: 0.62rem;
  }
  .post-field > b {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .field-orbit {
    position: absolute;
    width: 68%;
    aspect-ratio: 1;
    right: -8%;
    bottom: -23%;
    border: 1px solid rgba(25, 25, 21, 0.36);
    border-radius: 50%;
  }
  .field-orbit::before,
  .field-orbit i {
    content: "";
    position: absolute;
    border-radius: 50%;
  }
  .field-orbit::before {
    inset: 22%;
    border: 1px solid rgba(207, 47, 33, 0.48);
  }
  .field-orbit i {
    inset: 44%;
    background: var(--red);
  }
  .post-row article > p {
    margin: 0 0 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.57rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .post-row h3 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(2.3rem, 4.8vw, 4.8rem);
    letter-spacing: -0.06em;
    line-height: 0.95;
    transition: color 180ms ease;
  }
  .post-row article > div {
    max-width: 650px;
    margin: 1rem 0 1.1rem;
    color: #655f55;
    font-size: 0.98rem;
    line-height: 1.65;
  }
  .post-row article > strong {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.6rem;
    text-transform: uppercase;
  }
  .post-row article > strong i {
    color: var(--red);
    font-style: normal;
  }
  .post-row:hover .post-field {
    transform: rotate(-2deg) translateY(-5px);
  }
  .post-row:hover h3 {
    color: var(--red);
  }
  .journal-signup {
    position: relative;
    width: min(100% - 2rem, 1120px);
    margin: 0 auto clamp(7rem, 11vw, 10rem);
    padding: clamp(2rem, 5vw, 4.2rem);
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    box-shadow: 12px 12px 0 var(--red);
  }
  .journal-signup h2 {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 4.8rem);
    letter-spacing: -0.06em;
    line-height: 0.92;
  }
  .journal-signup > div > span {
    margin-top: 1rem;
    display: block;
    color: #bbb5aa;
    font-size: 0.9rem;
  }
  :global(.journal-signup .newsletter-form) {
    width: 100%;
  }

  @keyframes clear-frame {
    0%,
    42% {
      clip-path: inset(0);
    }
    100% {
      clip-path: inset(0 0 100% 0);
    }
  }
  @keyframes orbit-drift {
    0%,
    100% {
      transform: rotate(-4deg) scale(1);
    }
    50% {
      transform: rotate(4deg) scale(1.025);
    }
  }

  @media (max-width: 800px) {
    .journal-hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }
    .portrait-note {
      justify-self: start;
    }
    .reading-room > header,
    .journal-signup {
      grid-template-columns: 1fr;
    }
    .reading-room > header {
      gap: 0.4rem;
    }
    .post-row {
      grid-template-columns: 150px 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 580px) {
    .journal-hero {
      padding-top: 5rem;
    }
    h1 {
      font-size: clamp(4rem, 21vw, 6rem);
    }
    .portrait-note img {
      width: min(78vw, 340px);
    }
    .post-row {
      padding-block: 2rem;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .post-field {
      width: min(72vw, 280px);
    }
    .post-row h3 {
      font-size: clamp(2.35rem, 12vw, 3.4rem);
    }
    .journal-signup {
      padding: 1.5rem;
      box-shadow: 7px 7px 0 var(--red);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cinema-entry {
      display: none;
    }
    .portrait-orbit {
      animation: none;
    }
  }
</style>
