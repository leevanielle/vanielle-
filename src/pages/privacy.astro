---
import Layout from "@layouts/Layout.astro";
const basePath = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<Layout
  title="Privacy — Vanielle Lee"
  description="Privacy information for vanielle.io and its email newsletter."
>
  <main class="privacy-shell">
    <a class="back" href={basePath}>← Back to vanielle.io</a>
    <p class="eyebrow">Plain-language privacy</p>
    <h1>Your inbox is not inventory.</h1>
    <p class="intro">
      If you join the email list, vanielle.io collects the email address you
      provide so Vanielle can send you essays, book news, and occasional
      updates.
    </p>

    <section>
      <h2>What is collected</h2>
      <p>
        Your email address, the time you subscribed, and basic delivery
        information such as opens or bounces when the newsletter provider
        supplies it.
      </p>
    </section>
    <section>
      <h2>How it is used</h2>
      <p>
        Only to operate the newsletter, understand whether it is useful, and
        prevent abuse. The address is not sold or rented.
      </p>
    </section>
    <section>
      <h2>Service providers</h2>
      <p>
        The newsletter platform processes subscriptions and deliveries on behalf
        of vanielle.io. This page will name that provider before public launch.
      </p>
    </section>
    <section>
      <h2>Your choices</h2>
      <p>
        Every newsletter includes an unsubscribe link. You can also ask for your
        subscription data to be removed by contacting Vanielle through the
        social links on the homepage.
      </p>
    </section>
    <p class="updated">Last updated: 26 August 2026</p>
  </main>
</Layout>

<style>
  :global(body) {
    background: #f2eee4;
    color: #191915;
    font-family: "Instrument Sans", Inter, ui-sans-serif, system-ui, sans-serif;
  }
  .privacy-shell {
    width: min(740px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 3rem 0 6rem;
  }
  .back {
    color: #cf2f21;
    font-weight: 700;
    text-underline-offset: 4px;
  }
  .eyebrow {
    margin: 5rem 0 1rem;
    color: #cf2f21;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-family: "Bodoni Moda", Didot, Georgia, serif;
    font-size: clamp(3.5rem, 10vw, 6.3rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }
  .intro {
    margin: 2rem 0 4rem;
    color: #55586c;
    font-size: 1.2rem;
    line-height: 1.7;
  }
  section {
    padding: 1.5rem 0;
    border-top: 1px solid #bcb4a6;
  }
  h2 {
    margin: 0;
    font-size: 1rem;
  }
  section p {
    color: #5b5e71;
    line-height: 1.7;
  }
  .updated {
    margin-top: 3rem;
    color: #7b7d8d;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
  }
</style>
