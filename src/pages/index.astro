---
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";

const AMAZON_URL = "https://www.amazon.com/dp/B0HF6JW33T";

const expertise = [
  "AI / LLM infrastructure and deployment",
  "Integration platforms and API architecture",
  "Web3 and blockchain technology",
  "Distributed technical leadership",
];

const links = [
  {
    label: "X / Twitter",
    handle: "@lee_vanielle",
    href: "https://x.com/lee_vanielle",
  },
  {
    label: "LinkedIn",
    handle: "/in/vanielle",
    href: "https://linkedin.com/in/vanielle",
  },
  {
    label: "GitHub",
    handle: "github.com/leevanielle",
    href: "https://github.com/leevanielle",
  },
  {
    label: "Stan Store",
    handle: "stan.store/vanielle",
    href: "https://stan.store/vanielle",
  },
];
---

<Layout
  title="Vanielle Lee — Founder, AI Engineer & Author in Tokyo"
  description="Former Silicon Valley engineer building AI-powered software companies from Tokyo—and author of Emperors, Prophets, and Product Managers."
>
  <div class="site-shell">
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Vanielle Lee, home">
        <span>Vanielle</span><span class="wordmark-dot">•</span><span>Lee</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#book">Book</a>
        <a href="#notes">Field notes</a>
        <a href="#work">Work</a>
        <a href="#connect">Connect</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow">Founder · AI engineer · Author · Tokyo</p>
          <h1 id="hero-heading">
            I build systems—and write about the
            <span>humans inside them.</span>
          </h1>
          <p class="hero-intro">
            Former Silicon Valley engineer building AI-powered software
            companies from Tokyo, leading distributed teams across four
            countries, and writing about the recurring chaos of technical
            leadership.
          </p>
          <div class="hero-actions">
            <a
              class="button button-primary"
              href={AMAZON_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              Read the new book
              <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#notes"
              >Get the field notes <span aria-hidden="true">↓</span></a
            >
          </div>
        </div>

        <div
          class="route-card"
          aria-label="Career route from Silicon Valley to Tokyo"
        >
          <div class="route-head">
            <span>Operating context</span>
            <span class="live-dot">Live</span>
          </div>
          <ol class="route">
            <li><span>Mountain View</span><small>Build</small></li>
            <li><span>San Francisco</span><small>Scale</small></li>
            <li class="route-current">
              <span>Tokyo</span><small>Lead + write</small>
            </li>
          </ol>
          <p>English · Mandarin · Japanese</p>
        </div>
      </section>

      <section class="book-section" id="book" aria-labelledby="book-heading">
        <div class="book-stage" aria-hidden="true">
          <div class="book-shadow"></div>
          <div class="book-object">
            <div class="book-spine">Vanielle Lee</div>
            <div class="book-cover">
              <p class="cover-kicker">A CTO's guide to timeless chaos</p>
              <div class="cover-title">
                <span>Emperors,</span>
                <span>Prophets,</span>
                <span>and Product</span>
                <span>Managers</span>
              </div>
              <p class="cover-author">Vanielle Lee</p>
              <div class="cover-routes">
                <i></i><i></i><i></i>
              </div>
            </div>
          </div>
        </div>

        <div class="book-copy">
          <p class="eyebrow eyebrow-light">The new book</p>
          <h2 id="book-heading">
            Leadership has always been chaos. The tools just changed.
          </h2>
          <p>
            <em>Emperors, Prophets, and Product Managers</em> is a CTO's guide
            to the patterns that keep resurfacing wherever power, prediction,
            technology, and human judgment meet.
          </p>
          <p>
            Written for founders, technical leaders, and anyone responsible for
            shipping through ambiguity.
          </p>
          <a
            class="button button-book"
            href={AMAZON_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Get it on Amazon <span aria-hidden="true">↗</span>
          </a>
          <p class="book-meta">Available now · Amazon US</p>
        </div>
      </section>

      <section class="notes-section" id="notes" aria-labelledby="notes-heading">
        <div class="notes-copy">
          <p class="eyebrow">Notes from the work</p>
          <h2 id="notes-heading">What survives after the launch post.</h2>
          <p>
            Occasional field notes on AI systems, technical leadership, small
            teams, and building across cultures. Specific lessons, written after
            the interesting part happens.
          </p>
        </div>
        <NewsletterSignup />
      </section>

      <section class="work-section" id="work" aria-labelledby="work-heading">
        <div class="section-heading">
          <p class="eyebrow">Current practice</p>
          <h2 id="work-heading">
            Building infrastructure. Advising the people building on it.
          </h2>
        </div>

        <div class="work-grid">
          <article class="work-story">
            <p class="lead">
              Started in Silicon Valley, now CTO building AI infrastructure and
              integration platforms from Tokyo.
            </p>
            <p>
              Experience deploying production AI and LLM systems, Web3 and
              blockchain technology, and scaling distributed engineering teams
              across the US, Korea, Vietnam, and Japan.
            </p>
            <div class="advisory-callout">
              <span>Advisory + speaking</span>
              <p>
                I advise founders on AI implementation, technical strategy, and
                scaling engineering teams globally.
              </p>
            </div>
          </article>

          <div class="expertise-card">
            <p class="card-label">Expertise</p>
            <ul>
              {expertise.map(item => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section
        class="connect-section"
        id="connect"
        aria-labelledby="connect-heading"
      >
        <div>
          <p class="eyebrow">Open channels</p>
          <h2 id="connect-heading">Find me where the work is happening.</h2>
        </div>
        <div class="link-grid">
          {
            links.map(link => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span>
                  <>
                    <strong>{link.label}</strong>
                    <small>{link.handle}</small>
                  </>
                </span>
                <i aria-hidden="true">↗</i>
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <footer>
      <p>Tokyo, Japan · Building in public</p>
      <p>© {new Date().getFullYear()} Vanielle Lee</p>
    </footer>
  </div>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  :global(body) {
    background: #f7f8ff;
    color: #171828;
    font-family: "Instrument Sans", Inter, ui-sans-serif, system-ui, sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .site-shell {
    --ink: #171828;
    --paper: #f7f8ff;
    --violet: #675cf5;
    --violet-dark: #4438c7;
    --coral: #ff7163;
    --ice: #dff7ef;
    --line: #d9dbea;
    min-height: 100vh;
    overflow: hidden;
  }

  .site-header,
  main > section,
  footer {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .site-header {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    color: var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .wordmark-dot {
    color: var(--coral);
    margin-inline: 0.35rem;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
  }
  nav a {
    color: #5e6072;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--violet-dark);
  }

  .hero {
    min-height: 690px;
    padding-block: clamp(5rem, 10vw, 8.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(250px, 0.75fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--violet-dark);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    text-wrap: balance;
  }
  h1 {
    max-width: 820px;
    font-family: "DM Serif Display", Georgia, serif;
    font-size: clamp(3.5rem, 6vw, 5.7rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }
  h1 span {
    color: var(--violet);
  }

  .hero-intro {
    max-width: 690px;
    margin: 2rem 0 0;
    color: #55586c;
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.7;
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border-radius: 999px;
    padding: 0.78rem 1.2rem;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }
  .button:hover {
    transform: translateY(-2px);
  }
  .button-primary {
    background: var(--ink);
    color: white;
    box-shadow: 0 9px 0 #cbc7ff;
  }
  .button-primary:hover {
    background: var(--violet-dark);
  }
  .text-link {
    color: var(--ink);
    font-weight: 700;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .route-card {
    align-self: end;
    margin-bottom: 1rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.15rem;
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 20px 70px rgba(55, 48, 135, 0.08);
  }
  .route-head {
    display: flex;
    justify-content: space-between;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.67rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }
  .live-dot {
    color: #16835b;
  }
  .live-dot::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: #28b985;
    box-shadow: 0 0 0 4px #dff7ef;
  }
  .route {
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  .route li {
    position: relative;
    display: flex;
    justify-content: space-between;
    padding: 0.72rem 0 0.72rem 1.4rem;
    border-left: 1px solid #c6c9da;
    color: #747689;
    font-size: 0.83rem;
  }
  .route li::before {
    content: "";
    position: absolute;
    left: -4px;
    top: 1rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c6c9da;
  }
  .route li small {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
  }
  .route .route-current {
    color: var(--ink);
    font-weight: 700;
  }
  .route .route-current::before {
    background: var(--coral);
    box-shadow: 0 0 0 4px #ffe3df;
  }
  .route-card > p {
    margin: 0;
    color: #797b8d;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.64rem;
  }

  .book-section {
    position: relative;
    width: 100%;
    max-width: none;
    min-height: 760px;
    padding: clamp(5rem, 10vw, 9rem) max(1rem, calc((100vw - 1120px) / 2));
    display: grid;
    grid-template-columns: minmax(320px, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(3rem, 10vw, 8rem);
    background: var(--ink);
    color: white;
  }
  .book-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
        circle at 26% 38%,
        rgba(103, 92, 245, 0.22),
        transparent 26%
      ),
      linear-gradient(122deg, transparent 55%, rgba(255, 113, 99, 0.06));
    pointer-events: none;
  }
  .book-stage {
    position: relative;
    min-height: 480px;
    display: grid;
    place-items: center;
    perspective: 1000px;
  }
  .book-shadow {
    position: absolute;
    bottom: 1.4rem;
    width: 70%;
    height: 45px;
    border-radius: 50%;
    background: #090a10;
    filter: blur(20px);
    opacity: 0.75;
  }
  .book-object {
    position: relative;
    width: min(340px, 78vw);
    aspect-ratio: 0.69;
    transform: rotateY(-14deg) rotateZ(-2deg);
    transform-style: preserve-3d;
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .book-stage:hover .book-object {
    transform: rotateY(-4deg) rotateZ(0) translateY(-7px);
  }
  .book-spine {
    position: absolute;
    left: -24px;
    top: 3px;
    bottom: 3px;
    width: 32px;
    display: flex;
    align-items: flex-end;
    padding: 1.2rem 0.4rem;
    background: #3d34ba;
    color: white;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotateY(-65deg);
    transform-origin: right;
  }
  .book-cover {
    position: absolute;
    inset: 0;
    overflow: hidden;
    padding: 2.1rem 1.8rem;
    display: flex;
    flex-direction: column;
    background: var(--violet);
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 25px 35px 80px rgba(0, 0, 0, 0.4);
  }
  .cover-kicker,
  .cover-author {
    position: relative;
    z-index: 2;
    margin: 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cover-title {
    position: relative;
    z-index: 2;
    margin: auto 0;
    display: flex;
    flex-direction: column;
    font-family: "DM Serif Display", Georgia, serif;
    font-size: clamp(2.15rem, 4.8vw, 3.45rem);
    letter-spacing: -0.04em;
    line-height: 0.88;
  }
  .cover-title span:nth-child(2) {
    margin-left: 1.5rem;
    color: var(--ice);
  }
  .cover-title span:nth-child(3) {
    margin-left: 0.45rem;
  }
  .cover-title span:nth-child(4) {
    margin-left: 2.15rem;
    color: #ffd4cf;
  }
  .cover-routes {
    position: absolute;
    inset: 0;
    opacity: 0.45;
  }
  .cover-routes i {
    position: absolute;
    display: block;
    height: 1px;
    background: rgba(255, 255, 255, 0.6);
    transform-origin: left;
  }
  .cover-routes i:nth-child(1) {
    width: 80%;
    top: 27%;
    left: 32%;
    transform: rotate(-24deg);
  }
  .cover-routes i:nth-child(2) {
    width: 90%;
    top: 62%;
    left: -10%;
    transform: rotate(19deg);
  }
  .cover-routes i:nth-child(3) {
    width: 55%;
    top: 84%;
    left: 56%;
    transform: rotate(-65deg);
  }

  .book-copy {
    position: relative;
    z-index: 1;
    max-width: 630px;
  }
  .eyebrow-light {
    color: #bbb5ff;
  }
  .book-copy h2,
  .notes-copy h2,
  .section-heading h2,
  .connect-section h2 {
    font-family: "DM Serif Display", Georgia, serif;
    font-size: clamp(2.65rem, 5vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .book-copy > p:not(.eyebrow):not(.book-meta) {
    max-width: 570px;
    color: #c7c9d5;
    font-size: clamp(1rem, 1.5vw, 1.17rem);
    line-height: 1.75;
  }
  .book-copy > p:nth-of-type(2) {
    margin-top: 1.8rem;
  }
  .button-book {
    margin-top: 1.2rem;
    background: var(--coral);
    color: #241a1a;
    box-shadow: 0 8px 0 #7c302b;
  }
  .button-book:hover {
    background: #ff887d;
  }
  .book-meta {
    margin: 1rem 0 0;
    color: #858899;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .notes-section {
    padding-block: clamp(5rem, 10vw, 9rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.9fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
  }
  .notes-copy p:last-child {
    max-width: 600px;
    color: #5b5e71;
    font-size: 1.08rem;
    line-height: 1.75;
  }
  .notes-copy h2 {
    max-width: 690px;
    font-size: clamp(2.7rem, 5vw, 4.8rem);
  }

  .work-section {
    padding-block: clamp(5rem, 10vw, 8rem);
    border-top: 1px solid var(--line);
  }
  .section-heading {
    display: grid;
    grid-template-columns: 0.55fr 1.45fr;
    gap: 2rem;
    align-items: start;
  }
  .section-heading h2 {
    max-width: 780px;
    font-size: clamp(2.5rem, 4.8vw, 4.6rem);
  }
  .work-grid {
    margin-top: 4.5rem;
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .work-story {
    color: #595c6f;
    font-size: 1.04rem;
    line-height: 1.75;
  }
  .work-story .lead {
    color: var(--ink);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    font-weight: 650;
    line-height: 1.45;
  }
  .advisory-callout {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border-left: 4px solid var(--coral);
    background: white;
  }
  .advisory-callout span,
  .card-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .advisory-callout p {
    margin: 0.65rem 0 0;
  }
  .expertise-card {
    align-self: start;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #fff;
  }
  .expertise-card ul {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .expertise-card li {
    padding: 1rem 0;
    border-top: 1px solid #ececf3;
    color: #505266;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .expertise-card li::before {
    content: "↳";
    margin-right: 0.6rem;
    color: var(--violet);
    font-family: "IBM Plex Mono", monospace;
  }

  .connect-section {
    padding-block: clamp(5rem, 10vw, 8rem);
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
  }
  .connect-section h2 {
    font-size: clamp(2.6rem, 4.5vw, 4.4rem);
  }
  .link-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }
  .link-grid a {
    min-height: 112px;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: white;
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 180ms,
      transform 180ms,
      box-shadow 180ms;
  }
  .link-grid a:hover {
    border-color: #aaa4ff;
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(67, 56, 190, 0.08);
  }
  .link-grid strong,
  .link-grid small {
    display: block;
  }
  .link-grid small {
    margin-top: 0.35rem;
    color: #77798a;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
  }
  .link-grid i {
    color: var(--violet);
    font-size: 1.2rem;
    font-style: normal;
  }

  footer {
    min-height: 95px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    color: #727486;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(input:focus-visible) {
    outline: 3px solid var(--coral);
    outline-offset: 4px;
  }

  @media (max-width: 820px) {
    .site-header {
      min-height: 70px;
    }
    nav {
      gap: 1rem;
    }
    nav a:nth-child(3) {
      display: none;
    }
    .hero {
      min-height: 0;
      grid-template-columns: 1fr;
      padding-block: 5rem 4rem;
    }
    .route-card {
      max-width: 430px;
      margin: 0;
    }
    .book-section {
      grid-template-columns: 1fr;
      padding-block: 5rem;
    }
    .book-stage {
