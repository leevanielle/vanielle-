              Read the book <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section
        class="consulting-room"
        id="consulting"
        aria-labelledby="consulting-heading"
      >
        <div class="consulting-card" data-reveal>
          <div>
            <p class="room-label"><span aria-hidden="true"></span>The salon</p>
            <h2 id="consulting-heading">Bring one hard decision.</h2>
          </div>
          <div class="consulting-copy">
            <p>
              If you’re weighing an AI bet, architecture choice, product
              tradeoff, or team problem, I’ll help you see the decision clearly
              and leave with a practical next move.
            </p>
            <div class="price-row">
              <div>
                <span>Decision sessions</span>
                <strong>From $300 / hour</strong>
              </div>
              <p>Projects, speaking, and retainers are scoped separately.</p>
            </div>
            <a
              class="button-dark"
              href={LINKEDIN_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              Start a conversation <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="notes-room" id="notes" aria-labelledby="notes-heading">
        <div class="notes-heading" data-reveal>
          <p class="room-label">
            <span aria-hidden="true"></span>By the window
          </p>
          <h2 id="notes-heading">Notes for thoughtful builders.</h2>
          <p>
            Useful ideas for the people funding technology, building it, and
            living with the outcome.
          </p>
        </div>

        <div class="notes-list">
          {
            notes.map((note, index) => (
              <article data-reveal>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{note.title}</h3>
                  <p>{note.copy}</p>
                </div>
              </article>
            ))
          }
        </div>

        <a
          class="notes-invite"
          href="#newsletter"
          data-focus-newsletter
          data-reveal
        >
          <span class="soft-spark" aria-hidden="true">✦</span>
          <div>
            <small>Leave your email by the door</small>
            <strong>Send me the next field note.</strong>
          </div>
          <i aria-hidden="true">↗</i>
        </a>
      </section>

      <section
        class="connect-room"
        id="connect"
        aria-labelledby="connect-heading"
      >
        <div class="connect-copy" data-reveal>
          <p class="room-label"><span aria-hidden="true"></span>The terrace</p>
          <h2 id="connect-heading">Come say hello.</h2>
          <p>
            Find the working notes, the technical experiments, and the person
            behind both.
          </p>
        </div>

        <div class="link-grid">
          {
            links.map(link => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                data-reveal
              >
                <span>
                  <strong>{link.label}</strong>
                  <i>{link.handle}</i>
                </span>
                <b aria-hidden="true">↗</b>
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <footer>
      <div>
        <span class="wordmark-mark" aria-hidden="true">✦</span>
        <p>Vanielle Lee · AI engineer · Founder · CTO</p>
      </div>
      <a href="#newsletter" data-focus-newsletter>Join the field notes ↑</a>
      <p>© {new Date().getFullYear()}</p>
    </footer>
  </div>
</Layout>

<script>
  const shell = document.querySelector<HTMLElement>(".site-shell");

  if (shell && shell.dataset.motionReady !== "true") {
    shell.dataset.motionReady = "true";
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (!reduceMotion) {
      shell.classList.add("motion-ready");
      const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const revealObserver = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: "0px 0px -8% 0px" }
      );
      reveals.forEach(element => revealObserver.observe(element));
    }

    let progressFrame = 0;
    const revealVisible = () => {
      if (reduceMotion) return;
      document
        .querySelectorAll<HTMLElement>("[data-reveal]")
        .forEach(element => {
          const bounds = element.getBoundingClientRect();
          if (bounds.top < window.innerHeight * 0.92 && bounds.bottom > 0) {
            element.classList.add("is-visible");
          }
        });
    };
    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? window.scrollY / max : 0;
      shell.style.setProperty("--scroll-progress", String(ratio));
      revealVisible();
      progressFrame = 0;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!progressFrame) {
          progressFrame = window.requestAnimationFrame(updateProgress);
        }
      },
      { passive: true }
    );
    updateProgress();

    document
      .querySelectorAll<HTMLAnchorElement>("[data-focus-newsletter]")
      .forEach(link => {
        link.addEventListener("click", () => {
          window.setTimeout(
            () => {
              document
                .querySelector<HTMLInputElement>("#newsletter-email")
                ?.focus({ preventScroll: true });
            },
            reduceMotion ? 0 : 500
          );
        });
      });
  }
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
  }

  :global(body) {
    margin: 0;
    background: #f7f5f2;
    color: #2b2926;
    font-family: "DM Sans", "Instrument Sans", ui-sans-serif, system-ui,
      sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .site-shell {
    --ink: #2b2926;
    --ink-soft: #5d5953;
    --porcelain: #f7f5f2;
    --white: #fffefa;
    --blush: #efe5e2;
    --mist: #dfe8e3;
    --coral: #bd574c;
    --coral-dark: #9e433a;
    --brass: #a98a55;
    --line: #d8d3cb;
    --scroll-progress: 0;
    min-height: 100vh;
    overflow: clip;
    background: var(--porcelain);
  }

  .site-shell > main,
  .site-shell main > section,
  .site-shell > footer {
    width: 100%;
    max-width: none;
    margin: 0;
  }

  .scroll-progress {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 90;
    width: 3px;
    background: rgba(169, 138, 85, 0.12);
  }

  .scroll-progress-fill {
    width: 100%;
    height: calc(var(--scroll-progress) * 100%);
    display: block;
    border-radius: 0 0 99px 99px;
    background: var(--coral);
    transition: height 100ms linear;
  }

  .site-header {
    position: fixed;
    top: 1rem;
    left: 50%;
    z-index: 80;
    width: min(1120px, calc(100% - 2rem));
    min-height: 58px;
    padding: 0.45rem 0.55rem 0.45rem 1.05rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    border: 1px solid rgba(216, 211, 203, 0.9);
    border-radius: 18px;
    background: rgba(255, 254, 250, 0.86);
    box-shadow: 0 12px 40px rgba(43, 41, 38, 0.07);
    backdrop-filter: blur(18px);
    transform: translateX(-50%);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.08rem;
    font-weight: 500;
    text-decoration: none;
  }

  .wordmark-mark {
    color: var(--coral);
    font-size: 0.9em;
  }

  .site-header nav {
    justify-self: center;
    display: flex;
    gap: clamp(0.9rem, 2.6vw, 2.2rem);
  }

  .site-header nav a {
    color: #6c6862;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-header nav a:hover {
    color: var(--coral);
  }

  .header-cta,
  .button-primary,
  .button-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease;
  }

  .header-cta {
    min-height: 42px;
    padding: 0.65rem 1rem;
    background: var(--ink);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .header-cta:hover,
  .button-dark:hover {
    background: #44403a;
    transform: translateY(-2px);
  }

  .hero {
    position: relative;
    min-height: 100svh;
    padding: clamp(8.5rem, 13vh, 10rem) max(1.25rem, calc((100vw - 1120px) / 2))
      clamp(4.5rem, 8vh, 6rem);
    display: grid;
    align-items: center;
    overflow: hidden;
    background: radial-gradient(
        circle at 87% 17%,
        rgba(239, 229, 226, 0.86),
        transparent 31%
      ),
      linear-gradient(145deg, #fbfaf7, #f5f2ed);
  }

  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(1px);
    pointer-events: none;
  }

  .ambient-orb-one {
    top: 17%;
    right: 7%;
    width: clamp(180px, 25vw, 340px);
    aspect-ratio: 1;
    background: rgba(223, 232, 227, 0.65);
  }

  .ambient-orb-two {
    right: 24%;
    bottom: 5%;
    width: clamp(90px, 14vw, 180px);
    aspect-ratio: 1;
    background: rgba(239, 229, 226, 0.72);
  }

  .hero-layout {
    position: relative;
    z-index: 2;
    width: min(1120px, 100%);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.72fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .room-label {
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--coral);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .room-label > span {
    position: relative;
    width: 18px;
    height: 18px;
    display: block;
    border: 1px solid var(--brass);
    border-radius: 50%;
  }

  .room-label > span::after {
    content: "";
    position: absolute;
    top: 8px;
    left: 17px;
    width: 12px;
    height: 1px;
    background: var(--brass);
  }

  .hero-role {
    margin: 0 0 1.25rem;
    color: #77716a;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: "Newsreader", Georgia, serif;
    font-weight: 400;
    text-wrap: balance;
  }

  h1 {
    max-width: 720px;
    font-size: clamp(3.15rem, 5.4vw, 5.15rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  h1 em,
  h2 em {
    color: var(--coral);
    font-weight: 400;
  }

  .hero-intro {
    max-width: 660px;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.45vw, 1.13rem);
    line-height: 1.72;
  }

  .hero-actions {
    margin-top: 1.7rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .button-primary {
    min-height: 48px;
    padding: 0.75rem 1.15rem;
    background: var(--coral);
    color: white;
    box-shadow: 0 10px 24px rgba(189, 87, 76, 0.18);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .button-primary:hover {
    background: var(--coral-dark);
    box-shadow: 0 14px 30px rgba(189, 87, 76, 0.24);
    transform: translateY(-2px);
  }

  .text-link {
    color: var(--ink);
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration-color: #bbb3a9;
    text-underline-offset: 5px;
  }

  .hero-newsletter {
    max-width: 690px;
    margin-top: 1.65rem;
    padding: 1rem;
    border: 1px solid rgba(216, 211, 203, 0.88);
    border-radius: 22px;
    background: rgba(255, 254, 250, 0.74);
    box-shadow: 0 18px 50px rgba(43, 41, 38, 0.06);
    backdrop-filter: blur(12px);
  }

  .newsletter-heading {
    margin-bottom: 0.85rem;
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .newsletter-heading p {
    margin: 0;
    color: #6d6861;
    font-size: 0.74rem;
    line-height: 1.5;
  }

  .newsletter-heading strong {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  .soft-spark {
    color: var(--coral);
  }

  .hero-portrait {
    position: relative;
    width: min(390px, 100%);
    margin-inline: auto;
    padding: 1rem 1rem 5.2rem;
    border: 1px solid rgba(216, 211, 203, 0.95);
    border-radius: 180px 180px 28px 28px;
    background: rgba(255, 254, 250, 0.78);
    box-shadow: 0 28px 80px rgba(43, 41, 38, 0.11);
