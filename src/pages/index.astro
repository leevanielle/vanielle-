  }
  .hero-stage {
    position: relative;
    z-index: 2;
    width: min(1280px, 100%);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.14fr) minmax(360px, 0.86fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }
