---
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";

const AMAZON_URL = "https://www.amazon.com/dp/B0HF6JW33T";
const LINKEDIN_URL = "https://linkedin.com/in/vanielle";
const FORBES_URL =
  "https://www.forbes.com/sites/jonyounger/2020/11/23/meet-another-freelance-innovator-odecloud-a-netsuite-expert-community/";
const LIVE_URL = "https://leevanielle.github.io/vanielle-/";
const X_SHARE_URL = `https://twitter.com/intent/tweet?text=${encodeURIComponent(
  "The model is rarely the bottleneck. The company is.\n\nA field guide to AI, engineering leadership, and the humans who have to ship it."
)}&url=${encodeURIComponent(LIVE_URL)}&via=lee_vanielle`;

const expertise = [
  "Agentic AI and LLM systems",
  "Full-stack product engineering",
  "Cloud, infrastructure, and data",
  "Technical strategy and team leadership",
];

const links = [
  {
    label: "X / Twitter",
    handle: "@lee_vanielle",
    href: "https://x.com/lee_vanielle",
  },
  {
    label: "LinkedIn",
    handle: "/in/vanielle",
    href: LINKEDIN_URL,
  },
  {
    label: "GitHub",
    handle: "github.com/leevanielle",
    href: "https://github.com/leevanielle",
  },
  {
    label: "Stan Store",
    handle: "stan.store/vanielle",
    href: "https://stan.store/vanielle",
  },
];
---

<Layout
  title="Vanielle Lee — AI Engineer, Founder & CTO"
  description="The model is rarely the bottleneck. Field notes from AI engineer, entrepreneur, and OdeCloud founder/CTO Vanielle Lee."
>
  <div class="site-shell">
    <div class="opening-sequence" aria-hidden="true">
      <div class="shutter shutter-left"></div>
      <div class="shutter shutter-right"></div>
      <div class="opening-slate">
        <span>System brief / 001</span>
        <strong>Operator mode</strong>
        <i>Loading code · company · people</i>
      </div>
    </div>

    <div class="scroll-progress" aria-hidden="true">
      <span class="scroll-progress-fill"></span>
    </div>

    <header class="mission-nav">
      <a class="wordmark" href="#opening" aria-label="Vanielle Lee, home">
        <span>Vanielle</span><i aria-hidden="true">■</i><span>Lee</span>
      </a>

      <nav aria-label="Chapter navigation">
        <a href="#work" data-chapter-link="work">
          <small>01</small><span>Experience</span>
        </a>
        <a href="#book" data-chapter-link="book">
          <small>02</small><span>Book</span>
        </a>
        <a href="#notes" data-chapter-link="notes">
          <small>03</small><span>Field notes</span>
        </a>
      </nav>

      <a class="nav-cta" href="#newsletter" data-focus-newsletter>
        Join field notes <span aria-hidden="true">↘</span>
      </a>
    </header>

    <main>
      <section
        class="hero-cinematic"
        id="opening"
        data-chapter="opening"
        aria-labelledby="hero-heading"
      >
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-watermark" aria-hidden="true">OPERATOR / 01</div>

        <div class="hero-stage">
          <div class="hero-copy">
            <p class="hero-credit">
              <span>Vanielle Lee / Operator profile</span>
              <span>AI engineer · Founder · CTO</span>
            </p>

            <h1 id="hero-heading">
              <span>The model is rarely</span>
              <span>the bottleneck.</span>
              <span class="title-accent">The company is.</span>
            </h1>

            <p class="hero-intro">
              I’m an AI engineer, entrepreneur, and OdeCloud founder/CTO. For
              10+ years, I’ve built across the stack—and led the people,
              decisions, and companies around it.
            </p>

            <div class="hero-actions">
              <a
                class="hero-action-primary"
                href="#newsletter"
                data-focus-newsletter
              >
                Get the field notes <span aria-hidden="true">↘</span>
              </a>
              <a href="#consulting">
                Book a decision session <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="hero-signup" id="newsletter">
              <div class="signup-promise">
                <span class="signal-dot" aria-hidden="true"></span>
                <p>
                  <strong>The useful memo behind the hot take.</strong>
                   Practical AI, hiring, engineering leadership, and candid
                  notes from building across cultures.
                </p>
              </div>
              <NewsletterSignup />
            </div>
          </div>

          <aside
            class="operator-console"
            aria-label="Interactive operator diagnostic"
          >
            <div class="console-topline">
              <span>VL / OPERATOR ID</span>
              <i><b aria-hidden="true"></b> LIVE</i>
            </div>

            <figure class="operator-id">
              <div class="operator-photo">
                <img
                  src="assets/vanielle-profile.jpg"
                  width="894"
                  height="547"
                  alt="Vanielle Lee smiling in a dark turtleneck"
                  loading="eager"
                  fetchpriority="high"
                />
                <span aria-hidden="true"></span>
              </div>
              <figcaption>
                <strong>Vanielle Lee</strong>
                <span>10+ yrs engineering / 8 yrs CTO</span>
              </figcaption>
            </figure>

            <div class="diagnostic-heading">
              <span>Company diagnostic</span>
              <i>Run / 001</i>
            </div>
            <div class="diagnostic-list">
              <div data-diagnostic-row data-score="96" data-result="READY">
                <span>01</span><strong>Model</strong><i>WAITING</i>
                <b><span></span></b>
              </div>
              <div data-diagnostic-row data-score="84" data-result="ONLINE">
                <span>02</span><strong>Systems</strong><i>WAITING</i>
                <b><span></span></b>
              </div>
              <div data-diagnostic-row data-score="67" data-result="MURKY">
                <span>03</span><strong>Strategy</strong><i>WAITING</i>
                <b><span></span></b>
              </div>
              <div
                data-diagnostic-row
                data-score="34"
                data-result="CONFLICTING"
              >
                <span>04</span><strong>Incentives</strong><i>WAITING</i>
                <b><span></span></b>
              </div>
              <div data-diagnostic-row data-score="22" data-result="HUMAN">
                <span>05</span><strong>Alignment</strong><i>WAITING</i>
                <b><span></span></b>
              </div>
            </div>
            <button
              class="diagnostic-trigger"
              type="button"
