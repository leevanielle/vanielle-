---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import JournalFooter from "@components/JournalFooter.astro";
import getSortedPosts from "@utils/getSortedPosts";

const AMAZON_URL = "https://www.amazon.com/dp/B0HF6JW33T";
const FORBES_URL =
  "https://www.forbes.com/sites/jonyounger/2020/11/23/meet-another-freelance-innovator-odecloud-a-netsuite-expert-community/";
const latestPosts = getSortedPosts(await getCollection("blog")).slice(0, 3);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);

const socialLinks = [
  { label: "X", handle: "@lee_vanielle", href: "https://x.com/lee_vanielle" },
  {
    label: "Threads",
    handle: "@leevanielle",
    href: "https://www.threads.com/@leevanielle",
  },
  {
    label: "GitHub",
    handle: "github.com/leevanielle",
    href: "https://github.com/leevanielle",
  },
];
---

<Layout
  title="Vanielle Lee — AI Engineer, Founder & CTO"
  description="Vanielle Lee is an AI engineer, founder, OdeCloud CTO, and author of Emperors, Prophets, and Product Managers."
>
  <div class="home-page" id="top">
    <div class="cinema-entry" aria-hidden="true">
      <span>Field system / online</span>
      <strong>Vanielle Lee</strong>
    </div>

    <aside
      class="subscribe-rail"
      id="newsletter"
      aria-label="Join the field notes"
    >
      <span>Field notes / occasional</span>
      <strong>One useful note at a time.</strong>
      <NewsletterSignup />
    </aside>

    <main>
      <section class="home-hero" aria-labelledby="hero-heading">
        <div class="hero-copy reveal">
          <div class="hero-identity">
            <strong>Vanielle Lee</strong>
            <span>Field system / online</span>
          </div>
          <p class="kicker">AI engineer · Founder · CTO · Author</p>
          <h1 id="hero-heading">
            I build AI systems—<em>and the companies around them.</em>
          </h1>
          <p class="hero-intro">
            Ten years across the stack. Eight years in the CTO seat. Now
            building deeply with agentic AI.
          </p>

          <div class="hero-links">
            <a href="#work">Open the work <span>↓</span></a>
            <a href={FORBES_URL} target="_blank" rel="noopener noreferrer">
              OdeCloud in Forbes <span>↗</span>
            </a>
          </div>
        </div>

        <figure class="portrait-system reveal">
          <div class="portrait-rings" aria-hidden="true"><i></i><b></b></div>
          <img
            src="/assets/vanielle-profile.jpg"
            width="894"
            height="547"
            alt="Vanielle Lee smiling in a dark turtleneck"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>
            <span>Human in the loop</span>
            <strong>Build · scale · lead</strong>
          </figcaption>
        </figure>

        <div class="hero-coordinate" aria-hidden="true">
          37.7749° N / 122.4194° W
        </div>
      </section>

      <section class="proof-line" aria-label="Career proof points">
        <div><strong>10+</strong><span>years engineering</span></div>
        <div><strong>8</strong><span>years as CTO</span></div>
        <div><strong>Full stack</strong><span>interface → agents</span></div>
        <a href={FORBES_URL} target="_blank" rel="noopener noreferrer">
          <strong>Forbes</strong><span>OdeCloud profile ↗</span>
        </a>
      </section>

      <section class="work-section" id="work" aria-labelledby="work-heading">
        <header class="section-heading reveal">
          <p class="kicker">Selected operating models</p>
          <h2 id="work-heading">The work, without the résumé.</h2>
          <span>Three artifacts from the codebase and the CTO seat.</span>
        </header>

        <div class="artifact-list">
          <article class="artifact artifact-agent reveal">
            <div class="artifact-label">
              <span>Agentic systems</span>
              <small>Boundaries before autonomy</small>
            </div>
            <div class="agent-map" aria-label="Agent system flow">
              <span>Intent</span><i>→</i><span>Agent</span><i>→</i><span
                >Tools</span
              ><i>→</i><span>Evidence</span><i>→</i><strong>Judgment</strong>
            </div>
            <p>Every action leaves evidence a human can inspect.</p>
          </article>

          <article class="artifact artifact-stack reveal">
            <div class="artifact-label">
              <span>Engineering</span>
              <small>The seams are the system</small>
            </div>
            <ol class="stack-map" aria-label="Vanielle's engineering range">
              <li>
                <small>05</small><strong>Agents</strong><span
                  >reason · act · review</span
                >
              </li>
              <li>
                <small>04</small><strong>Data</strong><span
                  >signals · models · context</span
                >
              </li>
              <li>
                <small>03</small><strong>Infrastructure</strong><span
                  >cloud · reliability · scale</span
                >
              </li>
              <li>
                <small>02</small><strong>Backend</strong><span
                  >services · APIs · workflows</span
                >
              </li>
              <li>
                <small>01</small><strong>Frontend</strong><span
                  >interfaces · product · people</span
                >
              </li>
            </ol>
            <p>
              Frontend to infrastructure to the agents running underneath it.
            </p>
          </article>

          <article class="artifact artifact-leadership reveal">
            <div class="artifact-label">
              <span>Leadership</span>
              <small>Remove the single point of failure</small>
            </div>
            <div class="leadership-map" aria-label="Leadership decision model">
              <div>
                <span>Before</span><b>Team</b><i>→</i><strong>Hero</strong>
              </div>
              <em>context moves outward</em>
              <div>
                <span>After</span><b>Context</b><i>→</i><strong>Team</strong>
              </div>
            </div>
            <p>Good context distributes better decisions.</p>
          </article>
        </div>
      </section>

      <section class="book-section" id="book" aria-labelledby="book-heading">
        <div class="book-atmosphere" aria-hidden="true">
          <span>Prophet’s guides / field manual № 001</span>
          <strong>Required reading / CTOs + operators</strong>
        </div>

        <div class="book-layout">
          <figure class="book-object reveal">
            <img
              src="/assets/book-cover.jpg?v=3"
              width="1600"
              height="2560"
              alt="Cover of Emperors, Prophets, and Product Managers by Vanielle Lee"
              loading="lazy"
            />
          </figure>

          <div class="book-copy reveal">
            <p class="kicker">The new book</p>
            <h2 id="book-heading">Leadership has always been chaos.</h2>
            <p>
              Twelve chapters on power, prediction, technical leadership, and
              the recurring organizational chaos between them.
            </p>
            <div class="book-details">
              <span><strong>12</strong> chapters</span>
              <span><strong>6</strong> frameworks</span>
              <span><strong>1</strong> honest field guide</span>
            </div>
            <a href={AMAZON_URL} target="_blank" rel="noopener noreferrer">
              Read the book <span>↗</span>
            </a>
          </div>
        </div>
      </section>

      <section
        class="journal-section"
        id="journal"
        aria-labelledby="journal-heading"
      >
        <div class="journal-shape" aria-hidden="true"><i></i><b></b></div>
        <header class="section-heading reveal">
          <p class="kicker">The journal</p>
          <h2 id="journal-heading">Notes from inside the system.</h2>
          <a href="/blog/">Browse every note <span>↗</span></a>
        </header>

        <div class="home-posts">
          {
            latestPosts.map((post, index) => (
              <a
                class={`home-post post-tone-${(index % 3) + 1} reveal`}
                href={`/blog/${post.slug}/`}
              >
                <div class="post-field" aria-hidden="true">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <i />
                  <b>{post.data.tags[0] ?? "field note"}</b>
                </div>
                <article>
                  <p>
                    {formatDate(post.data.pubDatetime)} · {post.data.tags[0]}
                  </p>
                  <h3>{post.data.title}</h3>
                  <span>{post.data.description}</span>
                  <strong>
                    Read <i>↗</i>
                  </strong>
                </article>
              </a>
            ))
          }
        </div>
      </section>

      <section
        class="connect-section"
        id="connect"
        aria-labelledby="connect-heading"
      >
        <div class="connect-copy reveal">
          <p class="kicker">Advisory / direct access</p>
          <h2 id="connect-heading">Bring me the hard decision.</h2>
          <p>AI, engineering, product, or team design.</p>
          <span><strong>$300</strong> / hour · projects scoped separately</span>
        </div>

        <div class="connect-links reveal">
          {
            socialLinks.map(link => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span>
                  <strong>{link.label}</strong>
                  <small>{link.handle}</small>
                </span>
                <i>↗</i>
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <JournalFooter />
  </div>
</Layout>

<script>
  const revealItems = document.querySelectorAll<HTMLElement>(".reveal");
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reducedMotion || !("IntersectionObserver" in window)) {
    revealItems.forEach(item => item.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -6% 0px" }
    );
    revealItems.forEach(item => observer.observe(item));
  }
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 0;
  }
  :global(body) {
    margin: 0;
    background: #f4edcf;
  }
  :global(*) {
    box-sizing: border-box;
  }
  .home-page {
    --ink: #191915;
    --paper: #fbf8ef;
    --paper-deep: #eee4d2;
    --sage: #e4ebe0;
    --rose: #f1d8d1;
    --red: #cf2f21;
    --amber: #d9a738;
    --salmon: #ef746d;
    min-height: 100svh;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: "Instrument Sans", sans-serif;
  }
  .home-page > main,
  .home-page main > section {
    width: 100%;
    max-width: none;
    margin: 0;
  }
  h1,
  h2,
  h3 {
    font-family: "Bodoni Moda", Didot, serif;
    font-weight: 500;
  }
  .kicker {
    margin: 0 0 1.15rem;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.61rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cinema-entry {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.7rem;
    background: var(--ink);
    color: var(--paper);
    pointer-events: none;
    animation: clear-frame 1.25s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }
  .cinema-entry span {
    color: var(--salmon);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cinema-entry strong {
    font-family: "Bodoni Moda", Didot, serif;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.06em;
  }
  .subscribe-rail {
    width: 100%;
    max-width: none;
    min-height: 94px;
    margin: 0;
    padding: 1rem max(1rem, calc((100vw - 1240px) / 2));
    display: grid;
    grid-template-columns: 0.45fr 0.55fr 1fr;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    background: var(--ink);
    color: var(--paper);
  }
  .subscribe-rail > span {
    color: var(--salmon);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .subscribe-rail > strong {
    font-family: "Bodoni Moda", Didot, serif;
    font-size: clamp(1.3rem, 2vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .home-hero {
    position: relative;
    min-height: calc(100svh - 94px);
    padding: clamp(5rem, 9vw, 8.5rem) max(1rem, calc((100vw - 1240px) / 2));
    display: grid;
    grid-template-columns: minmax(0, 1.14fr) minmax(360px, 0.86fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    overflow: hidden;
  }
  .hero-copy {
    position: relative;
    z-index: 3;
  }
  .hero-identity {
    margin-bottom: clamp(3rem, 6vw, 5.5rem);
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }
  .hero-identity strong {
    font-size: 0.92rem;
    letter-spacing: -0.025em;
  }
  .hero-identity span {
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(4.15rem, 7vw, 7rem);
    letter-spacing: -0.075em;
    line-height: 0.84;
  }
  h1 em {
    display: block;
    color: var(--red);
    font-weight: 400;
  }
  .hero-intro {
    max-width: 580px;
    margin: 2rem 0;
    color: #5f594f;
    font-size: clamp(1rem, 1.45vw, 1.16rem);
    line-height: 1.7;
  }
  .hero-links {
    margin-top: 1.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .hero-links a {
    color: var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.59rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
  }
  .hero-links a span {
    color: var(--red);
  }
  .portrait-system {
    position: relative;
    z-index: 2;
    width: min(100%, 440px);
    margin: 0;
    justify-self: center;
  }
  .portrait-system > img {
    position: relative;
    z-index: 2;
    width: 100%;
    aspect-ratio: 1;
    display: block;
    border: 1px solid var(--ink);
    border-radius: 50%;
    object-fit: cover;
    object-position: 53% center;
    filter: grayscale(1) contrast(1.08);
  }
  .portrait-system figcaption {
    position: relative;
    z-index: 3;
    width: 82%;
    margin: -1.35rem auto 0;
    padding: 0.75rem 0.9rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.53rem;
    text-transform: uppercase;
  }
  .portrait-system figcaption span {
    color: var(--red);
  }
  .portrait-rings {
    position: absolute;
    z-index: 1;
    width: 114%;
    aspect-ratio: 1;
    top: -7%;
    left: -7%;
    border: 1px solid rgba(207, 47, 33, 0.52);
    border-radius: 50%;
    animation: orbit-drift 10s ease-in-out infinite;
  }
  .portrait-rings i,
  .portrait-rings b {
    position: absolute;
    border-radius: 50%;
  }
  .portrait-rings i {
    inset: 17%;
    border: 1px solid rgba(217, 167, 56, 0.45);
  }
  .portrait-rings b {
    width: 13px;
    aspect-ratio: 1;
    top: 12%;
    right: 12%;
    background: var(--amber);
  }
  .hero-coordinate {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    color: rgba(25, 25, 21, 0.32);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.5rem;
    text-transform: uppercase;
  }
  .proof-line {
    padding-inline: max(1rem, calc((100vw - 1240px) / 2));
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    background: var(--paper-deep);
  }
  .proof-line > * {
    min-height: 118px;
    padding: 1.1rem;
    display: grid;
    align-content: center;
    gap: 0.2rem;
    border-right: 1px solid rgba(25, 25, 21, 0.42);
    color: var(--ink);
    text-decoration: none;
  }
  .proof-line > *:first-child {
    border-left: 1px solid rgba(25, 25, 21, 0.42);
  }
  .proof-line strong {
    font-family: "Bodoni Moda", Didot, serif;
    font-size: 2rem;
    font-weight: 500;
    line-height: 1;
  }
  .proof-line span {
    color: #696359;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.53rem;
    text-transform: uppercase;
  }
  .work-section,
  .journal-section {
    position: relative;
    padding: clamp(7rem, 12vw, 11rem) max(1rem, calc((100vw - 1160px) / 2));
  }
  .section-heading {
    margin-bottom: clamp(4rem, 8vw, 7rem);
    display: grid;
    grid-template-columns: 0.5fr 1.18fr 0.72fr;
    align-items: end;
    gap: clamp(1rem, 4vw, 4rem);
  }
  .section-heading .kicker {
    margin: 0 0 0.7rem;
  }
  .section-heading h2 {
    margin: 0;
    font-size: clamp(3.8rem, 6.8vw, 6.8rem);
    letter-spacing: -0.07em;
    line-height: 0.88;
  }
  .section-heading > span {
    color: #635d53;
    line-height: 1.65;
  }
  .artifact-list {
    border-top: 1px solid var(--ink);
  }
  .artifact {
    min-height: 330px;
    padding: clamp(1.5rem, 3.5vw, 3.1rem) 0;
    display: grid;
    grid-template-columns: 0.5fr 1.5fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    border-bottom: 1px solid var(--ink);
  }
  .artifact-label {
    align-self: start;
    display: grid;
    gap: 0.45rem;
    font-family: "IBM Plex Mono", monospace;
    text-transform: uppercase;
  }
  .artifact-label span {
    color: var(--red);
    font-size: 0.58rem;
    font-weight: 600;
  }
  .artifact-label small {
    max-width: 180px;
    font-size: 0.62rem;
    line-height: 1.45;
  }
  .artifact > p {
    grid-column: 2;
    margin: -3.5rem 0 0;
    color: #696359;
    font-size: 0.88rem;
  }
  .agent-map {
    min-height: 180px;
    padding: clamp(1.2rem, 3vw, 2.4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    box-shadow: 8px 8px 0 var(--red);
    font-family: "IBM Plex Mono", monospace;
  }
  .agent-map span,
  .agent-map strong {
    min-width: 76px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid #777268;
    border-radius: 50%;
    font-size: 0.56rem;
    font-weight: 500;
    text-transform: uppercase;
  }
  .agent-map strong {
    border-color: var(--salmon);
    background: var(--red);
  }
  .agent-map i {
    color: var(--amber);
    font-style: normal;
  }
  .stack-map {
    margin: 0;
    padding: 0;
    border: 1px solid var(--ink);
    background: var(--sage);
    list-style: none;
    box-shadow: 8px 8px 0 var(--amber);
  }
  .stack-map li {
    min-height: 52px;
    padding: 0.75rem 1rem;
    display: grid;
    grid-template-columns: 40px 0.7fr 1.3fr;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid rgba(25, 25, 21, 0.42);
  }
  .stack-map li:last-child {
    border-bottom: 0;
  }
  .stack-map small,
  .stack-map span {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.54rem;
    text-transform: uppercase;
  }
  .stack-map small {
    color: var(--red);
  }
  .stack-map strong {
    font-size: 0.92rem;
  }
  .stack-map span {
    color: #625e55;
  }
  .leadership-map {
    min-height: 200px;
    padding: clamp(1.2rem, 3vw, 2.4rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.2rem;
    border: 1px solid var(--ink);
    background: var(--rose);
    box-shadow: 8px 8px 0 var(--red);
