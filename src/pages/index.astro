---
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";

const AMAZON_URL = "https://www.amazon.com/dp/B0HF6JW33T";

const expertise = [
  "AI / LLM infrastructure and deployment",
  "Integration platforms and API architecture",
  "Web3 and blockchain technology",
  "Distributed technical leadership",
];

const links = [
  {
    label: "X / Twitter",
    handle: "@lee_vanielle",
    href: "https://x.com/lee_vanielle",
  },
  {
    label: "LinkedIn",
    handle: "/in/vanielle",
    href: "https://linkedin.com/in/vanielle",
  },
  {
    label: "GitHub",
    handle: "github.com/leevanielle",
    href: "https://github.com/leevanielle",
  },
  {
    label: "Stan Store",
    handle: "stan.store/vanielle",
    href: "https://stan.store/vanielle",
  },
];
---

<Layout
  title="Vanielle Lee — Silicon Valley Engineer, CTO & Author"
  description="Silicon Valley engineer and CTO building AI infrastructure, leading global technical teams, and writing about the timeless chaos of leadership."
>
  <div class="site-shell">
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Vanielle Lee, home">
        <span>Vanielle</span><span class="wordmark-dot">■</span><span>Lee</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#book">Book</a>
        <a href="#notes">Field notes</a>
        <a href="#work">Work</a>
        <a href="#connect">Connect</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow">Silicon Valley engineer · CTO · Author</p>
          <h1 id="hero-heading">
            I build systems—and write about the
            <span>humans inside them.</span>
          </h1>
          <p class="hero-intro">
            Silicon Valley engineer building AI-powered software companies,
            leading distributed teams across four countries, and writing about
            the recurring chaos of technical leadership.
          </p>
          <div class="hero-actions">
            <a
              class="button button-primary"
              href={AMAZON_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              Read the new book <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#notes"
              >Get the field notes <span aria-hidden="true">↓</span></a
            >
          </div>
        </div>

        <figure class="portrait-card">
          <div class="portrait-label">
            <span>field note / 001</span>
            <span>Vanielle Lee</span>
          </div>
          <img
            src="assets/vanielle-profile.jpg"
            width="894"
            height="547"
            alt="Vanielle Lee smiling in a dark turtleneck"
            loading="eager"
            fetchpriority="high"
          />
          <div class="portrait-target" aria-hidden="true"></div>
          <figcaption>
            <span>Mountain View → San Francisco</span>
            <strong>Build · scale · lead</strong>
          </figcaption>
        </figure>
      </section>

      <section class="book-section" id="book" aria-labelledby="book-heading">
        <div class="book-register" aria-hidden="true">
          <span>Prophet's guides — field manual № 001</span>
          <span>Required reading / CTOs + operators</span>
        </div>

        <figure class="book-stage">
          <div class="book-frame">
            <img
              src="assets/book-cover.jpg?v=2"
              width="1600"
              height="2560"
              alt="Cover of Emperors, Prophets, and Product Managers by Vanielle Lee"
              loading="lazy"
            />
          </div>
          <figcaption>Cover artwork · final edition</figcaption>
        </figure>

        <div class="book-copy">
          <p class="eyebrow eyebrow-light">The new book</p>
          <h2 id="book-heading">
            Leadership has always been chaos. The tools just changed.
          </h2>
          <p>
            <em>Emperors, Prophets, and Product Managers</em> is a CTO's guide
            to the patterns that keep resurfacing wherever power, prediction,
            technology, and human judgment meet.
          </p>
          <p>
            Written for founders, technical leaders, and anyone responsible for
            shipping through ambiguity.
          </p>
          <a
            class="button button-book"
            href={AMAZON_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Get it on Amazon <span aria-hidden="true">↗</span>
          </a>
          <p class="book-meta">Available now · Amazon US</p>
        </div>
      </section>

      <section class="notes-section" id="notes" aria-labelledby="notes-heading">
        <div class="notes-copy">
          <p class="eyebrow">Notes from the work</p>
          <h2 id="notes-heading">What survives after the launch post.</h2>
          <p>
            Occasional field notes on AI systems, technical leadership, small
            teams, and building across cultures. Specific lessons, written after
            the interesting part happens.
          </p>
        </div>
        <NewsletterSignup />
      </section>

      <section class="work-section" id="work" aria-labelledby="work-heading">
        <div class="section-heading">
          <p class="eyebrow">Current practice</p>
          <h2 id="work-heading">
            Building infrastructure. Advising the people building on it.
          </h2>
        </div>

        <div class="work-grid">
          <article class="work-story">
            <p class="lead">
              Built in Mountain View and San Francisco. Now a CTO building AI
              infrastructure and integration platforms for global teams.
            </p>
            <p>
              Experience deploying production AI and LLM systems, Web3 and
              blockchain technology, and scaling distributed engineering teams
              across the US, Korea, Vietnam, and Japan.
            </p>
            <div class="advisory-callout">
              <span>Advisory + speaking</span>
              <p>
                I advise founders on AI implementation, technical strategy, and
                scaling engineering teams globally.
              </p>
            </div>
          </article>

          <div class="expertise-card">
            <p class="card-label">Expertise / current</p>
            <ul>{expertise.map(item => <li>{item}</li>)}</ul>
          </div>
        </div>
      </section>

      <section
        class="connect-section"
        id="connect"
        aria-labelledby="connect-heading"
      >
        <div>
          <p class="eyebrow">Open channels</p>
          <h2 id="connect-heading">Find me where the work is happening.</h2>
        </div>
        <div class="link-grid">
          {
            links.map(link => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span>
                  <>
                    <strong>{link.label}</strong>
                    <small>{link.handle}</small>
                  </>
                </span>
                <i aria-hidden="true">↗</i>
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <footer>
      <p>Silicon Valley perspective · Building in public</p>
      <p>© {new Date().getFullYear()} Vanielle Lee</p>
    </footer>
  </div>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }
  :global(body) {
    margin: 0;
    background: #f2eee4;
    color: #191915;
    font-family: "Instrument Sans", Inter, ui-sans-serif, system-ui, sans-serif;
  }
  :global(*) {
    box-sizing: border-box;
  }

  .site-shell {
    --ink: #191915;
    --paper: #f2eee4;
    --paper-bright: #fbf8ef;
    --red: #cf2f21;
    --red-dark: #9f2018;
    --amber: #d4a33b;
    --salmon: #ef746d;
    --muted: #716c61;
    min-height: 100vh;
    overflow: hidden;
    background: linear-gradient(rgba(25, 25, 21, 0.025) 1px, transparent 1px),
      var(--paper);
    background-size: 100% 28px;
  }

  .site-shell > main {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .site-header,
  main > section,
  footer {
    width: min(1160px, calc(100% - 2rem));
    max-width: none;
    margin-inline: auto;
  }
  .site-header {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--ink);
  }
  .wordmark {
    color: var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .wordmark-dot {
    color: var(--red);
    margin-inline: 0.45rem;
    font-size: 0.65em;
  }
  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
  }
  nav a {
    color: #504d45;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--red);
  }

  .hero {
    min-height: 720px;
    padding-block: clamp(4.5rem, 8vw, 7rem);
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(360px, 0.78fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 6rem);
  }
  .eyebrow {
    margin: 0 0 1.2rem;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.095em;
    text-transform: uppercase;
  }
  h1,
  h2 {
    margin: 0;
    font-family: "Bodoni Moda", Didot, Georgia, serif;
    font-weight: 500;
    text-wrap: balance;
  }
  h1 {
    max-width: 760px;
    font-size: clamp(3.6rem, 6.2vw, 6rem);
    letter-spacing: -0.07em;
    line-height: 0.88;
  }
  h1 span {
    color: var(--red);
    font-style: italic;
  }
  .hero-intro {
    max-width: 690px;
    margin: 2rem 0 0;
    color: #575349;
    font-size: clamp(1.04rem, 1.8vw, 1.22rem);
    line-height: 1.72;
  }
  .hero-actions {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .button {
    min-height: 49px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border: 1px solid var(--ink);
    border-radius: 4px;
    padding: 0.8rem 1.2rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 170ms ease,
      box-shadow 170ms ease;
  }
  .button:hover {
    transform: translate(-2px, -2px);
  }
  .button-primary {
    background: var(--ink);
    color: var(--paper-bright);
    box-shadow: 7px 7px 0 var(--red);
  }
  .button-primary:hover {
    box-shadow: 10px 10px 0 var(--red);
  }
  .text-link {
    color: var(--ink);
    font-weight: 750;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .portrait-card {
    position: relative;
    margin: 0;
    padding: 3rem 1rem 1rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    box-shadow: 13px 13px 0 var(--amber);
  }
  .portrait-card::before,
  .portrait-card::after {
    content: "";
    position: absolute;
    width: 28px;
    height: 28px;
    pointer-events: none;
  }
  .portrait-card::before {
    top: 0.75rem;
    left: 0.75rem;
    border-top: 2px solid var(--salmon);
    border-left: 2px solid var(--salmon);
  }
  .portrait-card::after {
    right: 0.75rem;
    bottom: 4.2rem;
    border-right: 2px solid var(--salmon);
    border-bottom: 2px solid var(--salmon);
  }
  .portrait-label {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    color: var(--paper-bright);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.61rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .portrait-card img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid #76726a;
    filter: contrast(1.04);
  }
  .portrait-target {
    position: absolute;
    top: 45%;
    right: 7%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--salmon);
    box-shadow: 0 0 0 5px rgba(239, 116, 109, 0.22);
  }
  .portrait-target::before {
    content: "founder / operator";
    position: absolute;
    right: 14px;
    top: -13px;
    width: max-content;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--salmon);
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper-bright);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .portrait-card figcaption {
    padding: 0.9rem 0.15rem 0;
    display: flex;
    justify-content: space-between;
    color: #bcb8ae;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.59rem;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .portrait-card figcaption strong {
    color: var(--amber);
    font-weight: 600;
  }

  .book-section {
    position: relative;
    width: 100%;
    max-width: none;
    min-height: 860px;
    padding: 7rem max(1rem, calc((100vw - 1160px) / 2));
    display: grid;
    grid-template-columns: minmax(330px, 0.78fr) minmax(0, 1.22fr);
    align-items: center;
    gap: clamp(4rem, 9vw, 8rem);
    background: var(--ink);
    color: var(--paper-bright);
  }
  .book-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(207, 47, 33, 0.08), transparent 32%),
      repeating-linear-gradient(
        0deg,
        transparent 0 31px,
        rgba(255, 255, 255, 0.025) 31px 32px
      );
    pointer-events: none;
  }
  .book-register {
    position: absolute;
    top: 1.5rem;
    left: max(1rem, calc((100vw - 1160px) / 2));
    right: max(1rem, calc((100vw - 1160px) / 2));
    padding-bottom: 1rem;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #6f6a60;
    color: #bcb6aa;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .book-stage {
    position: relative;
    z-index: 1;
    margin: 0;
  }
  .book-frame {
    padding: 0.65rem;
    border: 1px solid #777166;
    background: #ddd7ca;
    box-shadow: 18px 18px 0 var(--red);
    transform: rotate(-1.2deg);
    transition: transform 260ms ease;
  }
  .book-frame:hover {
    transform: rotate(0) translateY(-5px);
  }
  .book-frame img {
    width: 100%;
    height: auto;
    display: block;
  }
  .book-stage figcaption {
    margin-top: 1.5rem;
    color: #89847a;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .book-copy {
    position: relative;
    z-index: 1;
    max-width: 660px;
  }
  .eyebrow-light {
    color: var(--amber);
  }
  .book-copy h2,
  .notes-copy h2,
  .section-heading h2,
  .connect-section h2 {
    font-size: clamp(2.8rem, 5vw, 5.2rem);
    letter-spacing: -0.055em;
    line-height: 0.96;
  }
  .book-copy > p:not(.eyebrow):not(.book-meta) {
    max-width: 590px;
    color: #c5c0b7;
    font-size: clamp(1rem, 1.5vw, 1.16rem);
    line-height: 1.75;
  }
  .book-copy em {
    color: var(--paper-bright);
    font-family: "Bodoni Moda", Didot, Georgia, serif;
    font-size: 1.12em;
  }
  .button-book {
    margin-top: 1.1rem;
    background: var(--red);
    color: var(--paper-bright);
    box-shadow: 7px 7px 0 var(--amber);
  }
  .book-meta {
    margin: 1rem 0 0;
    color: #89847a;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .notes-section {
    padding-block: clamp(6rem, 10vw, 9rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.86fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
  }
  .notes-copy h2 {
    max-width: 680px;
    font-size: clamp(2.8rem, 5vw, 4.9rem);
  }
  .notes-copy p:last-child {
    max-width: 590px;
    color: #5c574d;
    font-size: 1.07rem;
    line-height: 1.75;
  }

  .work-section {
    padding-block: clamp(6rem, 10vw, 9rem);
    border-top: 1px solid var(--ink);
  }
  .section-heading {
    display: grid;
    grid-template-columns: 0.52fr 1.48fr;
    gap: 2rem;
    align-items: start;
  }
  .section-heading h2 {
    max-width: 790px;
    font-size: clamp(2.6rem, 4.8vw, 4.8rem);
  }
  .work-grid {
    margin-top: 4.5rem;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .work-story {
    color: #5a554b;
    font-size: 1.03rem;
    line-height: 1.75;
  }
  .work-story .lead {
    color: var(--ink);
    font-size: clamp(1.3rem, 2.3vw, 1.8rem);
    font-weight: 650;
    line-height: 1.45;
  }
  .advisory-callout {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--ink);
    border-left: 8px solid var(--red);
    background: var(--paper-bright);
    box-shadow: 8px 8px 0 var(--amber);
  }
  .advisory-callout span,
  .card-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .advisory-callout p {
    margin: 0.65rem 0 0;
  }
  .expertise-card {
    align-self: start;
    padding: 1.5rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper-bright);
  }
  .expertise-card .card-label {
    color: var(--amber);
  }
  .expertise-card ul {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .expertise-card li {
    padding: 1rem 0;
    border-top: 1px solid #4c4942;
    color: #d6d1c7;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .expertise-card li::before {
    content: "△";
    margin-right: 0.65rem;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
  }

  .connect-section {
    padding-block: clamp(6rem, 10vw, 9rem);
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 8vw, 7rem);
    border-top: 1px solid var(--ink);
  }
  .connect-section h2 {
    font-size: clamp(2.7rem, 4.5vw, 4.5rem);
  }
  .link-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }
  .link-grid a {
    min-height: 112px;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    background: var(--paper-bright);
    color: var(--ink);
    text-decoration: none;
    transition:
      background 170ms ease,
      color 170ms ease;
  }
  .link-grid a:hover {
    background: var(--red);
    color: var(--paper-bright);
  }
  .link-grid strong,
  .link-grid small {
    display: block;
  }
  .link-grid small {
    margin-top: 0.35rem;
    color: var(--muted);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.66rem;
  }
  .link-grid a:hover small {
    color: #f1c8c2;
  }
  .link-grid i {
    color: var(--red);
    font-size: 1.2rem;
    font-style: normal;
  }
  .link-grid a:hover i {
    color: var(--paper-bright);
  }

  footer {
    min-height: 95px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--ink);
    color: #5d594f;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(input:focus-visible) {
    outline: 3px solid var(--amber);
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 5rem;
    }
    .portrait-card {
      width: min(560px, 100%);
    }
    .book-section {
      grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
      gap: 3rem;
    }
    .notes-section,
    .work-grid,
    .connect-section {
      grid-template-columns: 1fr;
    }
    .section-heading {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 680px) {
    .site-header {
      align-items: flex-start;
      padding-block: 1.2rem;
    }
    nav {
      display: grid;
      grid-template-columns: auto auto;
      row-gap: 0.5rem;
      text-align: right;
    }
    h1 {
      font-size: clamp(3.3rem, 16vw, 5rem);
    }
    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }
    .button {
      width: 100%;
    }
    .portrait-card {
      order: -1;
      padding-top: 2.8rem;
      box-shadow: 8px 8px 0 var(--amber);
    }
    .portrait-target::before {
      display: none;
    }
    .portrait-card figcaption {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
    .book-section {
      grid-template-columns: 1fr;
