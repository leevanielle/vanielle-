---
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";

const AMAZON_URL = "https://www.amazon.com/dp/B0HF6JW33T";
const LINKEDIN_URL = "https://linkedin.com/in/vanielle";
const FORBES_URL =
  "https://www.forbes.com/sites/jonyounger/2020/11/23/meet-another-freelance-innovator-odecloud-a-netsuite-expert-community/";
const LIVE_URL = "https://leevanielle.github.io/vanielle-/";
const X_SHARE_URL =
  "https://twitter.com/intent/tweet?text=" +
  encodeURIComponent(
    "I make ambitious technology feel clear, human, and possible.\n\nA quiet tour through AI, engineering leadership, and building across cultures."
  ) +
  "&url=" +
  encodeURIComponent(LIVE_URL) +
  "&via=lee_vanielle";

const expertise = [
  {
    room: "The lab",
    title: "Agentic AI",
    copy: "LLM systems, AI product strategy, and the practical work of turning a promising model into something people can trust.",
  },
  {
    room: "The studio",
    title: "Product engineering",
    copy: "Frontend, backend, infrastructure, and data—connected into products that are useful, resilient, and ready to grow.",
  },
  {
    room: "The study",
    title: "Technical leadership",
    copy: "Architecture, hiring, team design, and the decisions that help engineers move with clarity instead of ceremony.",
  },
  {
    room: "The table",
    title: "Founder perspective",
    copy: "A decade of translating between code, customers, culture, and the business outcomes that make the work matter.",
  },
];

const notes = [
  {
    title: "Practical AI",
    copy: "What agentic systems can do, where they fail, and what it takes to ship them.",
  },
  {
    title: "The career playbook",
    copy: "Industry shortcuts, getting hired, and the choices that create real leverage.",
  },
  {
    title: "Building across cultures",
    copy: "Candid lessons from leading a company across countries, expectations, and working styles.",
  },
];

const links = [
  {
    label: "X / Twitter",
    handle: "@lee_vanielle",
    href: "https://x.com/lee_vanielle",
  },
  {
    label: "LinkedIn",
    handle: "/in/vanielle",
    href: LINKEDIN_URL,
  },
  {
    label: "GitHub",
    handle: "github.com/leevanielle",
    href: "https://github.com/leevanielle",
  },
  {
    label: "Stan Store",
    handle: "stan.store/vanielle",
    href: "https://stan.store/vanielle",
  },
];
---

<Layout
  title="Vanielle Lee — AI Engineer, Founder & CTO"
  description="A quiet tour through the work of Vanielle Lee—AI engineer, OdeCloud founder and CTO, author, and cross-cultural entrepreneur."
>
  <div class="site-shell">
    <div class="scroll-progress" aria-hidden="true">
      <span class="scroll-progress-fill"></span>
    </div>

    <header class="site-header">
      <a class="wordmark" href="#home" aria-label="Vanielle Lee, home">
        <span class="wordmark-mark" aria-hidden="true">✦</span>
        <span>Vanielle Lee</span>
      </a>

      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#book">Book</a>
        <a href="#consulting">Consulting</a>
      </nav>

      <a class="header-cta" href="#newsletter" data-focus-newsletter>
        Join my notes
      </a>
    </header>

    <main>
      <section class="hero" id="home" aria-labelledby="hero-heading">
        <div class="ambient-orb ambient-orb-one" aria-hidden="true"></div>
        <div class="ambient-orb ambient-orb-two" aria-hidden="true"></div>

        <div class="hero-layout">
          <div class="hero-copy" data-reveal>
            <p class="room-label"><span aria-hidden="true"></span>The foyer</p>
            <p class="hero-role">AI engineer · Founder · CTO · Author</p>
            <h1 id="hero-heading">
              I make ambitious technology feel
              <em>clear, human, and possible.</em>
            </h1>
            <p class="hero-intro">
              I’m Vanielle Lee. For more than ten years, I’ve built across the
              engineering stack and led the people, products, and decisions
              around it.
            </p>

            <div class="hero-actions">
              <a
                class="button-primary"
                href="#newsletter"
                data-focus-newsletter
              >
                Stay for the field notes <span aria-hidden="true">↘</span>
              </a>
              <a class="text-link" href="#about">
                Take the tour <span aria-hidden="true">↓</span>
              </a>
            </div>

            <div class="hero-newsletter" id="newsletter">
              <div class="newsletter-heading">
                <span class="soft-spark" aria-hidden="true">✦</span>
                <p>
                  <strong>A useful note, now and then.</strong>
                   Practical AI, engineering leadership, career advice, and
                  honest stories from building across cultures.
                </p>
              </div>
              <NewsletterSignup />
            </div>
          </div>

          <div class="hero-portrait" data-reveal>
            <div class="portrait-arch">
              <img
                src="assets/vanielle-profile.jpg"
                width="894"
                height="547"
                alt="Vanielle Lee smiling in a dark turtleneck"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="portrait-note">
              <span>Current view</span>
              <p>Agentic AI · product leadership · cross-cultural building</p>
            </div>
            <div class="house-key" aria-hidden="true">
              <span></span>
              <i></i>
            </div>
          </div>
        </div>

        <a
          class="quiet-share"
          href={X_SHARE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Share the view on X <span aria-hidden="true">↗</span>
        </a>
      </section>

      <section class="proof-view" aria-label="Career highlights">
        <div data-reveal>
          <strong>10+</strong>
          <span>years building technology</span>
        </div>
        <div data-reveal>
          <strong>8</strong>
          <span>years as OdeCloud CTO + founder</span>
        </div>
        <a
          href={FORBES_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
        >
          <strong>Forbes</strong>
          <span>featured company profile ↗</span>
        </a>
        <div data-reveal>
          <strong>Enterprise</strong>
          <span>JVC Kenwood · Coinbase · WarnerMedia</span>
        </div>
      </section>

      <section class="about-room" id="about" aria-labelledby="about-heading">
        <div class="section-intro" data-reveal>
          <p class="room-label">
            <span aria-hidden="true"></span>The great room
          </p>
          <h2 id="about-heading">A wide view, without the altitude.</h2>
        </div>

        <div class="about-story" data-reveal>
          <p class="story-lead">
            I can go deep with engineers and still make the work legible to the
            person who does not write code.
          </p>
          <p>
            My career has moved from hands-on engineering to founder and C-suite
            leadership, but the throughline has stayed the same: understand the
            real problem, reduce the noise, and help people make a better
            decision.
          </p>
          <p>
            At OdeCloud, I’ve spent eight years as CTO and founder, building
            products and teams across countries while working with enterprise
            organizations that expect both technical depth and business
            judgment.
          </p>
        </div>

        <blockquote data-reveal>
          <span aria-hidden="true">“</span>
          <p>
            Make complex technology understandable—and ambitious work feel
            possible.
          </p>
        </blockquote>
      </section>

      <section class="work-room" id="work" aria-labelledby="work-heading">
        <div class="section-intro work-intro" data-reveal>
          <p class="room-label">
            <span aria-hidden="true"></span>The private tour
          </p>
          <h2 id="work-heading">The rooms I know well.</h2>
          <p>
            I work across the full life of a technology company, from the first
            line of code to the decisions made around the boardroom table.
          </p>
        </div>

        <div class="expertise-grid">
          {
            expertise.map((item, index) => (
              <article data-reveal>
                <div class="expertise-number">
                  {String(index + 1).padStart(2, "0")}
                </div>
                <p>{item.room}</p>
                <h3>{item.title}</h3>
                <span>{item.copy}</span>
              </article>
            ))
          }
        </div>
      </section>

      <section class="book-room" id="book" aria-labelledby="book-heading">
        <div class="book-layout">
          <figure class="book-stage" data-reveal>
            <div class="book-halo" aria-hidden="true"></div>
            <img
              src="assets/book-cover.jpg?v=3"
              width="1600"
              height="2560"
              alt="Cover of Emperors, Prophets, and Product Managers by Vanielle Lee"
              loading="lazy"
            />
            <figcaption>Prophet’s guides · field manual № 001</figcaption>
          </figure>

          <div class="book-copy" data-reveal>
            <p class="room-label">
              <span aria-hidden="true"></span>The library
            </p>
            <h2 id="book-heading">
              A field guide for people leading through
              <em>beautiful chaos.</em>
            </h2>
            <p class="book-lede">
              <cite>Emperors, Prophets, and Product Managers</cite> is my honest
              guide to engineering leadership, management, power, prediction,
              and the recurring human patterns behind technical work.
            </p>

            <div class="book-details" aria-label="Book details">
              <span><strong>12</strong> chapters</span>
              <span><strong>6</strong> frameworks</span>
              <span><strong>1</strong> candid field guide</span>
            </div>

            <a
              class="button-primary"
              href={AMAZON_URL}
              target="_blank"
              rel="noopener noreferrer"
