---
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";

const AMAZON_URL = "https://www.amazon.com/dp/B0HF6JW33T";
const LINKEDIN_URL = "https://linkedin.com/in/vanielle";
const FORBES_URL =
  "https://www.forbes.com/sites/jonyounger/2020/11/23/meet-another-freelance-innovator-odecloud-a-netsuite-expert-community/";

const agents = [
  { id: "host", name: "Mochi", label: "Meet", color: "#cf2f21", x: 54, y: 322 },
  {
    id: "build",
    name: "Pixel",
    label: "Build",
    color: "#d4a33b",
    x: 155,
    y: 212,
  },
  {
    id: "lead",
    name: "Atlas",
    label: "Lead",
    color: "#191915",
    x: 255,
    y: 271,
  },
  {
    id: "read",
    name: "Quill",
    label: "Book",
    color: "#ef746d",
    x: 356,
    y: 150,
  },
  {
    id: "notes",
    name: "Scout",
    label: "Notes",
    color: "#716c61",
    x: 446,
    y: 215,
  },
  { id: "talk", name: "Miso", label: "Talk", color: "#9f2018", x: 507, y: 94 },
];
---

<Layout
  title="Vanielle Lee — AI Engineer, Founder & CTO"
  description="Meet Vanielle Lee through a playful constellation of AI, engineering leadership, writing, and founder work."
>
  <div class="atelier-shell" data-atelier>
    <div class="sheet-texture" aria-hidden="true"></div>

    <header class="atelier-header">
      <a class="wordmark" href="#host" data-mode-shortcut="host">
        <span aria-hidden="true">✦</span>
         Vanielle Lee
      </a>
      <p class="atelier-status">
        <i aria-hidden="true"></i>
         Field system / online
      </p>
      <button class="guestbook-trigger" type="button" data-invite-open>
        Join the field notes
      </button>
    </header>

    <main class="studio-grid">
      <section class="intro" aria-labelledby="intro-title">
        <figure class="host-portrait">
          <img
            src="assets/vanielle-profile.jpg"
            width="894"
            height="547"
            alt="Vanielle Lee smiling in a dark turtleneck"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>Human in the loop</figcaption>
        </figure>
        <p class="intro-label">AI engineer · Founder · CTO · Author</p>
        <h1 id="intro-title">I make ambitious technology feel possible.</h1>
        <p class="intro-copy">
          Ten years turning hard technical bets into products, teams, and
          decisions people can trust.
        </p>
        <div class="intro-actions">
          <button type="button" data-invite-open>Start with a note</button>
          <span>or choose an agent ↓</span>
        </div>
      </section>

      <section class="discovery" aria-label="Interactive agent constellation">
        <p class="discovery-hint">
          <span aria-hidden="true">↓</span>
           Scroll to rearrange the constellation. Tap an agent to jump.
        </p>
        <div class="field-board" data-field-board aria-hidden="true">
          <header>
            <span>AGENT FIELD SYSTEM / 001</span>
            <strong data-board-mode>MEET</strong>
          </header>
          <svg viewBox="0 0 560 420" role="presentation">
            <defs>
              <pattern
                id="manual-grid"
                width="28"
                height="28"
                patternUnits="userSpaceOnUse"
              >
                <path
                  d="M 28 0 L 0 0 0 28"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="0.65"></path>
              </pattern>
            </defs>
            <rect class="board-grid" x="1" y="1" width="558" height="418" rx="5"
            ></rect>
            <path
              class="rail-shadow"
              d="M54 322 C95 322 108 212 155 212 S205 292 255 271 S305 150 356 150 S404 234 446 215 S486 112 507 94"
            ></path>
            <path
              class="agent-rail"
              data-agent-rail
              d="M54 322 C95 322 108 212 155 212 S205 292 255 271 S305 150 356 150 S404 234 446 215 S486 112 507 94"
            ></path>
            {
              agents.map((agent, index) => (
                <g
                  class="rail-station"
                  data-rail-station={agent.id}
                  transform={`translate(${agent.x} ${agent.y})`}
                  style={`--station-color:${agent.color}`}
                >
                  <circle class="station-ring" r="20" />
                  <circle class="station-face" r="12" />
                  <circle class="station-eye" cx="-4" cy="-1" r="1.6" />
                  <circle class="station-eye" cx="4" cy="-1" r="1.6" />
                  <path class="station-antenna" d="M0 -12 V-18 L4 -21" />
                  <text x="0" y="34">
                    {String(index + 1).padStart(2, "0")}
                  </text>
                </g>
              ))
            }
            <g
              class="rail-traveler"
              data-rail-traveler
              transform="translate(54 322)"
            >
              <circle class="traveler-signal" r="27"></circle>
              <circle class="traveler-face" r="15"></circle>
              <circle class="traveler-eye" cx="-5" cy="-1" r="2"></circle>
              <circle class="traveler-eye" cx="5" cy="-1" r="2"></circle>
              <path class="traveler-antenna" d="M0 -15 V-23 L6 -27"></path>
            </g>
            <g class="board-ticks">
              <path d="M24 24 h28 M24 24 v28 M536 396 h-28 M536 396 v-28"
              ></path>
              <text x="24" y="390">SCROLL INPUT</text>
              <text x="536" y="40" text-anchor="end">HUMAN IN THE LOOP</text>
            </g>
          </svg>
          <footer>
            <span>Signal follows scroll</span>
            <i><b data-board-progress></b></i>
            <strong data-board-index>01 / 06</strong>
          </footer>
        </div>
      </section>

      <section class="detail-deck" aria-live="polite" data-detail-deck>
        <article
          class="detail-card host-card is-active"
          id="detail-host"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-host"
          data-detail="host"
        >
          <p class="card-agent"><i></i> Mochi found the short version</p>
          <h2>Engineer brain.<br />Founder nerve.</h2>
          <p>
            Full-stack technical depth with a C-suite view of what the company
            actually needs.
          </p>
          <div class="proof-pills">
            <span><strong>10+</strong> years building</span>
            <span><strong>8</strong> years CTO</span>
          </div>
          <a href={FORBES_URL} target="_blank" rel="noopener noreferrer">
            Featured in Forbes <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article
          class="detail-card"
          id="detail-build"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-build"
          data-detail="build"
          hidden
        >
          <p class="card-agent"><i></i> Pixel opened the workbench</p>
          <h2>Across the whole machine.</h2>
          <p>From the first interface to the agents running underneath it.</p>
          <div class="skill-cloud">
            <span>Agentic AI</span><span>Frontend</span><span>Backend</span
            ><span>Infrastructure</span><span>Data</span><span>Product</span>
          </div>
          <button type="button" data-mode-shortcut="lead">
            Follow the system <span aria-hidden="true">→</span>
          </button>
        </article>

        <article
          class="detail-card"
          id="detail-lead"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-lead"
          data-detail="lead"
          hidden
        >
          <p class="card-agent"><i></i> Atlas brought the company map</p>
          <h2>From codebase to company.</h2>
          <p>
            Founder and CTO at OdeCloud, translating uncertainty into a bet.
          </p>
          <div class="client-line">
            <span>JVC Kenwood</span><span>Coinbase</span><span>WarnerMedia</span
            >
          </div>
          <a href={FORBES_URL} target="_blank" rel="noopener noreferrer">
            Read the OdeCloud feature <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article
          class="detail-card book-card"
          id="detail-read"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-read"
          data-detail="read"
          hidden
        >
          <img
            src="assets/book-cover.jpg?v=3"
            width="1600"
            height="2560"
            alt="Cover of Emperors, Prophets, and Product Managers"
            loading="lazy"
          />
          <div>
            <p class="card-agent"><i></i> Quill saved your place</p>
            <h2>Leadership is ancient chaos.</h2>
            <p>A field guide for the people building through it.</p>
            <a href={AMAZON_URL} target="_blank" rel="noopener noreferrer">
              Read the book <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article
          class="detail-card"
          id="detail-notes"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-notes"
          data-detail="notes"
          hidden
        >
          <p class="card-agent"><i></i> Scout found three useful trails</p>
          <h2>Notes worth keeping.</h2>
          <div class="note-trails">
            <span>AI without the theater</span>
            <span>The industry playbook</span>
            <span>Building across cultures</span>
          </div>
          <button type="button" data-invite-open>
            Get the next note <span aria-hidden="true">→</span>
          </button>
        </article>

        <article
          class="detail-card talk-card"
          id="detail-talk"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-talk"
          data-detail="talk"
          hidden
        >
          <p class="card-agent"><i></i> Miso reserved thirty minutes</p>
          <h2>Bring one hard decision.</h2>
          <p>AI, architecture, product, or the team around it.</p>
          <strong>From $300/hr</strong>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
            Start a conversation <span aria-hidden="true">↗</span>
          </a>
        </article>
      </section>
    </main>

    <aside class="story-meter" aria-hidden="true">
      <span class="story-track"><i data-story-fill></i></span>
      <p>
        <b data-story-index>01</b><em>/ 06</em>
        <strong data-story-name>Meet</strong>
      </p>
    </aside>

    <nav class="agent-dock" role="tablist" aria-label="Choose an agent">
      {
        agents.map((agent, index) => (
          <button
            type="button"
            role="tab"
            id={`agent-${agent.id}`}
            aria-controls={`detail-${agent.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
            data-agent-mode={agent.id}
            data-agent-color={agent.color}
          >
            <span
              class="agent-face"
              style={`--agent-color:${agent.color}`}
              aria-hidden="true"
            >
              <>
                <i />
                <i />
              </>
            </span>
            <span class="agent-name">
              <small>{agent.name}</small>
              <strong>{agent.label}</strong>
            </span>
          </button>
        ))
      }
    </nav>

    <aside
      class="invitation is-open"
      role="dialog"
      aria-modal="false"
      aria-labelledby="invitation-title"
      data-invitation
    >
      <button
        class="invitation-close"
        type="button"
        aria-label="Explore first"
        data-invite-close
      >
        Explore first <span aria-hidden="true">×</span>
      </button>
      <div class="invitation-orb" aria-hidden="true"><i></i><i></i></div>
      <p class="invitation-label">A note from Vanielle</p>
      <h2 id="invitation-title">Leave your email with the agents.</h2>
      <p>
        They’ll deliver practical notes on AI, careers, leadership, and
        cross-cultural founder life.
      </p>
      <NewsletterSignup />
    </aside>

    <footer class="atelier-footer">
      <span>© {new Date().getFullYear()} Vanielle Lee</span>
      <nav aria-label="Social links">
        <a
          href="https://x.com/lee_vanielle"
          target="_blank"
          rel="noopener noreferrer">X</a
        >
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
        <a
          href="https://github.com/leevanielle"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </nav>
    </footer>

    <div class="scroll-story" aria-hidden="true">
      {
        agents.map((agent, index) => (
          <section data-scroll-mode={agent.id} data-scroll-index={index}>
            <span>
              {String(index + 1).padStart(2, "0")} · {agent.label}
            </span>
          </section>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  const shell = document.querySelector("[data-atelier]");
  const tabs = Array.from(document.querySelectorAll("[data-agent-mode]"));
  const details = Array.from(document.querySelectorAll("[data-detail]"));
  const chapters = Array.from(document.querySelectorAll("[data-scroll-mode]"));
  const storyFill = document.querySelector("[data-story-fill]");
  const storyIndex = document.querySelector("[data-story-index]");
  const storyName = document.querySelector("[data-story-name]");
  const railPath = document.querySelector("[data-agent-rail]");
  const railTraveler = document.querySelector("[data-rail-traveler]");
  const railStations = Array.from(
    document.querySelectorAll("[data-rail-station]")
  );
  const boardMode = document.querySelector("[data-board-mode]");
  const boardIndex = document.querySelector("[data-board-index]");
  const boardProgress = document.querySelector("[data-board-progress]");
  const invitation = document.querySelector("[data-invitation]");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;
  const aliases = {
    lobby: "host",
    lab: "build",
    boardroom: "lead",
    library: "read",
    balcony: "notes",
    salon: "talk",
  };
  const ids = tabs.flatMap(tab =>
    tab.dataset.agentMode ? [tab.dataset.agentMode] : []
  );
  let scrollProgress = 0;
  let scrollVelocity = 0;
  let lastScrollY = window.scrollY;
  let scrollTick = 0;
  let scrollHasStarted = false;

  const closeInvitation = () => {
    invitation?.classList.remove("is-open");
    invitation?.setAttribute("aria-hidden", "true");
  };

  const openInvitation = () => {
    invitation?.classList.add("is-open");
    invitation?.removeAttribute("aria-hidden");
    window.setTimeout(
      () => {
        document.querySelector("#newsletter-email")?.focus();
      },
      reduceMotion ? 0 : 420
    );
  };

  const selectMode = (id, options = {}) => {
    if (!ids.includes(id)) return;
    const activeIndex = ids.indexOf(id);
    shell?.setAttribute("data-mode", id);
    tabs.forEach(tab => {
      const active = tab.dataset.agentMode === id;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    details.forEach(detail => {
      const active = detail.dataset.detail === id;
      detail.hidden = !active;
      detail.classList.toggle("is-active", active);
    });
    if (storyIndex)
      storyIndex.textContent = String(activeIndex + 1).padStart(2, "0");
    if (storyName)
      storyName.textContent =
        tabs[activeIndex]?.querySelector("strong")?.textContent ?? "";
    railStations.forEach(station => {
      station.classList.toggle("is-active", station.dataset.railStation === id);
    });
    const activeLabel =
      tabs[activeIndex]?.querySelector("strong")?.textContent ?? "";
    if (boardMode) boardMode.textContent = activeLabel.toUpperCase();
    if (boardIndex)
      boardIndex.textContent = `${String(activeIndex + 1).padStart(
        2,
        "0"
      )} / 06`;
    if (options.updateUrl !== false) {
      window.history.replaceState(null, "", `#${id}`);
    }
    if (options.reveal !== false) closeInvitation();
    if (options.focus) {
      document.querySelector(`[data-detail="${id}"]`)?.focus({
        preventScroll: true,
      });
    }
  };

  const updateRailPosition = progress => {
    if (!railPath || !railTraveler) return;
    const length = railPath.getTotalLength();
    const distance = Math.min(length, Math.max(0, progress * length));
    const point = railPath.getPointAtLength(distance);
    const next = railPath.getPointAtLength(Math.min(length, distance + 2));
    const angle =
      Math.atan2(next.y - point.y, next.x - point.x) * (180 / Math.PI);
    railTraveler.setAttribute(
      "transform",
      `translate(${point.x} ${point.y}) rotate(${angle * 0.24})`
    );
  };

  const scrollToMode = (id, behavior = reduceMotion ? "auto" : "smooth") => {
    const chapter = chapters.find(item => item.dataset.scrollMode === id);
    if (!chapter) return;
    scrollHasStarted = id !== "host" || window.scrollY > 8;
    chapter.scrollIntoView({ behavior, block: "start" });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      const id = tab.dataset.agentMode;
      if (id) {
        selectMode(id);
        scrollToMode(id);
      }
    });
    tab.addEventListener("keydown", event => {
      if (
        !["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)
      )
        return;
      event.preventDefault();
      const direction =
        event.key === "ArrowLeft" || event.key === "ArrowUp" ? -1 : 1;
      const next = tabs[(index + direction + tabs.length) % tabs.length];
      const id = next?.dataset.agentMode;
      next?.focus();
      if (id) {
        selectMode(id);
        scrollToMode(id);
      }
    });
  });

  document.querySelectorAll("[data-mode-shortcut]").forEach(button => {
    button.addEventListener("click", event => {
      event.preventDefault();
      const id = button.dataset.modeShortcut;
      if (id) {
        selectMode(id);
        scrollToMode(id);
      }
    });
  });
  document
    .querySelectorAll("[data-invite-open]")
    .forEach(button => button.addEventListener("click", openInvitation));
  document
    .querySelector("[data-invite-close]")
    ?.addEventListener("click", closeInvitation);

  const rawHash = window.location.hash.slice(1);
  const initialId = ids.includes(rawHash) ? rawHash : aliases[rawHash];
  selectMode(initialId ?? "host", {
    updateUrl: false,
    reveal: Boolean(initialId),
  });
  if (initialId) {
    scrollHasStarted = initialId !== "host";
    closeInvitation();
  }

  const updateScrollState = () => {
    scrollTick = 0;
    const y = window.scrollY;
    const max = Math.max(
      1,
      document.documentElement.scrollHeight - window.innerHeight
    );
    scrollProgress = Math.min(1, Math.max(0, y / max));
    scrollVelocity = Math.max(-120, Math.min(120, y - lastScrollY));
    lastScrollY = y;
    if (y > 8) scrollHasStarted = true;
    shell?.classList.toggle("has-scrolled", y > window.innerHeight * 0.18);
    shell?.style.setProperty("--story-progress", String(scrollProgress));
    shell?.style.setProperty("--story-hue", `${scrollProgress * 42}deg`);
    shell?.style.setProperty("--story-shift", `${scrollProgress * 84}px`);
    shell?.style.setProperty(
      "--board-tilt",
      `${Math.max(-1.4, Math.min(1.4, scrollVelocity * 0.025))}deg`
    );
    if (storyFill) storyFill.style.transform = `scaleX(${scrollProgress})`;
    if (boardProgress)
      boardProgress.style.transform = `scaleX(${scrollProgress})`;
    updateRailPosition(scrollProgress);
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!scrollTick)
        scrollTick = window.requestAnimationFrame(updateScrollState);
    },
    { passive: true }
  );
  window.addEventListener("resize", updateScrollState, { passive: true });

  const chapterObserver = new IntersectionObserver(
    entries => {
      const active = entries
        .filter(entry => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      const id = active?.target.dataset.scrollMode;
      if (!id || (!scrollHasStarted && id === "host")) return;
      selectMode(id, {
        reveal: id !== "host" || window.scrollY > window.innerHeight * 0.18,
      });
    },
    {
      rootMargin: "-38% 0px -38% 0px",
      threshold: [0, 0.1, 0.5, 1],
    }
  );
  chapters.forEach(chapter => chapterObserver.observe(chapter));

  window.requestAnimationFrame(() => {
    if (initialId) scrollToMode(initialId, "auto");
    updateScrollState();
  });

  window.addEventListener("hashchange", () => {
    const raw = window.location.hash.slice(1);
    const id = ids.includes(raw) ? raw : aliases[raw];
    if (id) {
      selectMode(id, { updateUrl: false });
      scrollToMode(id);
    }
  });
</script>

<style>
  :global(html) {
    background: #f2eee4;
    scroll-behavior: smooth;
    scroll-snap-type: y proximity;
  }

  :global(body) {
    margin: 0;
    background: #f2eee4;
    color: #191915;
    font-family: "Manrope", "DM Sans", sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global([hidden]) {
    display: none !important;
  }

  .atelier-shell {
    --ink: #191915;
    --paper: #f2eee4;
    --paper-bright: #fbf8ef;
    --red: #cf2f21;
    --red-dark: #9f2018;
    --amber: #d4a33b;
    --salmon: #ef746d;
    --muted: #716c61;
    --porcelain: var(--paper);
    --jade: var(--red);
    --rose: var(--salmon);
    --brass: var(--amber);
    position: relative;
    min-height: 100svh;
    overflow-x: hidden;
    overflow-y: visible;
    background: linear-gradient(rgba(25, 25, 21, 0.045) 1px, transparent 1px),
      var(--paper);
    background-position-y: var(--story-shift, 0px);
    background-size: 100% 28px;
  }

  .sheet-texture {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100svh;
    pointer-events: none;
    opacity: 0.12;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E");
    mix-blend-mode: multiply;
  }

  .atelier-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 10;
    min-height: 74px;
    padding: 0 1.6rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid rgba(25, 25, 21, 0.28);
    background: rgba(242, 238, 228, 0.9);
    backdrop-filter: blur(16px);
  }

  .wordmark,
  .atelier-header button,
  .intro button,
  .detail-card a,
  .detail-card button {
    color: inherit;
    font: inherit;
  }

  .wordmark {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .wordmark span {
    color: var(--red);
  }

  .atelier-status {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: rgba(25, 25, 21, 0.55);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .atelier-status i {
    width: 7px;
    height: 7px;
    display: block;
    border-radius: 50%;
    border-radius: 0;
    background: var(--red);
    box-shadow: 0 0 0 4px rgba(207, 47, 33, 0.1);
  }

  .guestbook-trigger {
    justify-self: end;
    min-height: 42px;
    padding: 0 0.95rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 4px 4px 0 var(--red);
    cursor: pointer;
    font-size: 0.68rem;
  }

  .studio-grid {
    position: fixed;
    inset: 74px 0 0;
    z-index: 5;
    height: calc(100svh - 74px);
    padding: 4rem clamp(1.4rem, 4vw, 4.5rem) 7rem;
    display: grid;
    grid-template-columns: minmax(250px, 0.82fr) minmax(300px, 1.45fr) minmax(
        300px,
        0.92fr
      );
    gap: clamp(1rem, 3vw, 3.2rem);
    pointer-events: none;
  }

  .intro,
  .detail-deck,
  .discovery-hint {
    pointer-events: auto;
  }

  .intro {
    align-self: center;
    max-width: 360px;
    transition:
      opacity 600ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 600ms ease;
  }

  .atelier-shell.has-scrolled .intro {
    opacity: 0.12;
    filter: blur(1px);
    transform: translateX(-18px) scale(0.98);
  }

  .host-portrait {
    width: 74px;
    margin: 0 0 1.1rem;
  }

  .host-portrait img {
    width: 64px;
    height: 64px;
    display: block;
    border: 2px solid var(--ink);
    border-radius: 4px;
    object-fit: cover;
    filter: saturate(0.72);
    box-shadow: 6px 6px 0 var(--red);
  }

  .host-portrait figcaption {
    width: max-content;
    margin-top: 0.45rem;
    color: rgba(25, 25, 21, 0.52);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.48rem;
    text-transform: uppercase;
  }

  .intro-label,
  .card-agent,
  .invitation-label {
    margin: 0;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: "Bodoni Moda", "Newsreader", Georgia, serif;
    font-weight: 500;
    text-wrap: balance;
  }

  h1 {
    margin-top: 0.8rem;
    font-size: clamp(2.55rem, 4.1vw, 4.35rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .intro-copy {
    max-width: 340px;
    margin: 1.1rem 0 0;
    color: rgba(25, 25, 21, 0.68);
    font-size: clamp(0.82rem, 1vw, 0.98rem);
    line-height: 1.68;
  }

  .intro-actions {
    margin-top: 1.35rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .intro-actions button,
  .detail-card > button,
  .detail-card a {
    min-height: 42px;
    padding: 0.65rem 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 0;
    border-radius: 3px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 5px 5px 0 var(--red);
    cursor: pointer;
    font-size: 0.64rem;
    font-weight: 700;
    text-decoration: none;
  }

  .intro-actions span {
    color: rgba(25, 25, 21, 0.5);
    font-size: 0.58rem;
  }

  .discovery {
    position: relative;
    min-height: 420px;
  }

  .discovery-hint {
    position: absolute;
    top: 4%;
    left: 50%;
    width: 180px;
    margin: 0;
    display: flex;
    gap: 0.65rem;
    color: rgba(25, 25, 21, 0.5);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.52rem;
    line-height: 1.55;
    transform: translateX(-50%);
  }

  .discovery-hint span {
    color: var(--red);
  }

  .field-board {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100%, 620px);
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 4px;
    background: var(--paper-bright);
    box-shadow: 11px 11px 0 var(--amber);
    transform: translate(-50%, -48%) rotate(var(--board-tilt, 0deg));
    transform-origin: center;
    transition:
      transform 120ms ease-out,
      opacity 350ms ease;
  }

  .field-board header,
  .field-board footer {
    min-height: 38px;
    padding: 0 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-color: var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.48rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .field-board header {
    justify-content: space-between;
    border-bottom: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .field-board header strong {
    color: var(--salmon);
  }

  .field-board svg {
    width: 100%;
    height: auto;
    display: block;
    color: rgba(25, 25, 21, 0.16);
  }

  .board-grid {
    fill: url(#manual-grid);
    stroke: none;
  }

  .rail-shadow,
  .agent-rail {
    fill: none;
    stroke-linecap: round;
  }

  .rail-shadow {
    stroke: var(--amber);
    stroke-width: 13;
    opacity: 0.32;
  }

  .agent-rail {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-dasharray: 4 7;
  }

  .rail-station {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 240ms ease,
      scale 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rail-station:not(.is-active) {
    opacity: 0.58;
  }

  .rail-station.is-active {
    opacity: 1;
    scale: 1.18;
  }

  .station-ring {
    fill: var(--paper-bright);
    stroke: var(--station-color);
    stroke-width: 2;
  }

  .rail-station.is-active .station-ring {
    fill: var(--station-color);
    stroke: var(--ink);
  }

  .station-face {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
  }

  .station-eye {
    fill: var(--ink);
  }

  .station-antenna {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  .rail-station text,
  .board-ticks text {
    fill: var(--muted);
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
    text-anchor: middle;
  }

  .traveler-signal {
    fill: var(--red);
    opacity: 0.14;
    animation: traveler-ping 1.8s ease-out infinite;
  }

  .traveler-face {
    fill: var(--red);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .traveler-eye {
    fill: var(--paper-bright);
  }

  .traveler-antenna {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }

  .board-ticks path {
    fill: none;
    stroke: var(--red);
    stroke-width: 2;
  }

  .board-ticks text {
    text-anchor: start;
  }

  .field-board footer {
    border-top: 1px solid var(--ink);
    color: var(--muted);
  }

  .field-board footer i {
    height: 3px;
    flex: 1;
    overflow: hidden;
    background: rgba(25, 25, 21, 0.14);
  }

  .field-board footer b {
    width: 100%;
    height: 100%;
    display: block;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
  }

  .field-board footer strong {
    color: var(--ink);
  }

  .detail-deck {
    align-self: center;
    min-width: 0;
  }

  .story-meter {
    position: fixed;
    top: 94px;
    left: 50%;
    z-index: 12;
    width: min(210px, 32vw);
    color: rgba(25, 25, 21, 0.48);
    font-family: "IBM Plex Mono", monospace;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .story-track {
    width: 100%;
    height: 1px;
    display: block;
    overflow: hidden;
    background: rgba(25, 25, 21, 0.16);
  }

  .story-track i {
    width: 100%;
    height: 100%;
    display: block;
    background: linear-gradient(90deg, var(--red), var(--amber), var(--salmon));
    transform: scaleX(0);
    transform-origin: left center;
  }

  .story-meter p {
    margin: 0.5rem 0 0;
    display: flex;
    align-items: baseline;
    gap: 0.22rem;
    font-size: 0.46rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .story-meter b {
    color: var(--ink);
    font-size: 0.62rem;
  }

  .story-meter em {
    font-style: normal;
    opacity: 0.44;
  }

  .story-meter strong {
    margin-left: auto;
    color: var(--red);
    font-size: 0.48rem;
  }

  .scroll-story {
    position: relative;
    z-index: 0;
    pointer-events: none;
  }

  .scroll-story section {
    height: 100svh;
    position: relative;
    scroll-snap-align: start;
  }

  .scroll-story section > span {
    position: absolute;
    right: 1.5rem;
    top: 50%;
    color: rgba(25, 25, 21, 0.18);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.46rem;
    letter-spacing: 0.08em;
    writing-mode: vertical-rl;
  }

  .detail-card {
    width: min(370px, 100%);
    min-height: 350px;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border: 2px solid var(--ink);
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 9px 9px 0 var(--red);
  }

  .detail-card.is-active {
    animation: card-arrival 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .detail-card > button,
  .detail-card a {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--red);
  }

  .card-agent {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--salmon);
    font-size: 0.5rem;
  }

  .card-agent i {
    width: 6px;
    height: 6px;
    display: block;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 12px currentColor;
  }

  .detail-card h2 {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 3.5vw, 3.75rem);
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .detail-card > p:not(.card-agent),
  .book-card > div > p:not(.card-agent) {
    margin: 1rem 0 0;
    color: rgba(242, 238, 228, 0.68);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .proof-pills,
  .skill-cloud,
  .client-line,
  .note-trails {
    margin: 1.2rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .proof-pills span,
  .skill-cloud span,
  .client-line span,
  .note-trails span {
    padding: 0.48rem 0.62rem;
    border: 1px solid rgba(242, 238, 228, 0.24);
    border-radius: 999px;
    color: rgba(242, 238, 228, 0.72);
    font-size: 0.55rem;
  }

  .proof-pills strong {
    margin-right: 0.2rem;
    color: var(--paper);
    font-family: "Bodoni Moda", Georgia, serif;
    font-size: 1.25rem;
  }

  .book-card {
    display: grid;
    grid-template-columns: 105px 1fr;
    align-items: center;
    gap: 1.1rem;
  }

  .book-card > img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.34);
    transform: rotate(-3deg);
  }

  .book-card h2 {
    font-size: clamp(1.9rem, 3vw, 3rem);
  }

  .book-card a {
    margin-top: 1rem;
  }

  .note-trails {
    flex-direction: column;
  }

  .note-trails span {
    border-radius: 12px;
  }

  .talk-card > strong {
    margin: 1.1rem 0;
    display: block;
    color: var(--rose);
    font-family: "Bodoni Moda", Georgia, serif;
    font-size: 2.25rem;
    font-weight: 500;
  }

  .agent-dock {
    position: fixed;
    bottom: 1.4rem;
    left: 50%;
    z-index: 14;
    width: max-content;
    max-width: calc(100vw - 2rem);
    padding: 0.42rem;
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    border: 2px solid var(--ink);
    border-radius: 4px;
    background: var(--ink);
    box-shadow: 7px 7px 0 var(--red);
    transform: translateX(-50%);
    scrollbar-width: none;
  }

  .agent-dock::-webkit-scrollbar {
    display: none;
  }

  .agent-dock button {
    min-width: 84px;
    min-height: 54px;
    padding: 0.4rem 0.55rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: rgba(242, 238, 228, 0.66);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .agent-dock button:hover {
    background: rgba(242, 238, 228, 0.1);
    transform: translateY(-2px);
  }

  .agent-dock button[aria-selected="true"] {
    background: var(--paper);
    color: var(--ink);
  }

  .agent-face,
  .invitation-orb {
    position: relative;
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    display: block;
    border-radius: 50%;
    background: var(--agent-color);
    box-shadow:
      inset -4px -6px 10px rgba(30, 37, 34, 0.12),
      0 0 18px color-mix(in srgb, var(--agent-color) 40%, transparent);
  }

  .agent-face::before,
  .agent-face::after,
  .invitation-orb::before,
  .invitation-orb::after {
    content: "";
    position: absolute;
    top: 12px;
    width: 3px;
    height: 4px;
    border-radius: 50%;
    background: #18201d;
  }

  .agent-face::before,
  .invitation-orb::before {
    left: 9px;
  }

  .agent-face::after,
  .invitation-orb::after {
    right: 9px;
  }

  .agent-face i:first-child,
  .invitation-orb i:first-child {
    position: absolute;
    top: -6px;
    left: 14px;
    width: 1px;
    height: 7px;
    display: block;
    background: var(--agent-color);
  }

  .agent-face i:last-child,
  .invitation-orb i:last-child {
    position: absolute;
    top: -8px;
    left: 12px;
    width: 5px;
    height: 5px;
    display: block;
    border-radius: 50%;
    background: var(--agent-color);
  }

  .agent-name small,
  .agent-name strong {
    display: block;
  }

  .agent-name small {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.43rem;
    font-weight: 500;
    opacity: 0.62;
  }

  .agent-name strong {
    margin-top: 0.05rem;
    font-size: 0.62rem;
    font-weight: 700;
  }

  .invitation {
    position: fixed;
    top: 92px;
    right: 1.5rem;
    z-index: 30;
    width: min(410px, calc(100vw - 2rem));
    padding: 1.35rem;
    border: 2px solid var(--ink);
    border-radius: 4px;
    background: rgba(251, 248, 239, 0.98);
    color: var(--ink);
    box-shadow:
      11px 11px 0 var(--red),
      0 35px 120px rgba(25, 25, 21, 0.2);
    transform: translateY(-18px) scale(0.96);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 260ms ease;
  }

  .invitation.is-open {
    transform: translateY(0) scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  .invitation-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.35rem 0.5rem;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.56rem;
  }

  .invitation-orb {
    --agent-color: #cf2f21;
    width: 38px;
    height: 38px;
    margin-bottom: 1.1rem;
  }

  .invitation-orb::before,
  .invitation-orb::after {
    top: 15px;
  }

  .invitation-orb::before {
    left: 12px;
  }

  .invitation-orb::after {
    right: 12px;
  }

  .invitation-orb i:first-child {
    top: -7px;
    left: 18px;
  }

  .invitation-orb i:last-child {
    top: -9px;
    left: 16px;
  }

  .invitation-label {
    color: var(--red);
  }

  .invitation h2 {
    max-width: 330px;
    margin-top: 0.6rem;
    font-size: clamp(2rem, 3.6vw, 3.05rem);
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .invitation > p:not(.invitation-label) {
    margin: 0.85rem 0 1.1rem;
    color: var(--muted);
    font-size: 0.73rem;
    line-height: 1.55;
  }

  .atelier-footer {
    position: fixed;
    right: 1.5rem;
    bottom: 1.4rem;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    color: rgba(25, 25, 21, 0.4);
    font-size: 0.5rem;
  }

  .atelier-footer nav {
    display: flex;
    gap: 0.8rem;
  }

  .atelier-footer a {
    color: rgba(25, 25, 21, 0.68);
    text-decoration: none;
  }

  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(input:focus-visible) {
    outline: 2px solid var(--brass);
    outline-offset: 3px;
  }

  @keyframes breathe {
    to {
      transform: scale(1.16) translateY(-2%);
      opacity: 0.78;
    }
  }

  @keyframes traveler-ping {
    0% {
      opacity: 0.28;
      transform: scale(0.55);
    }
    75%,
    100% {
      opacity: 0;
      transform: scale(1.18);
    }
  }

  @keyframes card-arrival {
    from {
      opacity: 0;
      transform: translateY(16px) rotateX(-3deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1020px) {
    .studio-grid {
      grid-template-columns: minmax(230px, 0.82fr) minmax(250px, 1.1fr) minmax(
          270px,
          0.9fr
        );
      padding-inline: 1.4rem;
      gap: 1.2rem;
    }

    .detail-card {
      min-height: 330px;
    }

    .agent-name small {
      display: none;
    }

    .agent-dock button {
      min-width: 72px;
    }
  }

  @media (max-width: 820px) {
    .atelier-shell {
      min-height: 100svh;
      overflow-x: hidden;
      overflow-y: visible;
    }

    .sheet-texture {
      position: fixed;
      inset: 0;
      height: 100svh;
    }

    .atelier-header {
      position: fixed;
      top: 0;
      grid-template-columns: 1fr auto;
    }

    .atelier-status {
      display: none;
    }

    .studio-grid {
      position: fixed;
      inset: 74px 0 0;
      width: 100%;
      height: calc(100svh - 74px);
      min-height: 0;
      padding: 0.9rem;
      display: block;
    }

    .intro {
      position: absolute;
      top: clamp(2.5rem, 8svh, 4.5rem);
      left: 1rem;
      width: min(72%, 330px);
      min-height: 0;
      padding-top: 0;
      display: flex;
      flex-direction: column;
      z-index: 3;
    }

    .atelier-shell.has-scrolled .intro {
      opacity: 0;
      filter: blur(4px);
      pointer-events: none;
      transform: translateY(-22px) scale(0.97);
    }

    h1 {
      font-size: clamp(2.5rem, 11.5vw, 3.6rem);
    }

    .intro-copy {
      font-size: 0.78rem;
    }

    .discovery {
      position: absolute;
      inset: 0;
      z-index: 1;
      min-height: 0;
    }

    .field-board {
      top: 47%;
      width: calc(100% - 1.4rem);
      box-shadow: 7px 7px 0 var(--amber);
    }

    .atelier-shell:not(.has-scrolled) .field-board {
      opacity: 0.14;
      transform: translate(-50%, -48%) scale(0.93);
    }

    .discovery-hint {
      display: none;
    }

    .detail-deck {
      position: absolute;
      right: 0.8rem;
      bottom: 5.6rem;
      left: 0.8rem;
      z-index: 6;
      width: auto;
      margin: 0;
      opacity: 0;
      pointer-events: none;
      transform: translateY(24px) scale(0.98);
      transition:
        opacity 360ms ease,
        transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .atelier-shell.has-scrolled .detail-deck,
    .atelier-shell:not([data-mode="host"]) .detail-deck {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    .detail-card {
      width: 100%;
      min-height: 0;
      max-height: min(44svh, 400px);
      padding: 1.15rem;
      overflow-y: auto;
      border-radius: 4px;
    }

    .detail-card h2 {
      font-size: clamp(2rem, 9.5vw, 3rem);
    }

    .story-meter {
      top: 88px;
      right: 0.9rem;
      left: auto;
      width: 116px;
      transform: none;
    }

    .agent-dock {
      right: 0.5rem;
      bottom: 0.5rem;
      left: 0.5rem;
      width: auto;
