---
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";

const AMAZON_URL = "https://www.amazon.com/dp/B0HF6JW33T";
const LINKEDIN_URL = "https://linkedin.com/in/vanielle";
const FORBES_URL =
  "https://www.forbes.com/sites/jonyounger/2020/11/23/meet-another-freelance-innovator-odecloud-a-netsuite-expert-community/";
const LIVE_URL = "https://leevanielle.github.io/vanielle-/";
const X_SHARE_URL =
  "https://twitter.com/intent/tweet?text=" +
  encodeURIComponent(
    "A penthouse tour through AI, engineering leadership, and building across cultures."
  ) +
  "&url=" +
  encodeURIComponent(LIVE_URL) +
  "&via=lee_vanielle";
---

<Layout
  title="Vanielle Lee — AI Engineer, Founder & CTO"
  description="Step inside Vanielle Lee’s interactive penthouse—a room-by-room tour through agentic AI, engineering leadership, her book, and founder life."
>
  <div class="penthouse-shell">
    <div class="skyline" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>

    <header class="penthouse-header">
      <a class="wordmark" href="#lobby" data-room-shortcut="lobby">
        <span class="wordmark-gem" aria-hidden="true">✦</span>
        <span>Vanielle Lee</span>
      </a>

      <p class="building-title">
        <span>Private residence</span>
         AI engineer · Founder · CTO
      </p>

      <div class="header-actions">
        <a href={AMAZON_URL} target="_blank" rel="noopener noreferrer">
          The book
        </a>
        <a class="guestbook-shortcut" href="#guestbook" data-focus-newsletter>
          Sign the guestbook
        </a>
      </div>
    </header>

    <main class="residence">
      <aside class="floor-plan" aria-labelledby="floor-plan-heading">
        <div class="floor-plan-heading">
          <p id="floor-plan-heading">Penthouse directory</p>
          <span>PH</span>
        </div>

        <div class="elevator-status" aria-live="polite">
          <span aria-hidden="true"></span>
          <p>
            Now viewing
            <strong data-room-status>The lobby</strong>
          </p>
        </div>

        <div class="room-map" role="tablist" aria-label="Explore the penthouse">
          <button
            class="room-key room-key-lobby"
            type="button"
            role="tab"
            id="tab-lobby"
            aria-controls="panel-lobby"
            aria-selected="true"
            tabindex="0"
            data-room-tab="lobby"
            data-room-label="The lobby"
          >
            <span>Welcome</span>
            <strong>Lobby</strong>
          </button>
          <button
            class="room-key room-key-lab"
            type="button"
            role="tab"
            id="tab-lab"
            aria-controls="panel-lab"
            aria-selected="false"
            tabindex="-1"
            data-room-tab="lab"
            data-room-label="The lab"
          >
            <span>Build</span>
            <strong>Lab</strong>
          </button>
          <button
            class="room-key room-key-boardroom"
            type="button"
            role="tab"
            id="tab-boardroom"
            aria-controls="panel-boardroom"
            aria-selected="false"
            tabindex="-1"
            data-room-tab="boardroom"
            data-room-label="The boardroom"
          >
            <span>Lead</span>
            <strong>Boardroom</strong>
          </button>
          <button
            class="room-key room-key-library"
            type="button"
            role="tab"
            id="tab-library"
            aria-controls="panel-library"
            aria-selected="false"
            tabindex="-1"
            data-room-tab="library"
            data-room-label="The library"
          >
            <span>Read</span>
            <strong>Library</strong>
          </button>
          <button
            class="room-key room-key-balcony"
            type="button"
            role="tab"
            id="tab-balcony"
            aria-controls="panel-balcony"
            aria-selected="false"
            tabindex="-1"
            data-room-tab="balcony"
            data-room-label="The balcony"
          >
            <span>Think</span>
            <strong>Balcony</strong>
          </button>
          <button
            class="room-key room-key-salon"
            type="button"
            role="tab"
            id="tab-salon"
            aria-controls="panel-salon"
            aria-selected="false"
            tabindex="-1"
            data-room-tab="salon"
            data-room-label="The salon"
          >
            <span>Talk</span>
            <strong>Salon</strong>
          </button>
        </div>

        <p class="map-hint">
          Choose a room. Your place in the tour will be remembered in the URL.
        </p>
      </aside>

      <section
        class="room-stage"
        aria-label="Penthouse room"
        data-room-stage
        data-active-room="lobby"
      >
        <article
          class="room-panel lobby-panel is-active"
          id="panel-lobby"
          role="tabpanel"
          tabindex="0"
          aria-labelledby="tab-lobby"
          data-room-panel="lobby"
        >
          <div class="panel-kicker">
            <span>Welcome upstairs</span>
            <i>01:12 local time</i>
          </div>

          <div class="lobby-layout">
            <div class="lobby-copy">
              <p class="room-eyebrow">The lobby</p>
              <h1>
                Technology gets complicated.
                <em>I make it easier to lead.</em>
              </h1>
              <p class="lobby-intro">
                I’m Vanielle—an AI engineer, founder, CTO, and author. I’ve
                spent 10+ years building across the stack and translating
                difficult technology into decisions people can actually make.
              </p>

              <div class="lobby-proof" aria-label="Career highlights">
                <span><strong>10+</strong> years engineering</span>
                <span><strong>8</strong> years as CTO</span>
                <a href={FORBES_URL} target="_blank" rel="noopener noreferrer">
                  <strong>Forbes</strong> featured ↗
                </a>
              </div>

              <button class="next-room" type="button" data-room-shortcut="lab">
                Start in the lab <span aria-hidden="true">→</span>
              </button>
            </div>

            <figure class="portrait-window">
              <div class="window-glow" aria-hidden="true"></div>
              <img
                src="assets/vanielle-profile.jpg"
                width="894"
                height="547"
                alt="Vanielle Lee smiling in a dark turtleneck"
                loading="eager"
                fetchpriority="high"
              />
              <figcaption>
                <span>Host</span>
                <strong>Vanielle Lee</strong>
                <i>Agentic AI · product · people</i>
              </figcaption>
            </figure>
          </div>
        </article>

        <article
          class="room-panel lab-panel"
          id="panel-lab"
          role="tabpanel"
          tabindex="0"
          aria-labelledby="tab-lab"
          data-room-panel="lab"
          hidden
        >
          <div class="panel-kicker">
            <span>The lab</span>
            <i>Systems under construction</i>
          </div>

          <div class="panel-heading">
            <p class="room-eyebrow">Where the ideas become systems</p>
            <h2>I work across the whole machine.</h2>
            <p>
              Not only the model. The product, infrastructure, data, and human
              systems required to make it useful.
            </p>
          </div>

          <div
            class="system-specimen"
            aria-label="Vanielle’s engineering range"
          >
            <div class="system-node node-model">
              <span>01</span>
              <strong>Agentic AI</strong>
              <p>LLMs, agents, evaluation, and AI product strategy.</p>
            </div>
            <div class="system-connector" aria-hidden="true">
              <i></i><i></i><i></i>
            </div>
            <div class="system-node node-product">
              <span>02</span>
              <strong>Product engineering</strong>
              <p>Frontend, backend, APIs, and product architecture.</p>
            </div>
            <div class="system-connector" aria-hidden="true">
              <i></i><i></i><i></i>
            </div>
            <div class="system-node node-platform">
              <span>03</span>
              <strong>Platform</strong>
              <p>Cloud, infrastructure, reliability, and data systems.</p>
            </div>
          </div>

          <aside class="lab-note">
            <span>Working principle</span>
            <p>
              The best technical answer is the one the company can understand,
              operate, and improve.
            </p>
          </aside>
        </article>

        <article
          class="room-panel boardroom-panel"
          id="panel-boardroom"
          role="tabpanel"
          tabindex="0"
          aria-labelledby="tab-boardroom"
          data-room-panel="boardroom"
          hidden
        >
          <div class="panel-kicker">
            <span>The boardroom</span>
            <i>Code · company · people</i>
          </div>

          <div class="boardroom-layout">
            <div class="panel-heading">
              <p class="room-eyebrow">The decisions behind the technology</p>
              <h2>From codebase to company.</h2>
              <p>
                At OdeCloud, I’ve spent eight years as CTO and founder,
                translating what the business needs into systems teams can build
                and grow.
              </p>
            </div>

            <div class="decision-table" aria-label="Leadership experience">
              <div>
                <span>Scale</span>
                <strong>Build the system before the bottleneck arrives.</strong>
              </div>
              <div>
                <span>People</span>
                <strong>Give teams context—not just instructions.</strong>
              </div>
              <div>
                <span>Strategy</span>
                <strong>Turn technical uncertainty into a clear bet.</strong>
              </div>
            </div>
          </div>

          <div class="client-shelf">
            <p>Enterprise work includes</p>
            <span>JVC Kenwood</span>
            <span>Coinbase</span>
            <span>WarnerMedia</span>
            <a href={FORBES_URL} target="_blank" rel="noopener noreferrer">
              OdeCloud in Forbes ↗
            </a>
          </div>
        </article>

        <article
          class="room-panel library-panel"
          id="panel-library"
          role="tabpanel"
          tabindex="0"
          aria-labelledby="tab-library"
          data-room-panel="library"
          hidden
        >
          <div class="panel-kicker">
            <span>The library</span>
            <i>Prophet’s guides · № 001</i>
          </div>

          <div class="library-layout">
            <figure class="book-object">
              <span aria-hidden="true"></span>
              <img
                src="assets/book-cover.jpg?v=3"
                width="1600"
                height="2560"
                alt="Cover of Emperors, Prophets, and Product Managers by Vanielle Lee"
                loading="lazy"
              />
            </figure>

            <div class="library-copy">
              <p class="room-eyebrow">Now on the reading table</p>
              <h2>Leadership has always been chaos.</h2>
              <p>
                <cite>Emperors, Prophets, and Product Managers</cite> is my
                field guide to engineering leadership, management, power,
                prediction, and the recurring human patterns behind technical
                work.
              </p>
              <div class="book-facts">
                <span><strong>12</strong> chapters</span>
                <span><strong>6</strong> frameworks</span>
                <span><strong>1</strong> honest manual</span>
              </div>
              <a
                class="room-action"
                href={AMAZON_URL}
                target="_blank"
                rel="noopener noreferrer"
              >
                Read the book <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>

        <article
          class="room-panel balcony-panel"
          id="panel-balcony"
          role="tabpanel"
          tabindex="0"
          aria-labelledby="tab-balcony"
          data-room-panel="balcony"
          hidden
        >
          <div class="panel-kicker">
            <span>The balcony</span>
            <i>Field notes from the edge</i>
          </div>

          <div class="balcony-view">
            <div class="panel-heading">
              <p class="room-eyebrow">A wider point of view</p>
              <h2>Notes for thoughtful builders.</h2>
              <p>
                The practical memo behind the hot take—written for technical and
                non-technical people alike.
              </p>
            </div>

            <div class="note-stack">
              <article>
                <span>AI</span>
                <h3>Practical AI, without the theater</h3>
                <p>What works, what breaks, and what it takes to ship.</p>
              </article>
              <article>
                <span>Career</span>
                <h3>The unspoken industry playbook</h3>
                <p>Getting hired, building leverage, and choosing well.</p>
              </article>
              <article>
                <span>Culture</span>
                <h3>Building across borders</h3>
                <p>Founder notes from countries, cultures, and expectations.</p>
              </article>
            </div>
          </div>

          <a
            class="balcony-share"
            href={X_SHARE_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Share the penthouse on X <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article
          class="room-panel salon-panel"
          id="panel-salon"
          role="tabpanel"
          tabindex="0"
          aria-labelledby="tab-salon"
          data-room-panel="salon"
          hidden
        >
          <div class="panel-kicker">
            <span>The salon</span>
            <i>Private conversation</i>
          </div>

          <div class="salon-layout">
            <div class="salon-copy">
              <p class="room-eyebrow">Bring one hard decision</p>
              <h2>Let’s make the next move clear.</h2>
              <p>
                Bring an AI bet, architecture question, product tradeoff, or
                team problem. We’ll leave the room with a practical next move.
              </p>
            </div>

            <div class="consulting-menu">
              <span>Decision session</span>
              <strong>From $300/hr</strong>
              <p>Projects, speaking, and retainers are scoped separately.</p>
              <a
                class="room-action"
                href={LINKEDIN_URL}
                target="_blank"
                rel="noopener noreferrer"
              >
                Start a conversation <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      </section>

      <aside class="guestbook" id="guestbook" aria-labelledby="guestbook-title">
        <div class="guestbook-key" aria-hidden="true">
          <span></span><i></i>
        </div>
        <p class="guestbook-label">Before you go</p>
        <h2 id="guestbook-title">Sign the guestbook.</h2>
        <p class="guestbook-copy">
          Get my field notes on AI, engineering leadership, careers, and
          building across cultures.
        </p>
        <NewsletterSignup />
        <div class="guestbook-footer">
          <span>A useful note, now and then.</span>
          <i>No spam · unsubscribe anytime</i>
        </div>
      </aside>
    </main>

    <footer class="residence-footer">
      <p>© {new Date().getFullYear()} Vanielle Lee</p>
      <nav aria-label="Social links">
        <a
          href="https://x.com/lee_vanielle"
          target="_blank"
          rel="noopener noreferrer">X</a
        >
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
        <a
          href="https://github.com/leevanielle"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </nav>
      <p>Built from the top floor.</p>
    </footer>
  </div>
</Layout>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-room-tab]")
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>("[data-room-panel]")
  );
  const shortcuts = document.querySelectorAll<HTMLElement>(
    "[data-room-shortcut]"
  );
  const stage = document.querySelector<HTMLElement>("[data-room-stage]");
  const roomStatus = document.querySelector<HTMLElement>("[data-room-status]");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const roomIds = tabs.flatMap(tab =>
    tab.dataset.roomTab ? [tab.dataset.roomTab] : []
  );

  const selectRoom = (roomId, options = {}) => {
    if (!roomIds.includes(roomId)) return;

    const selectedTab = tabs.find(tab => tab.dataset.roomTab === roomId);
    const selectedPanel = panels.find(
      panel => panel.dataset.roomPanel === roomId
    );
    if (!selectedTab || !selectedPanel) return;

    tabs.forEach(tab => {
      const selected = tab === selectedTab;
      tab.setAttribute("aria-selected", String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });

    panels.forEach(panel => {
      const selected = panel === selectedPanel;
      panel.hidden = !selected;
      panel.classList.toggle("is-active", selected);
      panel.classList.remove("is-entering");
    });

    stage?.setAttribute("data-active-room", roomId);
    if (roomStatus) {
      roomStatus.textContent = selectedTab.dataset.roomLabel ?? roomId;
    }

    if (!reduceMotion) {
      window.requestAnimationFrame(() => {
        selectedPanel.classList.add("is-entering");
      });
    }

    if (options.updateUrl !== false) {
      window.history.replaceState(null, "", "#" + roomId);
    }
    if (options.focus) {
      selectedPanel.focus({ preventScroll: true });
    }
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      const roomId = tab.dataset.roomTab;
      if (roomId) selectRoom(roomId, { focus: true });
    });

    tab.addEventListener("keydown", event => {
      if (
        !["ArrowDown", "ArrowUp", "ArrowLeft", "ArrowRight"].includes(event.key)
      ) {
        return;
      }
      event.preventDefault();
      const direction =
        event.key === "ArrowDown" || event.key === "ArrowRight" ? 1 : -1;
      const nextIndex = (index + direction + tabs.length) % tabs.length;
      const nextTab = tabs[nextIndex];
      const roomId = nextTab?.dataset.roomTab;
      if (roomId) {
        nextTab.focus();
        selectRoom(roomId);
      }
    });
  });

  shortcuts.forEach(shortcut => {
    shortcut.addEventListener("click", event => {
      const roomId = shortcut.dataset.roomShortcut;
      if (!roomId) return;
      event.preventDefault();
      selectRoom(roomId, { focus: true });
    });
  });

  document
    .querySelectorAll<HTMLAnchorElement>("[data-focus-newsletter]")
    .forEach(link => {
      link.addEventListener("click", () => {
        window.setTimeout(
          () => {
            document
              .querySelector<HTMLInputElement>("#newsletter-email")
              ?.focus({ preventScroll: true });
          },
          reduceMotion ? 0 : 450
        );
      });
    });

  const initialRoom = window.location.hash.replace("#", "");
  selectRoom(roomIds.includes(initialRoom) ? initialRoom : "lobby", {
    updateUrl: false,
  });

  window.addEventListener("hashchange", () => {
    const roomId = window.location.hash.replace("#", "");
    if (roomIds.includes(roomId)) {
      selectRoom(roomId, { updateUrl: false });
    }
  });
</script>

<style>
  :global(html) {
    background: #1d2630;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #1d2630;
    color: #25292c;
    font-family: "DM Sans", "Instrument Sans", ui-sans-serif, system-ui,
      sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global([hidden]) {
    display: none !important;
  }

  .penthouse-shell {
    --night: #1d2630;
    --night-soft: #2a3541;
    --sky: #758c9c;
    --pearl: #f6f3ec;
    --glass: #edf1ef;
    --blush: #ead9d5;
    --coral: #b95347;
    --brass: #b89a61;
    --ink: #25292c;
    --muted: #706f6a;
    --line: rgba(37, 41, 44, 0.16);
    position: relative;
    height: 100svh;
    min-height: 680px;
    padding: 0.75rem;
    display: grid;
    grid-template-rows: 64px minmax(0, 1fr) 30px;
    gap: 0.7rem;
    overflow: hidden;
    background: radial-gradient(
        circle at 72% 0%,
        rgba(117, 140, 156, 0.38),
        transparent 33%
      ),
      linear-gradient(145deg, #26313c 0%, var(--night) 58%, #171e25 100%);
  }

  .skyline {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 28%;
    pointer-events: none;
    opacity: 0.27;
  }

  .skyline span {
    position: absolute;
    bottom: 0;
    display: block;
    background: #0f151b;
  }

  .skyline span::after {
    content: "";
    position: absolute;
    inset: 10% 16%;
    background: repeating-linear-gradient(
      90deg,
      rgba(231, 204, 147, 0.55) 0 3px,
      transparent 3px 18px
    );
    mask-image: repeating-linear-gradient(
      0deg,
      black 0 3px,
      transparent 3px 16px
    );
  }

  .skyline span:nth-child(1) {
    left: 2%;
    width: 16%;
    height: 52%;
  }

  .skyline span:nth-child(2) {
    left: 20%;
    width: 19%;
    height: 74%;
  }

  .skyline span:nth-child(3) {
    left: 42%;
    width: 12%;
    height: 43%;
  }

  .skyline span:nth-child(4) {
    left: 57%;
    width: 23%;
    height: 62%;
  }

  .skyline span:nth-child(5) {
    right: 2%;
    width: 16%;
    height: 85%;
  }

  .penthouse-header,
  .floor-plan,
  .room-stage,
  .guestbook {
    position: relative;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 18px 60px rgba(7, 12, 17, 0.2);
  }

  .penthouse-header {
    padding: 0.45rem 0.55rem 0.45rem 1rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    border-radius: 18px;
    background: rgba(246, 243, 236, 0.94);
    backdrop-filter: blur(18px);
  }

  .wordmark {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.08rem;
    font-weight: 500;
    text-decoration: none;
  }

  .wordmark-gem {
    color: var(--coral);
    font-size: 0.8rem;
  }

  .building-title {
    margin: 0;
    color: #716f68;
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-align: center;
    text-transform: uppercase;
  }

  .building-title span {
    margin-right: 0.55rem;
    color: var(--coral);
    font-weight: 600;
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .header-actions a {
    min-height: 40px;
    padding: 0.65rem 0.85rem;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    color: #5f5d58;
    font-size: 0.68rem;
    font-weight: 600;
    text-decoration: none;
  }

  .header-actions .guestbook-shortcut {
    background: var(--ink);
    color: white;
  }

  .residence {
    position: relative;
    z-index: 2;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(188px, 0.55fr) minmax(520px, 2fr) minmax(
        260px,
        0.8fr
      );
    gap: 0.7rem;
  }

  .floor-plan {
    min-height: 0;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    border-radius: 22px;
    background: rgba(237, 241, 239, 0.94);
    backdrop-filter: blur(18px);
  }

  .floor-plan-heading {
    padding-bottom: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .floor-plan-heading p,
  .floor-plan-heading span {
    margin: 0;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .floor-plan-heading span {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--night);
    color: white;
  }

  .elevator-status {
    margin: 0.75rem 0;
    padding: 0.65rem 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.68);
  }

  .elevator-status > span {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #79a88f;
    box-shadow: 0 0 0 4px rgba(121, 168, 143, 0.13);
  }

  .elevator-status p {
    margin: 0;
    color: #85817a;
    font-size: 0.52rem;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .elevator-status strong {
    display: block;
    color: var(--ink);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: none;
  }

  .room-map {
    min-height: 0;
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 0.82fr 1fr 1fr;
    gap: 4px;
    border: 1px solid #aeb7b4;
    background: #aeb7b4;
  }

  .room-key {
    min-width: 0;
    padding: 0.65rem;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    flex-direction: column;
    border: 0;
    border-radius: 0;
    background: #f7f8f5;
    color: var(--ink);
    cursor: pointer;
    text-align: left;
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .room-key-lobby {
    grid-column: 1 / -1;
  }

  .room-key span,
  .room-key strong {
    display: block;
  }

  .room-key span {
    color: #89857e;
    font-size: 0.48rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .room-key strong {
    margin-top: 0.15rem;
    font-family: "Newsreader", Georgia, serif;
    font-size: clamp(0.9rem, 1.35vw, 1.3rem);
    font-weight: 400;
    line-height: 1;
  }

  .room-key:hover {
    background: var(--blush);
  }

  .room-key[aria-selected="true"] {
    position: relative;
    z-index: 2;
    background: var(--night);
    color: white;
    box-shadow: inset 0 0 0 2px var(--brass);
  }

  .room-key[aria-selected="true"] span {
    color: #cfb985;
  }

  .map-hint {
    margin: 0.75rem 0 0;
    color: #87837c;
    font-size: 0.53rem;
    line-height: 1.45;
  }

  .room-stage {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 24px;
    background: var(--pearl);
  }

  .room-stage::before {
    content: "";
    position: absolute;
    top: -110px;
    right: -90px;
    z-index: 0;
    width: 270px;
    height: 270px;
    border-radius: 50%;
    background: var(--blush);
    opacity: 0.58;
    transition:
      background 420ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .room-stage[data-active-room="lab"]::before {
    background: #d4e3de;
    transform: translate(-25px, 80px) scale(1.2);
  }

  .room-stage[data-active-room="boardroom"]::before {
    background: #d8d2c4;
    transform: translate(-90px, 35px) scale(1.35);
  }

  .room-stage[data-active-room="library"]::before {
    background: #ead9d5;
    transform: translate(-210px, 130px) scale(1.6);
  }

  .room-stage[data-active-room="balcony"]::before {
    background: #cadbe3;
    transform: translate(-30px, 130px) scale(1.5);
  }

  .room-stage[data-active-room="salon"]::before {
    background: #d6c3b6;
    transform: translate(-150px, 30px) scale(1.2);
  }

  .room-panel {
    position: relative;
    z-index: 1;
    height: 100%;
    padding: clamp(1.25rem, 2.7vw, 2.3rem);
    overflow: auto;
    outline: none;
    scrollbar-color: rgba(37, 41, 44, 0.25) transparent;
  }

  .room-panel.is-entering {
    animation: room-arrival 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .panel-kicker {
    padding-bottom: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    color: #7a7771;
    font-size: 0.54rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .panel-kicker i {
    color: var(--coral);
    font-style: normal;
  }

  .room-eyebrow {
    margin: 0 0 0.7rem;
    color: var(--coral);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: "Newsreader", Georgia, serif;
    font-weight: 400;
    text-wrap: balance;
  }

  h1 {
    max-width: 670px;
    font-size: clamp(2.75rem, 4.7vw, 4.8rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  h1 em {
    display: block;
    color: var(--coral);
    font-weight: 400;
  }

  h2 {
    font-size: clamp(2.45rem, 4vw, 4rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .lobby-layout {
    min-height: calc(100% - 2rem);
    padding-top: clamp(1.5rem, 4vh, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(200px, 0.65fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .lobby-intro {
    max-width: 630px;
    margin: 1.1rem 0 0;
    color: #5f605e;
    font-size: clamp(0.9rem, 1.2vw, 1.04rem);
    line-height: 1.68;
  }

  .lobby-proof {
    margin-top: 1.3rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .lobby-proof > * {
    min-height: 48px;
    padding: 0.55rem 0.7rem;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.58);
    color: #72706a;
    font-size: 0.59rem;
    text-decoration: none;
  }

  .lobby-proof strong {
    color: var(--ink);
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .next-room,
  .room-action {
    min-height: 44px;
    padding: 0.7rem 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--coral);
    color: white;
    cursor: pointer;
    font: inherit;
    font-size: 0.67rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease;
  }

  .next-room {
    margin-top: 1.3rem;
  }

  .next-room:hover,
  .room-action:hover {
    background: #9e443b;
    transform: translateY(-2px);
  }

  .portrait-window {
    position: relative;
    width: min(280px, 100%);
    margin: 0 auto;
    padding: 0.65rem 0.65rem 4.7rem;
    border: 1px solid var(--line);
    border-radius: 140px 140px 20px 20px;
    background: rgba(255, 255, 255, 0.64);
    box-shadow: 0 24px 70px rgba(36, 42, 46, 0.13);
  }

  .window-glow {
    position: absolute;
    inset: -8% -12% 28% 18%;
    z-index: -1;
    border-radius: 50%;
    background: #d9e4e0;
  }

  .portrait-window img {
    width: 100%;
    aspect-ratio: 0.86;
    display: block;
    border-radius: 130px 130px 14px 14px;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.76) contrast(0.95);
  }

  .portrait-window figcaption {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    left: 0.65rem;
  }

  .portrait-window figcaption span,
  .portrait-window figcaption strong,
  .portrait-window figcaption i {
    display: block;
  }

  .portrait-window figcaption span {
    color: var(--coral);
    font-size: 0.51rem;
    text-transform: uppercase;
  }

  .portrait-window figcaption strong {
    margin-top: 0.15rem;
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 400;
  }

  .portrait-window figcaption i {
    margin-top: 0.1rem;
    color: #77746e;
    font-size: 0.53rem;
    font-style: normal;
  }

  .panel-heading {
    max-width: 680px;
    padding-top: clamp(1.5rem, 3.5vh, 2.8rem);
  }

  .panel-heading > p:last-child {
    max-width: 600px;
    margin: 0.9rem 0 0;
    color: #5e605e;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .system-specimen {
    margin-top: clamp(1.5rem, 4vh, 3rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;
  }

  .system-node {
    min-height: 180px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.65);
  }

  .system-node > span {
    color: var(--coral);
    font-size: 0.54rem;
  }

  .system-node strong {
    margin-top: auto;
    font-family: "Newsreader", Georgia, serif;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 400;
  }

  .system-node p {
    margin: 0.45rem 0 0;
    color: #676964;
    font-size: 0.67rem;
    line-height: 1.5;
  }

  .system-connector {
    width: clamp(24px, 3vw, 44px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
  }

  .system-connector i {
    width: 4px;
    height: 4px;
    display: block;
    border-radius: 50%;
    background: var(--brass);
  }

  .lab-note {
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
    border-radius: 14px;
    background: var(--night);
    color: white;
  }

  .lab-note span {
    color: #cfb985;
    font-size: 0.55rem;
    text-transform: uppercase;
  }

  .lab-note p {
    margin: 0;
    color: #e3e4df;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .boardroom-layout {
    min-height: calc(100% - 130px);
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .decision-table {
    border-top: 1px solid var(--line);
  }

  .decision-table > div {
    padding: 1rem 0;
    display: grid;
    grid-template-columns: 65px 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .decision-table span {
    color: var(--coral);
    font-size: 0.56rem;
    text-transform: uppercase;
  }

  .decision-table strong {
    font-family: "Newsreader", Georgia, serif;
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .client-shelf {
    padding: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.56);
  }

  .client-shelf p {
    margin: 0 auto 0 0;
    color: #7a7771;
    font-size: 0.55rem;
    text-transform: uppercase;
  }

  .client-shelf span,
  .client-shelf a {
    padding: 0.45rem 0.55rem;
    border-radius: 999px;
    background: var(--glass);
    color: var(--ink);
    font-size: 0.54rem;
    text-decoration: none;
  }

  .client-shelf a {
    background: var(--blush);
  }

  .library-layout {
    min-height: calc(100% - 2rem);
    padding-top: 1.4rem;
    display: grid;
    grid-template-columns: minmax(190px, 0.68fr) minmax(0, 1.32fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .book-object {
    position: relative;
    width: min(300px, 100%);
    margin: 0 auto;
  }

  .book-object > span {
    position: absolute;
    inset: 7% -9% -5% 12%;
    border-radius: 24px;
    background: #d5e1dd;
    transform: rotate(4deg);
  }

  .book-object img {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    border-radius: 5px;
    box-shadow: 0 26px 65px rgba(38, 43, 46, 0.2);
    transform: rotate(-1.5deg);
    transition: transform 400ms ease;
  }

  .book-object:hover img {
    transform: rotate(0) translateY(-5px);
  }

  .library-copy > p:not(.room-eyebrow) {
    max-width: 580px;
    margin: 1rem 0 0;
    color: #5f605e;
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .library-copy cite {
    color: var(--ink);
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.12em;
  }

  .book-facts {
    margin: 1.2rem 0;
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .book-facts span {
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: #77746e;
    font-size: 0.56rem;
  }

  .book-facts strong {
    color: var(--coral);
  }

  .balcony-view {
    min-height: calc(100% - 92px);
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .note-stack {
    display: grid;
    gap: 0.6rem;
  }

  .note-stack article {
    padding: 0.9rem 1rem;
    display: grid;
    grid-template-columns: 54px 1fr;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.62);
  }

  .note-stack article > span {
    grid-row: 1 / 3;
    color: var(--coral);
    font-size: 0.55rem;
    text-transform: uppercase;
  }

  .note-stack h3 {
    font-size: clamp(1.2rem, 1.9vw, 1.6rem);
  }

  .note-stack p {
    margin: 0.2rem 0 0;
    color: #696a66;
    font-size: 0.67rem;
    line-height: 1.45;
  }

  .balcony-share {
    min-height: 42px;
    padding: 0.65rem 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    border-radius: 999px;
    background: var(--night);
    color: white;
    font-size: 0.62rem;
    font-weight: 600;
    text-decoration: none;
  }

  .salon-layout {
    min-height: calc(100% - 2rem);
    display: grid;
    grid-template-columns: 1fr 0.82fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .salon-copy > p:last-child {
    max-width: 580px;
    margin: 1rem 0 0;
    color: #5e605e;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .consulting-menu {
    padding: clamp(1.3rem, 3vw, 2.2rem);
    border-radius: 22px;
    background: var(--night);
    color: white;
    box-shadow: 0 24px 65px rgba(34, 40, 45, 0.22);
  }

  .consulting-menu > span {
    color: #cfb985;
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .consulting-menu > strong {
    margin-top: 0.65rem;
    display: block;
    color: #f0cbc5;
    font-family: "Newsreader", Georgia, serif;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    font-weight: 400;
    line-height: 1;
  }

  .consulting-menu > p {
    margin: 0.75rem 0 1.2rem;
    color: #b9bbb7;
    font-size: 0.64rem;
    line-height: 1.5;
  }

  .guestbook {
    min-height: 0;
    padding: clamp(1rem, 1.8vw, 1.5rem);
    overflow: auto;
    border-radius: 22px;
    background: rgba(234, 217, 213, 0.96);
    backdrop-filter: blur(18px);
  }

  .guestbook-key {
    position: relative;
    width: 48px;
    height: 20px;
    margin-bottom: 1rem;
  }

  .guestbook-key span {
    width: 20px;
    height: 20px;
    display: block;
    border: 1px solid var(--brass);
    border-radius: 50%;
  }

  .guestbook-key i {
    position: absolute;
    top: 9px;
    left: 19px;
    width: 28px;
    height: 1px;
    background: var(--brass);
  }

  .guestbook-key i::after {
    content: "";
    position: absolute;
    right: 2px;
    width: 1px;
    height: 7px;
    background: var(--brass);
  }

  .guestbook-label {
    margin: 0;
    color: var(--coral);
    font-size: 0.57rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .guestbook h2 {
    margin-top: 0.35rem;
    font-size: clamp(2rem, 3vw, 3rem);
  }

  .guestbook-copy {
    margin: 0.8rem 0 1rem;
    color: #65625e;
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .guestbook-footer {
    margin-top: 0.7rem;
    padding-top: 0.7rem;
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    border-top: 1px solid rgba(37, 41, 44, 0.14);
  }

  .guestbook-footer span,
  .guestbook-footer i {
    color: #75716c;
    font-size: 0.5rem;
    font-style: normal;
  }

  .residence-footer {
    position: relative;
    z-index: 2;
    padding-inline: 0.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    color: #9fabaf;
    font-size: 0.52rem;
  }

  .residence-footer p {
    margin: 0;
  }

  .residence-footer p:last-child {
    justify-self: end;
  }

  .residence-footer nav {
    display: flex;
    gap: 1rem;
  }

  .residence-footer a {
    color: #d2dadb;
    text-decoration: none;
  }

  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(input:focus-visible) {
    outline: 2px solid var(--coral);
    outline-offset: 3px;
  }

  @keyframes room-arrival {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.995);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 1120px) {
    .penthouse-shell {
      height: auto;
      min-height: 100svh;
      overflow: visible;
    }

    .residence {
      grid-template-columns: minmax(180px, 0.58fr) minmax(0, 1.42fr);
    }

    .room-stage {
      min-height: 660px;
    }

    .guestbook {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 0.7fr 1.3fr;
      gap: 1rem 2rem;
    }

    .guestbook-key,
    .guestbook-label,
    .guestbook h2,
    .guestbook-copy {
      grid-column: 1;
    }

    .guestbook :global(.newsletter-form) {
      grid-column: 2;
      grid-row: 1 / 5;
      align-self: center;
    }

    .guestbook-footer {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .penthouse-shell {
      width: 100%;
      max-width: 100vw;
      padding: 0.5rem;
      grid-template-rows: 58px auto 50px;
      overflow-x: hidden;
    }

    .penthouse-header {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      grid-template-columns: minmax(0, 1fr) auto;
      border-radius: 16px;
    }

    .wordmark,
    .header-actions {
      min-width: 0;
    }

    .building-title,
    .header-actions > a:first-child {
      display: none;
    }

    .residence {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      grid-template-columns: 1fr;
    }

    .floor-plan {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      padding: 0.75rem;
      border-radius: 18px;
    }

    .floor-plan-heading,
    .elevator-status,
    .map-hint {
      display: none;
    }

    .room-map {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      display: flex;
      gap: 4px;
      overflow-x: auto;
      border: 0;
      background: transparent;
      scrollbar-width: none;
    }

    .room-map::-webkit-scrollbar {
      display: none;
    }

    .room-key {
      min-width: max-content;
      min-height: 54px;
      padding: 0.6rem 0.8rem;
      justify-content: center;
      border: 1px solid #c5cecb;
      border-radius: 12px;
    }

    .room-key strong {
      font-size: 1rem;
    }

    .guestbook {
      width: 100%;
