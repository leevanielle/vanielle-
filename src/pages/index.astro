---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import PaintSplatter from "@components/PaintSplatter.astro";
import DecisionKnot from "@components/DecisionKnot.astro";
import getSortedPosts from "@utils/getSortedPosts";

const AMAZON_URL = "https://www.amazon.com/dp/B0HF6JW33T";
const FORBES_URL =
  "https://www.forbes.com/sites/jonyounger/2020/11/23/meet-another-freelance-innovator-odecloud-a-netsuite-expert-community/";
const latestPosts = getSortedPosts(await getCollection("blog")).slice(0, 3);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);

const socialLinks = [
  { label: "X", handle: "@lee_vanielle", href: "https://x.com/lee_vanielle" },
  {
    label: "Threads",
    handle: "@leevanielle",
    href: "https://www.threads.com/@leevanielle",
  },
  {
    label: "GitHub",
    handle: "github.com/leevanielle",
    href: "https://github.com/leevanielle",
  },
];

const bookingLinks = [
  {
    duration: "30 min",
    label: "Untangle one decision",
    detail: "$150 · one focused question",
    note: "Best when you can name the decision, but not the answer.",
    href: "https://cal.com/leevanielle/advisory-30",
  },
  {
    duration: "1 hour",
    label: "Work through the whole knot",
    detail: "$300 · a deeper working session",
    note: "Best for layered architecture, product, or leadership calls.",
    href: "https://cal.com/leevanielle/advisory-60",
  },
];
---

<Layout
  title="Vanielle Lee — AI Engineer, Founder & CTO"
  description="Vanielle Lee is an AI engineer, founder, OdeCloud CTO, and author of Emperors, Prophets, and Product Managers."
>
  <div class="home-page" id="top">
    <div class="cinema-entry" aria-hidden="true">
      <span>Field system / online</span>
      <strong>Vanielle Lee</strong>
    </div>

    <main>
      <section class="home-hero" aria-labelledby="hero-heading">
        <div class="hero-copy reveal">
          <h1 id="hero-heading">
            Hi, I’m <span class="name-mark"
              ><PaintSplatter /><span class="name-text">Vanielle</span></span
            ><em>I like making difficult things feel possible.</em>
          </h1>
          <p class="hero-intro">
            I’m a founder, CTO, AI engineer, and author. Over the past decade,
            I’ve worked across the engineering stack and spent eight years in
            the CTO seat. This is my corner of the internet for field notes on
            technology, leadership, careers, and building across cultures.
          </p>

          <figure class="portrait-system">
            <div class="portrait-rings" aria-hidden="true"><i></i><b></b></div>
            <img
              src="/assets/vanielle-profile.jpg"
              width="894"
              height="547"
              alt="Vanielle Lee smiling in a dark turtleneck"
              loading="eager"
              fetchpriority="high"
            />
          </figure>

          <aside
            class="hero-newsletter"
            id="newsletter"
            aria-labelledby="newsletter-heading"
          >
            <div class="newsletter-intro">
              <span>Field notes</span>
              <h2 id="newsletter-heading">A useful note, when I have one.</h2>
              <p>
                AI, engineering leadership, careers, and building across
                cultures.
              </p>
            </div>
            <NewsletterSignup variant="editorial" idPrefix="home-newsletter" />
          </aside>

          <div class="hero-links">
            <a href="#journal">Read the field notes <span>↓</span></a>
            <a href={FORBES_URL} target="_blank" rel="noopener noreferrer">
              OdeCloud in Forbes <span>↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="book-section" id="book" aria-labelledby="book-heading">
        <div class="book-layout">
          <figure class="book-object reveal">
            <img
              src="/assets/book-cover.jpg?v=3"
              width="1600"
              height="2560"
              alt="Cover of Emperors, Prophets, and Product Managers by Vanielle Lee"
              loading="lazy"
            />
          </figure>

          <div class="book-copy reveal">
            <p class="kicker">The new book</p>
            <h2 id="book-heading">Leadership has always been chaos.</h2>
            <p>
              Twelve chapters on power, prediction, technical leadership, and
              the recurring organizational chaos between them.
            </p>
            <div class="book-details">
              <span><strong>12</strong> chapters</span>
              <span><strong>6</strong> frameworks</span>
              <span><strong>1</strong> honest field guide</span>
            </div>
            <a href={AMAZON_URL} target="_blank" rel="noopener noreferrer">
              Read the book <span>↗</span>
            </a>
          </div>
        </div>
      </section>

      <section
        class="journal-section"
        id="journal"
        aria-labelledby="journal-heading"
      >
        <header class="section-heading reveal">
          <h2 id="journal-heading">
            My notes on work, life, and figuring things out.
          </h2>
        </header>

        <div class="home-posts">
          {
            latestPosts.map((post, index) => (
              <a
                class={`home-post post-tone-${(index % 3) + 1} reveal`}
                href={`/blog/${post.slug}/`}
              >
                <div class="post-field" aria-hidden="true">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <i />
                  <b>{post.data.tags[0] ?? "field note"}</b>
                </div>
                <article>
                  <p>
                    {formatDate(post.data.pubDatetime)} · {post.data.tags[0]}
                  </p>
                  <h3>{post.data.title}</h3>
                  <span>{post.data.description}</span>
                  <strong>
                    Read <i>↗</i>
                  </strong>
                </article>
              </a>
            ))
          }
        </div>
      </section>

      <section
        class="advisory-section"
        id="connect"
        aria-labelledby="advisory-heading"
      >
        <div class="advisory-copy reveal">
          <p class="kicker">A private working session</p>
          <h2 id="advisory-heading">Bring me the messy version.</h2>
          <p class="advisory-intro">
            You don’t need a polished brief. Tell me what’s stuck. We’ll name
            the tradeoffs, pressure-test the options, and leave with a next move
            you can defend.
          </p>
          <p class="advisory-experience">
            I’ve spent eight years in the CTO seat. I know what it feels like
            when everyone wants the answer and the answer isn’t obvious.
          </p>
        </div>

        <div class="decision-visual reveal">
          <DecisionKnot />
          <p>
            This is the work: make the knot visible, then find the useful path
            through it.
          </p>
        </div>

        <div class="advisory-booking reveal">
          <header>
            <span>How much room does the decision need?</span>
            <p>No deck. No theatre. Just a useful conversation.</p>
          </header>

          <ul class="advisory-outcomes" aria-label="What you will leave with">
            <li>Named tradeoffs</li>
            <li>A clearer decision</li>
            <li>Concrete next steps</li>
          </ul>

          <div class="booking-links">
            {
              bookingLinks.map(link => (
                <a class="booking-link" href={link.href}>
                  <span class="booking-duration">{link.duration}</span>
                  <span class="booking-copy">
                    <strong>{link.label}</strong>
                    <small>{link.detail}</small>
                    <em>{link.note}</em>
                  </span>
                  <span class="booking-action">
                    Choose <i>↗</i>
                  </span>
                </a>
              ))
            }
          </div>

          <p class="advisory-assurance">
            Private by default <i>·</i> Cal Video <i>·</i> Shown in your
            timezone
            <i>·</i> Payment confirms the slot
          </p>
        </div>
      </section>

      <section class="social-section" aria-labelledby="social-heading">
        <h2 id="social-heading" class="reveal">Come say hello.</h2>
        <nav class="social-links reveal" aria-label="Social profiles">
          {
            socialLinks.map(link => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span>
                  <strong>{link.label}</strong>
                  <small>{link.handle}</small>
                </span>
                <i>↗</i>
              </a>
            ))
          }
        </nav>
      </section>
    </main>
  </div>
</Layout>

<script>
  const revealItems = document.querySelectorAll<HTMLElement>(".reveal");
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reducedMotion || !("IntersectionObserver" in window)) {
    revealItems.forEach(item => item.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -6% 0px" }
    );
    revealItems.forEach(item => observer.observe(item));
  }
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 0;
  }
  :global(body) {
    margin: 0;
    background: #f4edcf;
  }
  :global(*) {
    box-sizing: border-box;
  }
  .home-page {
    --ink: #191915;
    --paper: #fbf8ef;
    --paper-deep: #eee4d2;
    --sage: #e4ebe0;
    --rose: #f1d8d1;
    --red: #cf2f21;
    --amber: #d9a738;
    --salmon: #ef746d;
    min-height: 100svh;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: "Instrument Sans", sans-serif;
  }
  .home-page > main,
  .home-page main > section {
    width: 100%;
    max-width: none;
    margin: 0;
  }
  h1,
  h2,
  h3 {
    font-family: "Bodoni Moda", Didot, serif;
    font-weight: 500;
  }
  .kicker {
    margin: 0 0 1.15rem;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.61rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cinema-entry {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.7rem;
    background: var(--ink);
    color: var(--paper);
    pointer-events: none;
    animation: clear-frame 1.25s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }
  .cinema-entry span {
    color: var(--salmon);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cinema-entry strong {
    font-family: "Bodoni Moda", Didot, serif;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.06em;
  }
  .hero-newsletter {
    grid-area: newsletter;
    width: min(100%, 600px);
    margin: 2rem 0 0;
    padding: 1.65rem 0 0;
    border-top: 1px solid rgba(25, 25, 21, 0.38);
    color: var(--ink);
  }
  .newsletter-intro {
    display: grid;
    gap: 0.45rem;
  }
  .newsletter-intro span {
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .newsletter-intro h2 {
    max-width: 520px;
    margin: 0;
    font-family: "Bodoni Moda", Didot, serif;
    font-size: clamp(2.2rem, 3.2vw, 3.1rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.96;
  }
  .newsletter-intro p {
    max-width: 520px;
    margin: 0.15rem 0 1.15rem;
    color: #6e675d;
    font-size: 0.84rem;
    line-height: 1.55;
  }
  .home-hero {
    position: relative;
    min-height: auto;
    padding: clamp(3rem, 5vw, 5rem) max(1rem, calc((100vw - 1240px) / 2));
    overflow: hidden;
  }
  .hero-copy {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1.14fr) minmax(360px, 0.86fr);
    grid-template-areas:
      "heading portrait"
      "intro portrait"
      "newsletter portrait"
      "links portrait";
    align-items: center;
    column-gap: clamp(3rem, 7vw, 7rem);
  }
  h1 {
    grid-area: heading;
    max-width: 800px;
    margin: 0;
    color: var(--red);
    font-family: "Instrument Sans", sans-serif;
    font-size: clamp(3.25rem, 5.2vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.13;
  }
  h1 em {
    display: block;
    margin-top: 0.12em;
    color: inherit;
    font-style: normal;
    font-weight: inherit;
  }
  .name-mark {
    position: relative;
    z-index: 0;
    display: inline-block;
    isolation: isolate;
    color: #f6c744;
    white-space: nowrap;
  }
  .name-text {
    position: relative;
    z-index: 1;
    text-shadow: 0 1px 0 rgba(91, 15, 8, 0.28);
  }
  .hero-intro {
    grid-area: intro;
    max-width: 580px;
    margin: 0.85rem 0 2rem;
    color: #5f594f;
    font-size: clamp(1rem, 1.45vw, 1.16rem);
    line-height: 1.7;
  }
  .hero-links {
    grid-area: links;
    margin-top: 1.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .hero-links a {
    color: var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.59rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
  }
  .hero-links a span {
    color: var(--red);
  }
  .portrait-system {
    grid-area: portrait;
    position: relative;
    z-index: 2;
    width: min(100%, 420px);
    margin: 0;
    justify-self: center;
    isolation: isolate;
  }
  .portrait-system > img {
    position: relative;
    z-index: 2;
    width: 100%;
    aspect-ratio: 1;
    display: block;
    border: 4px solid var(--paper);
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--ink);
    object-fit: cover;
    object-position: 53% center;
    filter: grayscale(1) contrast(1.08);
  }
  .portrait-rings {
    position: absolute;
    z-index: 1;
    width: 116%;
    aspect-ratio: 1;
    top: -8%;
    left: -8%;
    border: 1px solid rgba(207, 47, 33, 0.52);
    border-radius: 50%;
    animation: orbit-drift 10s ease-in-out infinite;
  }
  .portrait-rings::before {
    content: "";
    position: absolute;
    inset: -4%;
    border-radius: 50%;
    background: conic-gradient(
      from 32deg,
      transparent 0 13%,
      rgba(207, 47, 33, 0.82) 13% 20%,
      transparent 20% 59%,
      rgba(239, 116, 109, 0.58) 59% 64%,
      transparent 64% 100%
    );
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 2px),
      #000 0
    );
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 0);
    animation: orbit-spin 18s linear infinite;
  }
  .portrait-rings i,
  .portrait-rings b {
    position: absolute;
    border-radius: 50%;
  }
  .portrait-rings i {
    inset: 14%;
    background: conic-gradient(
      from 210deg,
      transparent 0 18%,
      rgba(217, 167, 56, 0.72) 18% 31%,
      transparent 31% 72%,
      rgba(217, 167, 56, 0.34) 72% 78%,
      transparent 78% 100%
    );
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 1px),
      #000 0
    );
    mask: radial-gradient(farthest-side, transparent calc(100% - 1px), #000 0);
    animation: orbit-spin-reverse 14s linear infinite;
  }
  .portrait-rings b {
    width: 13px;
    aspect-ratio: 1;
    top: 12%;
    right: 12%;
    background: var(--amber);
  }
  .journal-section {
    position: relative;
    padding: clamp(7rem, 12vw, 11rem) max(1rem, calc((100vw - 1160px) / 2));
  }
  .section-heading {
    margin-bottom: clamp(4rem, 8vw, 7rem);
    display: grid;
    grid-template-columns: 0.5fr 1.9fr;
    align-items: end;
    gap: clamp(1rem, 4vw, 4rem);
  }
  .section-heading .kicker {
    margin: 0 0 0.7rem;
  }
  .section-heading h2 {
    grid-column: 2;
    margin: 0;
    font-size: clamp(3.8rem, 6.8vw, 6.8rem);
    letter-spacing: -0.07em;
    line-height: 0.88;
  }
  .section-heading > span {
    color: #635d53;
    line-height: 1.65;
  }
  .book-section {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
  }
  .book-layout {
    width: min(100% - 2rem, 1120px);
    margin-inline: auto;
    padding: clamp(6rem, 11vw, 10rem) 0;
    display: grid;
    grid-template-columns: minmax(300px, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(4rem, 10vw, 9rem);
  }
  .book-object {
    width: min(100%, 430px);
    margin: 0;
    justify-self: center;
    transform: rotate(-2deg);
  }
  .book-object img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid #777268;
    box-shadow: 16px 18px 0 var(--red);
  }
  .book-copy h2 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(4rem, 7vw, 7rem);
    letter-spacing: -0.07em;
    line-height: 0.88;
  }
  .book-copy > p:not(.kicker) {
    max-width: 610px;
    margin: 1.8rem 0;
    color: #bbb5aa;
    line-height: 1.7;
  }
  .book-details {
    margin: 2rem 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #666157;
    border-left: 1px solid #666157;
  }
  .book-details span {
    min-height: 90px;
    padding: 1rem;
    display: grid;
    align-content: center;
    border-right: 1px solid #666157;
    border-bottom: 1px solid #666157;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.52rem;
    text-transform: uppercase;
  }
  .book-details strong {
    color: var(--salmon);
    font-family: "Bodoni Moda", Didot, serif;
    font-size: 2rem;
    font-weight: 500;
  }
  .book-copy > a {
    min-height: 52px;
    padding: 0.9rem 1.15rem;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    border: 1px solid var(--paper);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 7px 7px 0 var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.63rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
  }
  .book-copy > a span {
    color: var(--red);
  }
  .journal-section {
    overflow: hidden;
  }
  .home-posts {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .home-post {
    color: var(--ink);
    text-decoration: none;
  }
  .post-field {
    position: relative;
    aspect-ratio: 1.35;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid rgba(25, 25, 21, 0.25);
    font-family: "IBM Plex Mono", monospace;
    transition: transform 250ms ease;
  }
  .post-tone-1 .post-field {
    background: var(--paper-deep);
  }
  .post-tone-2 .post-field {
    background: var(--sage);
  }
  .post-tone-3 .post-field {
    background: var(--rose);
  }
  .post-field > span {
    color: var(--red);
    font-size: 0.6rem;
  }
  .post-field > i {
    position: absolute;
    width: 62%;
    aspect-ratio: 1;
    right: -8%;
    bottom: -28%;
    border: 1px solid rgba(25, 25, 21, 0.4);
    border-radius: 50%;
  }
  .post-field > i::before,
  .post-field > i::after {
    content: "";
    position: absolute;
    border-radius: 50%;
  }
  .post-field > i::before {
    inset: 25%;
    border: 1px solid rgba(207, 47, 33, 0.5);
  }
  .post-field > i::after {
    inset: 45%;
    background: var(--red);
  }
  .post-field > b {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .home-post article {
    padding-top: 1.2rem;
  }
  .home-post article > p {
    margin: 0 0 0.65rem;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.54rem;
    text-transform: uppercase;
  }
  .home-post h3 {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 3.35rem);
    letter-spacing: -0.055em;
    line-height: 1;
    transition: color 180ms ease;
  }
  .home-post article > span {
    margin: 0.8rem 0 1rem;
    display: -webkit-box;
    overflow: hidden;
    color: #635d53;
    font-size: 0.88rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .home-post article > strong {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    text-transform: uppercase;
  }
  .home-post article > strong i {
    color: var(--red);
    font-style: normal;
  }
  .home-post:hover .post-field {
    transform: rotate(-2deg) translateY(-4px);
  }
  .home-post:hover h3 {
    color: var(--red);
  }
  .advisory-section {
    position: relative;
    padding: clamp(6rem, 9vw, 8rem) max(1rem, calc((100vw - 1240px) / 2));
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(440px, 0.98fr);
    grid-template-areas:
      "copy booking"
      "visual booking";
    align-items: start;
    gap: clamp(2rem, 4vw, 3.5rem) clamp(3.5rem, 7vw, 7rem);
    overflow: hidden;
    border-top: 1px solid var(--ink);
    background: var(--paper-deep);
  }
  .advisory-section::before {
    position: absolute;
    top: -11vw;
    right: -9vw;
