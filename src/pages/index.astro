    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }
  .offer-grid article {
    min-width: 0;
    min-height: 440px;
    padding: clamp(1.3rem, 2.4vw, 2rem);
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .offer-grid article:first-child {
    background: var(--ink);
    color: var(--paper-bright);
  }
  .offer-grid article.offer-newsletter {
    background: var(--red);
    color: white;
  }
  .offer-index {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .offer-index span {
    color: var(--red);
  }
  .offer-index i {
    color: #736d62;
    font-style: normal;
  }
  .offer-grid article:first-child .offer-index span,
  .offer-grid article.offer-newsletter .offer-index span {
    color: var(--amber);
  }
  .offer-grid article:first-child .offer-index i,
  .offer-grid article.offer-newsletter .offer-index i {
    color: #c6c0b5;
  }
  .offer-grid h3 {
    margin: clamp(2.3rem, 4vw, 3.4rem) 0 1.2rem;
    font-family: "Bodoni Moda", Didot, serif;
    font-size: clamp(2.1rem, 3.2vw, 3.1rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }
  .offer-grid article > p {
    margin: 0;
    color: #5e594f;
    font-size: 0.88rem;
    line-height: 1.65;
  }
  .offer-grid article:first-child > p {
    color: #c4bfb4;
  }
  .offer-grid article.offer-newsletter > p {
    color: #f7d9d3;
  }
  .offer-price {
    margin: 1.7rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid #5d584f;
  }
  .offer-price strong,
  .offer-price span {
    display: block;
  }
  .offer-price strong {
    color: var(--amber);
    font-family: "Bodoni Moda", Didot, serif;
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .offer-price span {
    margin-top: 0.35rem;
    color: #aaa49a;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.53rem;
    line-height: 1.45;
    text-transform: uppercase;
  }
  .offer-grid article > a {
    margin-top: auto;
    padding-top: 1.4rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid currentColor;
    color: inherit;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.66rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }
  .offer-grid article > a:hover {
    color: var(--red);
  }
  .offer-grid article:first-child > a:hover,
  .offer-grid article.offer-newsletter > a:hover {
    color: var(--amber);
  }

  .chapter-register {
    position: absolute;
    top: 2rem;
    left: max(1rem, calc((100vw - 1160px) / 2));
    right: max(1rem, calc((100vw - 1160px) / 2));
    padding-bottom: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid #8e887c;
    color: #726c61;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.59rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .chapter-register-dark {
    border-color: #777166;
    color: #a49e93;
  }
  .eyebrow {
    margin: 0 0 1.1rem;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .eyebrow-light {
    color: var(--amber);
  }

  .book-chapter {
    position: relative;
    min-height: 100svh;
    padding: clamp(7.5rem, 12vw, 10rem) max(1rem, calc((100vw - 1160px) / 2));
    display: flex;
    align-items: center;
    overflow: hidden;
    background: linear-gradient(rgba(25, 25, 21, 0.038) 1px, transparent 1px),
      var(--paper);
    background-size: 100% 29px;
  }
  .book-layout {
    width: min(1160px, 100%);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(300px, 0.78fr) minmax(0, 1.22fr);
    align-items: center;
    gap: clamp(4rem, 9vw, 8rem);
  }
  .book-stage {
    position: relative;
    margin: 0;
  }
  .book-shadow {
    position: absolute;
    inset: 5% -7% -4% 9%;
    background: var(--red);
    transform: rotate(2deg);
  }
  .book-frame {
    position: relative;
    padding: 0.55rem;
    border: 1px solid var(--ink);
    background: #d5cfc1;
    transform: rotate(-1.4deg);
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .book-frame:hover {
    transform: rotate(0) translateY(-8px);
  }
  .book-frame img {
    width: 100%;
    height: auto;
    display: block;
  }
  .book-stage figcaption {
    position: relative;
    margin-top: 1.25rem;
    color: #726c61;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .book-copy {
    position: relative;
  }
  .book-copy h2 {
    max-width: 720px;
    font-size: clamp(3.5rem, 6.2vw, 6.3rem);
    letter-spacing: -0.065em;
    line-height: 0.89;
  }
  .book-copy h2 em {
    display: block;
    color: var(--red);
    font-weight: 500;
  }
  .book-lede {
    max-width: 650px;
    margin: 1.8rem 0 0;
    color: #504c43;
    font-size: clamp(1rem, 1.4vw, 1.13rem);
    line-height: 1.72;
  }
  .book-lede cite {
    color: var(--ink);
    font-family: "Bodoni Moda", Didot, serif;
    font-size: 1.16em;
  }
  .book-stats {
    margin: 2rem 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }
  .book-stats span {
    min-height: 90px;
    padding: 1rem;
    display: grid;
    align-content: center;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.61rem;
    text-transform: uppercase;
  }
  .book-stats strong {
    margin-bottom: 0.2rem;
    color: var(--red);
    font-family: "Bodoni Moda", Didot, serif;
    font-size: 2.2rem;
    font-weight: 500;
    line-height: 1;
  }
  .button {
    min-height: 52px;
    padding: 0.85rem 1.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: white;
    box-shadow: 7px 7px 0 var(--amber);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 170ms ease,
      box-shadow 170ms ease;
  }
  .button:hover {
    box-shadow: 10px 10px 0 var(--amber);
    transform: translate(-2px, -2px);
  }

  .notes-chapter {
    position: relative;
    min-height: 100svh;
    padding: clamp(7rem, 12vw, 10rem) max(1rem, calc((100vw - 1160px) / 2));
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-content: center;
    gap: clamp(3rem, 8vw, 7rem);
    background: linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      var(--red);
    background-size: 100% 29px;
    color: var(--paper-bright);
  }
  .notes-heading h2 {
    max-width: 540px;
    font-size: clamp(3.5rem, 6vw, 6rem);
    letter-spacing: -0.065em;
    line-height: 0.9;
  }
  .notes-heading > p:last-child {
    max-width: 520px;
    color: #f7d9d3;
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .dispatch-list {
    border-top: 1px solid rgba(255, 255, 255, 0.65);
  }
  .dispatch-list article {
    padding: 1.45rem 0;
    display: grid;
    grid-template-columns: 55px 1fr;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.65);
  }
  .dispatch-list article > span {
    color: var(--amber);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.65rem;
  }
  .dispatch-list h3 {
    margin: 0;
    font-family: "Bodoni Moda", Didot, serif;
    font-size: clamp(1.65rem, 2.7vw, 2.4rem);
    font-weight: 500;
    line-height: 1.1;
  }
  .dispatch-list p {
    margin: 0.45rem 0 0;
    color: #f7d9d3;
    line-height: 1.55;
  }
  .notes-cta {
    grid-column: 1 / -1;
    min-height: 118px;
    margin-top: 1rem;
    padding: 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: 0.55fr 1.45fr auto;
    align-items: center;
    gap: 1.5rem;
    border: 1px solid var(--ink);
    background: var(--paper-bright);
    color: var(--ink);
    box-shadow: 10px 10px 0 var(--amber);
    text-decoration: none;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }
  .notes-cta:hover {
    box-shadow: 14px 14px 0 var(--amber);
    transform: translate(-3px, -3px);
  }
  .notes-cta span {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
  }
  .notes-cta strong {
    font-family: "Bodoni Moda", Didot, serif;
    font-size: clamp(1.8rem, 3.2vw, 3.1rem);
    font-weight: 500;
    letter-spacing: -0.045em;
  }
  .notes-cta i {
    color: var(--red);
    font-size: 2rem;
    font-style: normal;
  }

  .work-chapter {
    position: relative;
    min-height: 100svh;
    padding: clamp(8rem, 13vw, 11rem) max(1rem, calc((100vw - 1160px) / 2));
    background: var(--ink);
    color: var(--paper-bright);
  }
  .work-layout {
    width: min(1160px, 100%);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(3rem, 7vw, 7rem);
  }
  .work-heading h2 {
    max-width: 680px;
    font-size: clamp(3.3rem, 5.6vw, 5.7rem);
    letter-spacing: -0.06em;
    line-height: 0.92;
  }
  .work-story {
    color: #c4bfb4;
    line-height: 1.7;
  }
  .work-story .lead {
    margin-top: 0;
    color: var(--paper-bright);
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    font-weight: 650;
    line-height: 1.45;
  }
  .advisory-callout {
    margin-top: 2.2rem;
    padding: 1.35rem;
    border: 1px solid #5d584f;
    border-left: 7px solid var(--red);
    background: #22211d;
  }
  .advisory-callout span {
    color: var(--amber);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .advisory-callout p {
    margin: 0.6rem 0 0;
  }
  .enterprise-proof {
    margin-top: 1.7rem;
    font-size: 0.86rem;
  }
  .enterprise-proof a {
    margin-top: 0.55rem;
    display: block;
    color: var(--paper-bright);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    font-weight: 700;
    text-decoration-color: var(--red-bright);
    text-underline-offset: 5px;
    text-transform: uppercase;
  }
  .expertise-card {
    grid-column: 1 / -1;
    margin-top: 1rem;
    display: grid;
    grid-template-columns: 0.45fr 1.55fr;
    border-top: 1px solid #676158;
  }
  .expertise-card > p {
    margin: 0;
    padding: 1.25rem 0;
    color: var(--amber);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.63rem;
    text-transform: uppercase;
  }
  .expertise-card ul {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    list-style: none;
  }
  .expertise-card li {
    padding: 1.25rem;
    border-right: 1px solid #676158;
    border-bottom: 1px solid #676158;
    color: #d4cfc5;
    font-size: 0.86rem;
  }
  .expertise-card li::before {
    content: "△";
    margin-right: 0.7rem;
    color: var(--red-bright);
    font-family: "IBM Plex Mono", monospace;
  }

  .connect-chapter {
    min-height: 78svh;
    padding: clamp(7rem, 11vw, 9rem) max(1rem, calc((100vw - 1160px) / 2));
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
    background: var(--paper);
  }
  .connect-chapter h2 {
    max-width: 540px;
    font-size: clamp(3.2rem, 5.5vw, 5.4rem);
    letter-spacing: -0.06em;
    line-height: 0.93;
  }
  .connect-lede {
    max-width: 510px;
    margin-top: 1.4rem;
    color: #6b655c;
    line-height: 1.65;
  }
  .link-grid {
    border-top: 1px solid var(--ink);
  }
  .link-grid a {
    min-height: 90px;
    padding: 1rem;
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    text-decoration: none;
    transition:
      background 180ms ease,
      color 180ms ease,
      padding 180ms ease;
  }
  .link-grid a:hover {
    padding-inline: 1.4rem 0.6rem;
    background: var(--red);
    color: white;
  }
  .link-grid small {
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.61rem;
  }
  .link-grid a:hover small {
    color: var(--amber);
  }
  .link-grid strong,
  .link-grid i {
    display: block;
  }
  .link-grid strong {
    font-family: "Bodoni Moda", Didot, serif;
    font-size: 1.8rem;
    font-weight: 500;
  }
  .link-grid i {
    margin-top: 0.15rem;
    color: var(--muted);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.61rem;
    font-style: normal;
  }
  .link-grid a:hover i {
    color: #f4c9c4;
  }
  .link-grid b {
    font-size: 1.35rem;
    font-weight: 400;
  }

  footer {
    min-height: 98px;
    padding-inline: max(1rem, calc((100vw - 1160px) / 2));
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    border-top: 1px solid #4e4a43;
    background: var(--ink);
    color: #918b81;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.61rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  footer p:last-child {
    justify-self: end;
  }
  footer a {
    color: var(--paper-bright);
    text-underline-offset: 5px;
    text-decoration-color: var(--red);
  }

  .motion-ready [data-reveal] {
    opacity: 0;
    transition:
      opacity 750ms ease,
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1),
      clip-path 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .motion-ready [data-reveal="left"] {
    clip-path: inset(0 100% 0 0);
    transform: translateX(-45px);
  }
  .motion-ready [data-reveal="right"] {
    clip-path: inset(0 0 0 100%);
    transform: translateX(45px);
  }
  .motion-ready [data-reveal="up"] {
    transform: translateY(45px);
  }
  .motion-ready [data-reveal].is-visible {
    opacity: 1;
    clip-path: inset(0);
    transform: translate(0);
  }

  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(input:focus-visible) {
    outline: 3px solid var(--amber);
    outline-offset: 4px;
  }

  @keyframes shutter-left {
    to {
      transform: translateX(-102%);
    }
  }
  @keyframes shutter-right {
    to {
      transform: translateX(102%);
    }
  }
  @keyframes slate-out {
    to {
      opacity: 0;
      transform: translate(-50%, -53%) scale(0.98);
    }
  }
  @keyframes sequence-exit {
    to {
      visibility: hidden;
    }
  }
  @keyframes marquee-drift {
    to {
      transform: translateX(-8vw);
    }
  }
  @keyframes scan {
    0% {
      top: -8%;
      opacity: 0;
    }
    12%,
    82% {
      opacity: 0.75;
    }
    100% {
      top: 108%;
      opacity: 0;
    }
  }
  @keyframes signal-pulse {
    50% {
      box-shadow: 0 0 0 8px rgba(239, 116, 109, 0.05);
    }
  }
  @keyframes scroll-line {
    0%,
    100% {
      transform: scaleY(0.28);
    }
    50% {
      transform: scaleY(1);
    }
  }

  @media (max-width: 980px) {
    .mission-nav {
      grid-template-columns: auto 1fr auto;
    }
    .mission-nav nav {
      display: none;
    }
    .hero-cinematic {
      min-height: auto;
      padding-block: 9rem 6rem;
    }
    .hero-stage {
      grid-template-columns: 1fr;
    }
    .hero-stage {
      min-height: auto;
    }
    .operator-console {
      width: min(620px, 100%);
    }
    .hero-share-bar {
      margin-top: 4rem;
    }
    .proof-ribbon {
      grid-template-columns: 1fr 1fr;
    }
    .proof-ribbon > * {
      border-bottom: 1px solid #8e887c;
    }
    .proof-ribbon > *:nth-child(2n) {
      border-right: 1px solid #8e887c;
    }
    .offer-heading,
    .offer-grid {
      grid-template-columns: 1fr;
    }
    .offer-heading .eyebrow {
      margin-bottom: -0.5rem;
    }
    .offer-grid article {
      min-height: 360px;
    }
    .portrait-stage {
      width: min(620px, 100%);
    }
    .book-layout,
    .notes-chapter,
    .work-layout,
    .connect-chapter {
      grid-template-columns: 1fr;
    }
    .book-stage {
      width: min(460px, calc(100% - 1rem));
    }
    .notes-chapter {
      min-height: auto;
    }
  }

  @media (max-width: 680px) {
    :global(html) {
      scroll-padding-top: 4.2rem;
    }
    .mission-nav {
      min-height: 62px;
    }
    .wordmark {
      font-size: 0.68rem;
    }
    .nav-cta {
      min-height: 38px;
      padding-inline: 0.7rem;
      font-size: 0.6rem;
    }
    .nav-cta > span {
      display: none;
    }
    .hero-cinematic {
      padding: 7.6rem 1rem 5.5rem;
    }
    .hero-watermark {
      top: 17%;
      opacity: 0.65;
    }
    .hero-marquee {
      display: none;
    }
    .hero-credit {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.3rem;
    }
    h1 {
      font-size: clamp(3.45rem, 17vw, 5.2rem);
    }
    .hero-copy h1 {
      font-size: clamp(3.15rem, 13.8vw, 4.6rem);
      letter-spacing: -0.075em;
      line-height: 0.88;
    }
    .hero-copy h1 .title-accent {
      font-size: 0.57em;
      line-height: 1.08;
    }
    .hero-intro {
      font-size: 1rem;
    }
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }
    .hero-actions a {
      justify-content: space-between;
    }
    .hero-signup {
      margin-top: 1.25rem;
      box-shadow: 6px 6px 0 var(--red);
    }
    .operator-console {
      margin-top: 1rem;
      padding: 0.8rem;
      box-shadow:
        7px 7px 0 #f2c84b,
        -5px -5px 0 #d62f24;
    }
    .operator-id {
      grid-template-columns: 92px 1fr;
    }
    .hero-share-bar {
      margin-top: 3rem;
      padding-block: 1rem;
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .hero-share-bar > div {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.45rem;
    }
    .hero-share-bar > a {
      justify-content: space-between;
    }
    .portrait-stage {
      padding: 0.7rem;
      box-shadow:
        8px 8px 0 var(--amber),
        -8px -8px 0 rgba(207, 47, 33, 0.7);
    }
    .frame-index,
    .portrait-stage figcaption {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
    .scroll-cue {
      display: none;
    }
    .chapter-register span:last-child {
      display: none;
    }
    .proof-ribbon {
      grid-template-columns: 1fr;
    }
    .proof-ribbon > *,
    .proof-ribbon > *:nth-child(2n) {
      min-height: 92px;
      border-right: 1px solid #8e887c;
    }
    .book-chapter,
    .notes-chapter,
    .work-chapter,
    .offer-chapter,
    .connect-chapter {
      padding-inline: 1rem;
    }
