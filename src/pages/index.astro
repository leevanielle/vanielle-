    text-underline-offset: 5px;
  }
  .hero-secondary a:hover {
    color: white;
  }

  .portrait-stage {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    position: relative;
    margin: 0;
    padding: 1rem;
    border: 1px solid #5d584f;
    background: #0f0f0d;
    box-shadow:
      14px 14px 0 var(--amber),
      -14px -14px 0 rgba(207, 47, 33, 0.7);
    transform: perspective(1100px) rotateX(var(--tilt-y)) rotateY(var(--tilt-x));
    transform-style: preserve-3d;
    transition: transform 180ms ease-out;
  }
  .frame-index,
  .portrait-stage figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #bbb6ad;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.57rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  .frame-index {
    padding: 0 0.15rem 0.8rem;
  }
  .portrait-window {
    position: relative;
    overflow: hidden;
    border: 1px solid #747067;
  }
  .portrait-window img {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(1) contrast(1.08);
    transform: scale(1.015);
  }
  .portrait-window::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
        90deg,
        rgba(239, 116, 109, 0.16) 1px,
        transparent 1px
      ),
      linear-gradient(rgba(239, 116, 109, 0.13) 1px, transparent 1px);
    background-size:
      25% 100%,
      100% 33.333%;
    opacity: 0.25;
  }
  .scan-line {
    position: absolute;
    left: 0;
    right: 0;
    top: -8%;
    z-index: 2;
    height: 2px;
    background: var(--salmon);
    box-shadow: 0 0 18px 4px rgba(239, 116, 109, 0.55);
    animation: scan 4.8s linear infinite;
  }
  .target {
    position: absolute;
    z-index: 3;
    width: 20px;
    height: 20px;
    border-color: var(--salmon);
  }
  .target-a {
    top: 7%;
    left: 6%;
    border-top: 2px solid var(--salmon);
    border-left: 2px solid var(--salmon);
  }
  .target-b {
    right: 6%;
    bottom: 7%;
    border-right: 2px solid var(--salmon);
    border-bottom: 2px solid var(--salmon);
  }
  .portrait-stage figcaption {
    padding: 0.85rem 0.15rem 0;
  }
  .portrait-stage figcaption strong {
    color: var(--amber);
    font-weight: 650;
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.3rem;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    color: #8f8a81;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transform: translateX(-50%);
  }
  .scroll-cue i {
    width: 1px;
    height: 28px;
    display: block;
    background: var(--red-bright);
    transform-origin: top;
    animation: scroll-line 1.8s ease-in-out infinite;
  }

  /* Operator Mode: the X-first opening scene */
  .hero-cinematic {
    min-height: 100svh;
    padding: clamp(7.5rem, 12vh, 9rem) max(1rem, calc((100vw - 1280px) / 2)) 0;
    display: block;
    background: radial-gradient(
        circle at 83% 24%,
        rgba(214, 47, 36, 0.16),
        transparent 24%
      ),
      linear-gradient(105deg, #0a0b0a 0 68%, #121411 68% 100%);
  }
  .hero-cinematic::after {
    background: linear-gradient(
      90deg,
      transparent 0 49.95%,
      rgba(234, 230, 219, 0.045) 50% 50.05%,
      transparent 50.1%
    );
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
        rgba(234, 230, 219, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, rgba(234, 230, 219, 0.025) 1px, transparent 1px);
    background-size:
      100% 32px,
      64px 100%;
    mask-image: linear-gradient(to bottom, black, transparent 92%);
  }
  .hero-watermark {
    position: absolute;
    top: 11%;
    right: -0.05em;
    color: rgba(234, 230, 219, 0.027);
