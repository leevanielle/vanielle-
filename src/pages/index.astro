  .leadership-map > div {
    display: grid;
    grid-template-columns: auto auto auto;
    align-items: center;
    gap: 0.65rem;
    font-family: "IBM Plex Mono", monospace;
  }
  .leadership-map div span {
    grid-column: 1 / -1;
    color: var(--red);
    font-size: 0.52rem;
    text-transform: uppercase;
  }
  .leadership-map div b,
  .leadership-map div strong {
    min-height: 64px;
    padding: 0.7rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    font-size: 0.57rem;
    font-weight: 500;
    text-transform: uppercase;
  }
  .leadership-map div strong {
    background: var(--ink);
    color: var(--paper);
  }
  .leadership-map div i {
    color: var(--red);
    font-style: normal;
  }
  .leadership-map > em {
    max-width: 80px;
    color: #6a645b;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.48rem;
    line-height: 1.45;
    text-align: center;
    text-transform: uppercase;
  }
  .book-section {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
  }
  .book-atmosphere {
    min-height: 70px;
    padding-inline: max(1rem, calc((100vw - 1240px) / 2));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid #5d594f;
    border-bottom: 1px solid #5d594f;
    color: #aaa59b;
