---
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";

const AMAZON_URL = "https://www.amazon.com/dp/B0HF6JW33T";
const LINKEDIN_URL = "https://linkedin.com/in/vanielle";
const FORBES_URL =
  "https://www.forbes.com/sites/jonyounger/2020/11/23/meet-another-freelance-innovator-odecloud-a-netsuite-expert-community/";

const agents = [
  { id: "host", name: "Mochi", label: "Meet", color: "#f0c8bc" },
  { id: "build", name: "Pixel", label: "Build", color: "#a9d8cb" },
  { id: "lead", name: "Atlas", label: "Lead", color: "#e3bd74" },
  { id: "read", name: "Quill", label: "Book", color: "#c7bce8" },
  { id: "notes", name: "Scout", label: "Notes", color: "#a8c9e8" },
  { id: "talk", name: "Miso", label: "Talk", color: "#e9a4a0" },
];
---

<Layout
  title="Vanielle Lee — AI Engineer, Founder & CTO"
  description="Meet Vanielle Lee through a playful constellation of AI, engineering leadership, writing, and founder work."
>
  <div class="atelier-shell" data-atelier>
    <canvas
      class="atelier-canvas"
      data-agent-canvas
      aria-hidden="true"
    ></canvas>
    <div class="aurora" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <header class="atelier-header">
      <a class="wordmark" href="#host" data-mode-shortcut="host">
        <span aria-hidden="true">✦</span>
        Vanielle Lee
      </a>
      <p class="atelier-status">
        <i aria-hidden="true"></i>
        Six agents are awake
      </p>
      <button class="guestbook-trigger" type="button" data-invite-open>
        Join the field notes
      </button>
    </header>

    <main class="studio-grid">
      <section class="intro" aria-labelledby="intro-title">
        <figure class="host-portrait">
          <img
            src="assets/vanielle-profile.jpg"
            width="894"
            height="547"
            alt="Vanielle Lee smiling in a dark turtleneck"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>Human in the loop</figcaption>
        </figure>
        <p class="intro-label">AI engineer · Founder · CTO · Author</p>
        <h1 id="intro-title">I make ambitious technology feel possible.</h1>
        <p class="intro-copy">
          Ten years turning hard technical bets into products, teams, and
          decisions people can trust.
        </p>
        <div class="intro-actions">
          <button type="button" data-invite-open>Start with a note</button>
          <span>or choose an agent ↓</span>
        </div>
      </section>

      <section class="discovery" aria-label="Interactive agent constellation">
        <p class="discovery-hint">
          <span aria-hidden="true">↗</span>
          Tap the agents. They know different parts of my story.
        </p>
        <div class="scene-fallback" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span
          ><span></span>
        </div>
      </section>

      <section class="detail-deck" aria-live="polite" data-detail-deck>
        <article
          class="detail-card host-card is-active"
          id="detail-host"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-host"
          data-detail="host"
        >
          <p class="card-agent"><i></i> Mochi found the short version</p>
          <h2>Engineer brain.<br />Founder nerve.</h2>
          <p>
            Full-stack technical depth with a C-suite view of what the company
            actually needs.
          </p>
          <div class="proof-pills">
            <span><strong>10+</strong> years building</span>
            <span><strong>8</strong> years CTO</span>
          </div>
          <a href={FORBES_URL} target="_blank" rel="noopener noreferrer">
            Featured in Forbes <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article
          class="detail-card"
          id="detail-build"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-build"
          data-detail="build"
          hidden
        >
          <p class="card-agent"><i></i> Pixel opened the workbench</p>
          <h2>Across the whole machine.</h2>
          <p>From the first interface to the agents running underneath it.</p>
          <div class="skill-cloud">
            <span>Agentic AI</span><span>Frontend</span><span>Backend</span
            ><span>Infrastructure</span><span>Data</span><span>Product</span>
          </div>
          <button type="button" data-mode-shortcut="lead">
            Follow the system <span aria-hidden="true">→</span>
          </button>
        </article>

        <article
          class="detail-card"
          id="detail-lead"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-lead"
          data-detail="lead"
          hidden
        >
          <p class="card-agent"><i></i> Atlas brought the company map</p>
          <h2>From codebase to company.</h2>
          <p>Founder and CTO at OdeCloud, translating uncertainty into a bet.</p>
          <div class="client-line">
            <span>JVC Kenwood</span><span>Coinbase</span><span>WarnerMedia</span>
          </div>
          <a href={FORBES_URL} target="_blank" rel="noopener noreferrer">
            Read the OdeCloud feature <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article
          class="detail-card book-card"
          id="detail-read"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-read"
          data-detail="read"
          hidden
        >
          <img
            src="assets/book-cover.jpg?v=3"
            width="1600"
            height="2560"
            alt="Cover of Emperors, Prophets, and Product Managers"
            loading="lazy"
          />
          <div>
            <p class="card-agent"><i></i> Quill saved your place</p>
            <h2>Leadership is ancient chaos.</h2>
            <p>A field guide for the people building through it.</p>
            <a href={AMAZON_URL} target="_blank" rel="noopener noreferrer">
              Read the book <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article
          class="detail-card"
          id="detail-notes"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-notes"
          data-detail="notes"
          hidden
        >
          <p class="card-agent"><i></i> Scout found three useful trails</p>
          <h2>Notes worth keeping.</h2>
          <div class="note-trails">
            <span>AI without the theater</span>
            <span>The industry playbook</span>
            <span>Building across cultures</span>
          </div>
          <button type="button" data-invite-open>
            Get the next note <span aria-hidden="true">→</span>
          </button>
        </article>

        <article
          class="detail-card talk-card"
          id="detail-talk"
          role="tabpanel"
          tabindex="-1"
          aria-labelledby="agent-talk"
          data-detail="talk"
          hidden
        >
          <p class="card-agent"><i></i> Miso reserved thirty minutes</p>
          <h2>Bring one hard decision.</h2>
          <p>AI, architecture, product, or the team around it.</p>
          <strong>From $300/hr</strong>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
            Start a conversation <span aria-hidden="true">↗</span>
          </a>
        </article>
      </section>
    </main>

    <nav class="agent-dock" role="tablist" aria-label="Choose an agent">
      {
        agents.map((agent, index) => (
          <button
            type="button"
            role="tab"
            id={`agent-${agent.id}`}
            aria-controls={`detail-${agent.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
            data-agent-mode={agent.id}
            data-agent-color={agent.color}
          >
            <span
              class="agent-face"
              style={`--agent-color:${agent.color}`}
              aria-hidden="true"
            >
              <i></i><i></i>
            </span>
            <span class="agent-name">
              <small>{agent.name}</small>
              <strong>{agent.label}</strong>
            </span>
          </button>
        ))
      }
    </nav>

    <aside
      class="invitation is-open"
      role="dialog"
      aria-modal="false"
      aria-labelledby="invitation-title"
      data-invitation
    >
      <button
        class="invitation-close"
        type="button"
        aria-label="Explore first"
        data-invite-close
      >
        Explore first <span aria-hidden="true">×</span>
      </button>
      <div class="invitation-orb" aria-hidden="true"><i></i><i></i></div>
      <p class="invitation-label">A note from Vanielle</p>
      <h2 id="invitation-title">Leave your email with the agents.</h2>
      <p>
        They’ll deliver practical notes on AI, careers, leadership, and
        cross-cultural founder life.
      </p>
      <NewsletterSignup />
    </aside>

    <footer class="atelier-footer">
      <span>© {new Date().getFullYear()} Vanielle Lee</span>
      <nav aria-label="Social links">
        <a href="https://x.com/lee_vanielle" target="_blank" rel="noopener noreferrer">X</a>
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/leevanielle" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </footer>
  </div>
</Layout>

<script>
  import * as THREE from "three";

  const shell = document.querySelector("[data-atelier]");
  const canvas = document.querySelector("[data-agent-canvas]");
  const tabs = Array.from(
    document.querySelectorAll("[data-agent-mode]")
  );
  const details = Array.from(
    document.querySelectorAll("[data-detail]")
  );
  const deck = document.querySelector("[data-detail-deck]");
  const invitation = document.querySelector("[data-invitation]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const aliases = {
    lobby: "host",
    lab: "build",
    boardroom: "lead",
    library: "read",
    balcony: "notes",
    salon: "talk",
  };
  const ids = tabs.flatMap(tab =>
    tab.dataset.agentMode ? [tab.dataset.agentMode] : []
  );
  let selectedMode = "host";
  let renderStill;

  const closeInvitation = () => {
    invitation?.classList.remove("is-open");
    invitation?.setAttribute("aria-hidden", "true");
  };

  const openInvitation = () => {
    invitation?.classList.add("is-open");
    invitation?.removeAttribute("aria-hidden");
    window.setTimeout(() => {
      document.querySelector("#newsletter-email")?.focus();
    }, reduceMotion ? 0 : 420);
  };

  const selectMode = (id, options = {}) => {
    if (!ids.includes(id)) return;
    selectedMode = id;
    tabs.forEach(tab => {
      const active = tab.dataset.agentMode === id;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    details.forEach(detail => {
      const active = detail.dataset.detail === id;
      detail.hidden = !active;
      detail.classList.toggle("is-active", active);
    });
    if (options.updateUrl !== false) {
      window.history.replaceState(null, "", `#${id}`);
    }
    if (options.reveal !== false) closeInvitation();
    if (options.focus) {
      document.querySelector(`[data-detail="${id}"]`)?.focus({
        preventScroll: true,
      });
    }
    if (window.innerWidth <= 820 && options.reveal !== false) {
      window.setTimeout(
        () => deck?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" }),
        reduceMotion ? 0 : 180
      );
    }
    renderStill?.();
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      const id = tab.dataset.agentMode;
      if (id) selectMode(id, { focus: true });
    });
    tab.addEventListener("keydown", event => {
      if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) return;
      event.preventDefault();
      const direction = event.key === "ArrowLeft" || event.key === "ArrowUp" ? -1 : 1;
      const next = tabs[(index + direction + tabs.length) % tabs.length];
      const id = next?.dataset.agentMode;
      next?.focus();
      if (id) selectMode(id);
    });
  });

  document.querySelectorAll("[data-mode-shortcut]").forEach(button => {
    button.addEventListener("click", event => {
      event.preventDefault();
      const id = button.dataset.modeShortcut;
      if (id) selectMode(id, { focus: true });
    });
  });
  document.querySelectorAll("[data-invite-open]").forEach(button =>
    button.addEventListener("click", openInvitation)
  );
  document.querySelector("[data-invite-close]")?.addEventListener("click", closeInvitation);

  const rawHash = window.location.hash.slice(1);
  const initialId = (ids.includes(rawHash)
    ? rawHash
    : aliases[rawHash]);
  selectMode(initialId ?? "host", {
    updateUrl: false,
    reveal: Boolean(initialId),
  });
  if (initialId) closeInvitation();

  window.addEventListener("hashchange", () => {
    const raw = window.location.hash.slice(1);
    const id = ids.includes(raw) ? raw : aliases[raw];
    if (id) selectMode(id, { updateUrl: false });
  });

  if (canvas && shell) {
    try {
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: "high-performance",
      });
      renderer.setClearColor(0x000000, 0);
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;

      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x0b1110, 0.065);
      const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
      camera.position.set(0, 0.25, 8.4);

      scene.add(new THREE.HemisphereLight(0xf8f1df, 0x19352e, 2.1));
      const key = new THREE.PointLight(0xffd7bc, 17, 20);
      key.position.set(-3, 4, 5);
      scene.add(key);
      const mint = new THREE.PointLight(0x8bd7c7, 13, 18);
      mint.position.set(4, -2, 4);
      scene.add(mint);

      const core = new THREE.Group();
      const coreMesh = new THREE.Mesh(
        new THREE.IcosahedronGeometry(1.05, 5),
        new THREE.MeshPhysicalMaterial({
          color: 0xf5eadc,
          roughness: 0.13,
          metalness: 0.02,
          clearcoat: 1,
          clearcoatRoughness: 0.12,
          transmission: 0.2,
          thickness: 1.5,
          iridescence: 0.5,
          iridescenceIOR: 1.3,
        })
      );
      const coreGlow = new THREE.Mesh(
        new THREE.SphereGeometry(1.22, 48, 48),
        new THREE.MeshBasicMaterial({
          color: 0xbce7dc,
          transparent: true,
          opacity: 0.055,
          side: THREE.BackSide,
        })
      );
      core.add(coreMesh, coreGlow);
      scene.add(core);

      const configs = [
        { id: "host", color: 0xf0c8bc, angle: 0.1, speed: 0.12 },
        { id: "build", color: 0xa9d8cb, angle: 1.1, speed: 0.1 },
        { id: "lead", color: 0xe3bd74, angle: 2.15, speed: 0.085 },
        { id: "read", color: 0xc7bce8, angle: 3.15, speed: 0.11 },
        { id: "notes", color: 0xa8c9e8, angle: 4.2, speed: 0.09 },
        { id: "talk", color: 0xe9a4a0, angle: 5.25, speed: 0.105 },
      ];
      const bodies = [];

      configs.forEach(config => {
        const group = new THREE.Group();
        group.userData.agentId = config.id;
        const body = new THREE.Mesh(
          new THREE.SphereGeometry(0.34, 32, 32),
          new THREE.MeshPhysicalMaterial({
            color: config.color,
            roughness: 0.22,
            clearcoat: 1,
            clearcoatRoughness: 0.08,
          })
        );
        body.userData.agentId = config.id;
        bodies.push(body);

        const eyeMaterial = new THREE.MeshStandardMaterial({ color: 0x17201d, roughness: 0.4 });
        const eyes = [-0.1, 0.1].map(x => {
          const eye = new THREE.Mesh(new THREE.SphereGeometry(0.042, 16, 16), eyeMaterial);
          eye.position.set(x, 0.055, 0.32);
          return eye;
        });
        const antenna = new THREE.Mesh(
          new THREE.CylinderGeometry(0.012, 0.012, 0.21, 10),
          new THREE.MeshStandardMaterial({ color: config.color, metalness: 0.2, roughness: 0.3 })
        );
        antenna.position.y = 0.41;
        antenna.rotation.z = -0.18;
        const antennaTip = new THREE.Mesh(
          new THREE.SphereGeometry(0.055, 16, 16),
          new THREE.MeshBasicMaterial({ color: config.color })
        );
        antennaTip.position.set(0.035, 0.52, 0);
        const halo = new THREE.Mesh(
          new THREE.TorusGeometry(0.48, 0.012, 12, 72),
          new THREE.MeshBasicMaterial({ color: config.color, transparent: true, opacity: 0.42 })
        );
        halo.rotation.x = Math.PI / 2.4;
        group.add(body, ...eyes, antenna, antennaTip, halo);
        scene.add(group);
        config.group = group;
        config.eyes = eyes;
        config.body = body;
      });

      const dustGeometry = new THREE.BufferGeometry();
      const dustPositions = new Float32Array(240 * 3);
      for (let i = 0; i < dustPositions.length; i += 3) {
        dustPositions[i] = (Math.random() - 0.5) * 12;
        dustPositions[i + 1] = (Math.random() - 0.5) * 7;
        dustPositions[i + 2] = (Math.random() - 0.5) * 5 - 1;
      }
      dustGeometry.setAttribute("position", new THREE.BufferAttribute(dustPositions, 3));
      scene.add(
        new THREE.Points(
          dustGeometry,
          new THREE.PointsMaterial({ color: 0xf7e7c5, size: 0.024, transparent: true, opacity: 0.34 })
        )
      );

      const connectionPositions = new Float32Array(configs.length * 6);
      const connections = new THREE.LineSegments(
        new THREE.BufferGeometry().setAttribute(
          "position",
          new THREE.BufferAttribute(connectionPositions, 3)
        ),
        new THREE.LineBasicMaterial({ color: 0x9bcfc2, transparent: true, opacity: 0.14 })
      );
      scene.add(connections);

      const pointer = new THREE.Vector2(4, 4);
      const pointerEase = new THREE.Vector2(0, 0);
      const raycaster = new THREE.Raycaster();
      const clock = new THREE.Clock();

      const resize = () => {
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        if (!width || !height) return;
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.65));
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };
      resize();
      new ResizeObserver(() => {
        resize();
        if (reduceMotion) draw(0);
      }).observe(canvas);

      const draw = elapsed => {
        pointerEase.lerp(pointer, 0.035);
        core.rotation.x = reduceMotion ? 0.15 : elapsed * 0.12;
        core.rotation.y = reduceMotion ? -0.25 : elapsed * 0.16;
        core.position.y = reduceMotion ? 0 : Math.sin(elapsed * 0.8) * 0.08;

        configs.forEach((config, index) => {
          if (!config.group) return;
          const active = config.id === selectedMode;
          const angle = config.angle + (reduceMotion ? 0 : elapsed * config.speed);
          const radius = active ? 1.62 : 2.48;
          const target = new THREE.Vector3(
            Math.cos(angle) * radius,
            Math.sin(angle) * radius * 0.58,
            active ? 1.05 : Math.sin(angle * 1.7) * 0.42
          );
          if (active) {
            target.x *= 0.62;
            target.y *= 0.62;
          }
          config.group.position.lerp(target, reduceMotion ? 1 : 0.055);
          const scale = active ? 1.38 : 0.92;
          config.group.scale.lerp(new THREE.Vector3(scale, scale, scale), reduceMotion ? 1 : 0.08);
          config.group.rotation.y = reduceMotion ? 0 : Math.sin(elapsed * 0.7 + index) * 0.14;
          config.group.rotation.z = reduceMotion ? 0 : Math.sin(elapsed * 0.9 + index) * 0.09;
          config.eyes?.forEach(eye => {
            const blink = Math.sin(elapsed * 0.75 + index * 2.2) > 0.985 ? 0.12 : 1;
            eye.scale.y = blink;
          });
          const offset = index * 6;
          connectionPositions[offset] = 0;
          connectionPositions[offset + 1] = core.position.y;
          connectionPositions[offset + 2] = 0;
          connectionPositions[offset + 3] = config.group.position.x;
          connectionPositions[offset + 4] = config.group.position.y;
          connectionPositions[offset + 5] = config.group.position.z;
        });
        connections.geometry.attributes.position.needsUpdate = true;
        camera.position.x += (pointerEase.x * 0.34 - camera.position.x) * 0.025;
        camera.position.y += (0.25 + pointerEase.y * 0.24 - camera.position.y) * 0.025;
        camera.lookAt(0, 0, 0);
        renderer.render(scene, camera);
      };

      const animate = () => {
        draw(clock.getElapsedTime());
        if (!reduceMotion) window.requestAnimationFrame(animate);
      };
      renderStill = () => draw(clock.getElapsedTime());
      animate();

      canvas.addEventListener("pointermove", event => {
        const rect = canvas.getBoundingClientRect();
        pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hovered = raycaster.intersectObjects(bodies, false)[0]?.object;
        canvas.style.cursor = hovered?.userData.agentId ? "pointer" : "default";
      });
      canvas.addEventListener("pointerleave", () => {
        pointer.set(4, 4);
        canvas.style.cursor = "default";
      });
      canvas.addEventListener("click", event => {
        const rect = canvas.getBoundingClientRect();
        pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hit = raycaster.intersectObjects(bodies, false)[0]?.object;
        const id = hit?.userData.agentId;
        if (id) document.querySelector(`[data-agent-mode="${id}"]`)?.click();
      });
    } catch {
      shell.classList.add("no-webgl");
    }
  }
</script>

<style>
  :global(html) {
    background: #0b1110;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #0b1110;
    color: #f7f3eb;
    font-family: "Manrope", "DM Sans", sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global([hidden]) {
    display: none !important;
  }

  .atelier-shell {
    --ink: #0b1110;
    --lacquer: #111a17;
    --porcelain: #f7f3eb;
    --jade: #a9d8cb;
    --rose: #e9a4a0;
    --brass: #e3bd74;
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 47%, rgba(94, 147, 133, 0.21), transparent 28%),
      radial-gradient(circle at 82% 14%, rgba(116, 92, 145, 0.15), transparent 24%),
      linear-gradient(145deg, #101a17, #0a0f0e 68%);
  }

  .atelier-canvas,
  .aurora,
  .grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .atelier-canvas {
    z-index: 1;
    display: block;
  }

  .aurora {
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 48% 53%, rgba(169, 216, 203, 0.16), transparent 25%),
      radial-gradient(ellipse at 50% 58%, rgba(227, 189, 116, 0.09), transparent 38%);
    filter: blur(22px);
    animation: breathe 8s ease-in-out infinite alternate;
  }

  .grain {
    z-index: 3;
    pointer-events: none;
    opacity: 0.08;
