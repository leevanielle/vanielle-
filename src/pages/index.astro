---
import Layout from "@layouts/Layout.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";

const AMAZON_URL = "https://www.amazon.com/dp/B0HF6JW33T";
const LINKEDIN_URL = "https://linkedin.com/in/vanielle";
const FORBES_URL =
  "https://www.forbes.com/sites/jonyounger/2020/11/23/meet-another-freelance-innovator-odecloud-a-netsuite-expert-community/";

const agents = [
  { id: "host", name: "Mochi", label: "Meet", color: "#cf2f21", x: 54, y: 322 },
  {
    id: "build",
    name: "Pixel",
    label: "Build",
    color: "#d4a33b",
    x: 155,
    y: 212,
  },
  {
    id: "lead",
    name: "Atlas",
    label: "Lead",
    color: "#191915",
    x: 255,
    y: 271,
  },
  {
    id: "read",
    name: "Quill",
    label: "Book",
    color: "#ef746d",
    x: 356,
    y: 150,
  },
  {
    id: "notes",
    name: "Scout",
    label: "Notes",
    color: "#716c61",
    x: 446,
    y: 215,
  },
  { id: "talk", name: "Miso", label: "Talk", color: "#9f2018", x: 507, y: 94 },
];
---

<Layout
  title="Vanielle Lee — AI Engineer, Founder & CTO"
  description="Meet Vanielle Lee through her work in AI, engineering leadership, writing, and company building."
>
  <div class="atelier-shell simple-flow" data-atelier>
    <div class="sheet-texture" aria-hidden="true"></div>

    <header class="atelier-header">
      <a class="wordmark" href="#host">
        <span aria-hidden="true">✦</span>
         Vanielle Lee
      </a>
      <div class="header-signup">
        <NewsletterSignup compact />
      </div>
    </header>

    <main class="studio-grid">
      <section class="intro" id="host" aria-labelledby="intro-title">
        <figure class="host-portrait">
          <img
            src="assets/vanielle-profile.jpg"
            width="894"
            height="547"
            alt="Vanielle Lee smiling in a dark turtleneck"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>Human in the loop</figcaption>
        </figure>
        <p class="intro-label">AI engineer · Founder · CTO · Author</p>
        <h1 id="intro-title">I make ambitious technology feel possible.</h1>
        <p class="intro-copy">
          Ten years turning hard technical bets into products, teams, and
          decisions people can trust.
        </p>
        <div class="intro-actions">
          <a href="#newsletter-form">Get the field notes</a>
          <span>or see the work ↓</span>
        </div>
      </section>

      <section class="discovery" aria-label="Map of Vanielle's work">
        <p class="discovery-hint">
          <span aria-hidden="true">✦</span>
           The field map
        </p>
        <div class="field-board" data-field-board aria-hidden="true">
          <header>
            <span>AGENT FIELD SYSTEM / 001</span>
            <strong>THE WORK</strong>
          </header>
          <svg viewBox="0 0 560 420" role="presentation">
            <defs>
              <pattern
                id="manual-grid"
                width="28"
                height="28"
                patternUnits="userSpaceOnUse"
              >
                <path
                  d="M 28 0 L 0 0 0 28"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="0.65"></path>
              </pattern>
            </defs>
            <rect class="board-grid" x="1" y="1" width="558" height="418" rx="5"
            ></rect>
            <path
              class="rail-shadow"
              d="M54 322 C95 322 108 212 155 212 S205 292 255 271 S305 150 356 150 S404 234 446 215 S486 112 507 94"
            ></path>
            <path
              class="agent-rail"
              d="M54 322 C95 322 108 212 155 212 S205 292 255 271 S305 150 356 150 S404 234 446 215 S486 112 507 94"
            ></path>
            {
              agents.map((agent, index) => (
                <g
                  class="rail-station"
                  transform={`translate(${agent.x} ${agent.y})`}
                  style={`--station-color:${agent.color}`}
                >
                  <circle class="station-ring" r="20" />
                  <circle class="station-face" r="12" />
                  <circle class="station-eye" cx="-4" cy="-1" r="1.6" />
                  <circle class="station-eye" cx="4" cy="-1" r="1.6" />
                  <path class="station-antenna" d="M0 -12 V-18 L4 -21" />
                  <text x="0" y="34">
                    {String(index + 1).padStart(2, "0")}
                  </text>
                </g>
              ))
            }
            <g class="board-ticks">
              <path d="M24 24 h28 M24 24 v28 M536 396 h-28 M536 396 v-28"
              ></path>
              <text x="24" y="390">BUILD / LEAD / WRITE</text>
              <text x="536" y="40" text-anchor="end">HUMAN IN THE LOOP</text>
            </g>
          </svg>
          <footer>
            <span>A quiet map of the work</span>
            <strong>06 stations</strong>
          </footer>
        </div>
      </section>

      <section class="detail-deck" aria-live="polite" data-detail-deck>
        <article class="detail-card" id="build" aria-label="Engineering range">
          <p class="card-agent"><i></i> Pixel opened the workbench</p>
          <h2>Across the whole machine.</h2>
          <p>From the first interface to the agents running underneath it.</p>
          <div class="skill-cloud">
            <span>Agentic AI</span><span>Frontend</span><span>Backend</span
            ><span>Infrastructure</span><span>Data</span><span>Product</span>
          </div>
          <a href="#lead">
            Follow the system <span aria-hidden="true">→</span>
          </a>
        </article>

        <article
          class="detail-card"
          id="lead"
          aria-label="Leadership experience"
        >
          <p class="card-agent"><i></i> Atlas brought the company map</p>
          <h2>From codebase to company.</h2>
          <p>
            Founder and CTO at OdeCloud, translating uncertainty into a bet.
          </p>
          <div class="client-line">
            <span>JVC Kenwood</span><span>Coinbase</span><span>WarnerMedia</span
            >
          </div>
          <a href={FORBES_URL} target="_blank" rel="noopener noreferrer">
            Read the OdeCloud feature <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article
          class="detail-card book-card"
          id="book"
          aria-label="Vanielle's book"
        >
          <img
            src="assets/book-cover.jpg?v=3"
            width="1600"
            height="2560"
            alt="Cover of Emperors, Prophets, and Product Managers"
            loading="lazy"
          />
          <div>
            <p class="card-agent"><i></i> Quill saved your place</p>
            <h2>Leadership is ancient chaos.</h2>
            <p>A field guide for the people building through it.</p>
            <a href={AMAZON_URL} target="_blank" rel="noopener noreferrer">
              Read the book <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article
          class="detail-card"
          id="notes"
          aria-label="Vanielle's field notes"
        >
          <p class="card-agent"><i></i> Scout found three useful trails</p>
          <h2>Notes worth keeping.</h2>
          <div class="note-trails">
            <span>AI without the theater</span>
            <span>The industry playbook</span>
            <span>Building across cultures</span>
          </div>
          <a href="#newsletter-form">
            Join the field notes <span aria-hidden="true">→</span>
          </a>
        </article>

        <article
          class="detail-card talk-card"
          id="talk"
          aria-label="Consulting with Vanielle"
        >
          <p class="card-agent"><i></i> Miso reserved thirty minutes</p>
          <h2>Bring one hard decision.</h2>
          <p>AI, architecture, product, or the team around it.</p>
          <strong>From $300/hr</strong>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
            Start a conversation <span aria-hidden="true">↗</span>
          </a>
        </article>
      </section>
    </main>

    <footer class="atelier-footer">
      <span>© {new Date().getFullYear()} Vanielle Lee</span>
      <nav aria-label="Social links">
        <a
          href="https://x.com/lee_vanielle"
          target="_blank"
          rel="noopener noreferrer">X</a
        >
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
        <a
          href="https://github.com/leevanielle"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </nav>
    </footer>
  </div>
</Layout>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>('a[href="#newsletter-form"]')
    .forEach(link => {
      link.addEventListener("click", event => {
        event.preventDefault();
        document.querySelector<HTMLInputElement>("#newsletter-email")?.focus();
      });
    });

  const centerHashTarget = () => {
    const id = window.location.hash.slice(1);
    if (!id || id === "host") return;
    window.requestAnimationFrame(() => {
      const previousBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = "auto";
      document.getElementById(id)?.scrollIntoView({ block: "center" });
      document.documentElement.style.scrollBehavior = previousBehavior;
    });
  };

  if (window.location.hash && window.location.hash !== "#host")
    centerHashTarget();
  window.addEventListener("hashchange", centerHashTarget);
</script>

<style>
  :global(html) {
    background: #f2eee4;
    scroll-behavior: smooth;
    scroll-snap-type: y proximity;
  }

  :global(body) {
    margin: 0;
    background: #f2eee4;
    color: #191915;
    font-family: "Manrope", "DM Sans", sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global([hidden]) {
    display: none !important;
  }

  .atelier-shell {
    --ink: #191915;
    --paper: #f2eee4;
    --paper-bright: #fbf8ef;
    --red: #cf2f21;
    --red-dark: #9f2018;
    --amber: #d4a33b;
    --salmon: #ef746d;
    --muted: #716c61;
    --porcelain: var(--paper);
    --jade: var(--red);
    --rose: var(--salmon);
    --brass: var(--amber);
    position: relative;
    min-height: 100svh;
    overflow-x: hidden;
    overflow-y: visible;
    background: linear-gradient(rgba(25, 25, 21, 0.045) 1px, transparent 1px),
      var(--paper);
    background-position-y: var(--story-shift, 0px);
    background-size: 100% 28px;
  }

  .sheet-texture {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100svh;
    pointer-events: none;
    opacity: 0.12;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E");
    mix-blend-mode: multiply;
  }

  .atelier-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 10;
    min-height: 74px;
    padding: 0 1.6rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid rgba(25, 25, 21, 0.28);
    background: rgba(242, 238, 228, 0.9);
    backdrop-filter: blur(16px);
  }

  .wordmark,
  .atelier-header button,
  .intro-actions > a,
  .detail-card a,
  .detail-card button {
    color: inherit;
    font: inherit;
  }

  .wordmark {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .wordmark span {
    color: var(--red);
  }

  .atelier-status {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: rgba(25, 25, 21, 0.55);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .atelier-status i {
    width: 7px;
    height: 7px;
    display: block;
    border-radius: 50%;
    border-radius: 0;
    background: var(--red);
    box-shadow: 0 0 0 4px rgba(207, 47, 33, 0.1);
  }

  .guestbook-trigger {
    justify-self: end;
    min-height: 42px;
    padding: 0 0.95rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: #f2eee4;
    -webkit-text-fill-color: #f2eee4;
    box-shadow: 4px 4px 0 var(--red);
    cursor: pointer;
    font-size: 0.68rem;
  }

  .studio-grid {
    position: fixed;
    inset: 74px 0 0;
    z-index: 5;
    height: calc(100svh - 74px);
    padding: 4rem clamp(1.4rem, 4vw, 4.5rem);
    display: grid;
    grid-template-columns: minmax(250px, 0.82fr) minmax(300px, 1.45fr) minmax(
        300px,
        0.92fr
      );
    gap: clamp(1rem, 3vw, 3.2rem);
    pointer-events: none;
  }

  .intro,
  .detail-deck,
  .discovery-hint {
    pointer-events: auto;
  }

  .intro {
    align-self: center;
    max-width: 360px;
    transition:
      opacity 600ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 600ms ease;
  }

  .atelier-shell.has-scrolled .intro {
    opacity: 0.12;
    filter: blur(1px);
    transform: translateX(-18px) scale(0.98);
  }

  .host-portrait {
    width: min(220px, 100%);
    margin: 0 0 1.4rem;
  }

  .host-portrait img {
    width: 100%;
    height: auto;
    display: block;
    border: 2px solid var(--ink);
    border-radius: 4px;
    object-fit: cover;
    filter: saturate(0.72);
    box-shadow: 6px 6px 0 var(--red);
  }

  .host-portrait figcaption {
    width: max-content;
    margin-top: 0.45rem;
    color: rgba(25, 25, 21, 0.52);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.48rem;
    text-transform: uppercase;
  }

  .intro-label,
  .card-agent,
  .invitation-label {
    margin: 0;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: "Bodoni Moda", "Newsreader", Georgia, serif;
    font-weight: 500;
    text-wrap: balance;
  }

  h1 {
    margin-top: 0.8rem;
    font-size: clamp(2.55rem, 4.1vw, 4.35rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .intro-copy {
    max-width: 340px;
    margin: 1.1rem 0 0;
    color: rgba(25, 25, 21, 0.68);
    font-size: clamp(0.82rem, 1vw, 0.98rem);
    line-height: 1.68;
  }

  .intro-actions {
    margin-top: 1.35rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .intro-actions > a,
  .detail-card > button,
  .detail-card a {
    min-height: 42px;
    padding: 0.65rem 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 0;
    border-radius: 3px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 5px 5px 0 var(--red);
    cursor: pointer;
    font-size: 0.64rem;
    font-weight: 700;
    text-decoration: none;
  }

  .atelier-shell .intro-actions > a {
    color: #f2eee4;
    -webkit-text-fill-color: #f2eee4;
  }

  .intro-actions span {
    color: rgba(25, 25, 21, 0.5);
    font-size: 0.58rem;
  }

  .discovery {
    position: relative;
    min-height: 420px;
  }

  .discovery-hint {
    position: absolute;
    top: 4%;
    left: 50%;
    width: 180px;
    margin: 0;
    display: flex;
    gap: 0.65rem;
    color: rgba(25, 25, 21, 0.5);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.52rem;
    line-height: 1.55;
    transform: translateX(-50%);
  }

  .discovery-hint span {
    color: var(--red);
  }

  .field-board {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(118%, 690px);
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 4px;
    background: var(--paper-bright);
    box-shadow: 11px 11px 0 var(--amber);
    transform: translate(-50%, -48%) rotate(var(--board-tilt, 0deg));
    transform-origin: center;
    transition:
      transform 120ms ease-out,
      opacity 350ms ease;
  }

  .field-board header,
  .field-board footer {
    min-height: 38px;
    padding: 0 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-color: var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.48rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .field-board header {
    justify-content: space-between;
    border-bottom: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .field-board header strong {
    color: var(--salmon);
  }

  .field-board svg {
    width: 100%;
    height: auto;
    display: block;
    color: rgba(25, 25, 21, 0.16);
  }

  .board-grid {
    fill: url(#manual-grid);
    stroke: none;
  }

  .rail-shadow,
  .agent-rail {
    fill: none;
    stroke-linecap: round;
  }

  .rail-shadow {
    stroke: var(--amber);
    stroke-width: 13;
    opacity: 0.32;
  }

  .agent-rail {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-dasharray: 4 7;
  }

  .rail-station {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 240ms ease,
      scale 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rail-station:not(.is-active) {
    opacity: 0.58;
  }

  .rail-station.is-active {
    opacity: 1;
    scale: 1.18;
  }

  .station-ring {
    fill: var(--paper-bright);
    stroke: var(--station-color);
    stroke-width: 2;
  }

  .rail-station.is-active .station-ring {
    fill: var(--station-color);
    stroke: var(--ink);
  }

  .station-face {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
  }

  .station-eye {
    fill: var(--ink);
  }

  .station-antenna {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  .rail-station text,
  .board-ticks text {
    fill: var(--muted);
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
    text-anchor: middle;
  }

  .traveler-signal {
    fill: var(--red);
    opacity: 0.14;
    animation: traveler-ping 1.8s ease-out infinite;
  }

  .traveler-face {
    fill: var(--red);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .traveler-eye {
    fill: var(--paper-bright);
  }

  .traveler-antenna {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }

  .board-ticks path {
    fill: none;
    stroke: var(--red);
    stroke-width: 2;
  }

  .board-ticks text {
    text-anchor: start;
  }

  .field-board footer {
    border-top: 1px solid var(--ink);
    color: var(--muted);
  }

  .field-board footer i {
    height: 3px;
    flex: 1;
    overflow: hidden;
    background: rgba(25, 25, 21, 0.14);
  }

  .field-board footer b {
    width: 100%;
    height: 100%;
    display: block;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
  }

  .field-board footer strong {
    color: var(--ink);
  }

  .detail-deck {
    align-self: center;
    min-width: 0;
  }

  .story-meter {
    position: fixed;
    top: 94px;
    left: 50%;
    z-index: 12;
    width: min(210px, 32vw);
    color: rgba(25, 25, 21, 0.48);
    font-family: "IBM Plex Mono", monospace;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .story-track {
    width: 100%;
    height: 1px;
    display: block;
    overflow: hidden;
    background: rgba(25, 25, 21, 0.16);
  }

  .story-track i {
    width: 100%;
    height: 100%;
    display: block;
    background: linear-gradient(90deg, var(--red), var(--amber), var(--salmon));
    transform: scaleX(0);
    transform-origin: left center;
  }

  .story-meter p {
    margin: 0.5rem 0 0;
    display: flex;
    align-items: baseline;
    gap: 0.22rem;
    font-size: 0.46rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .story-meter b {
    color: var(--ink);
    font-size: 0.62rem;
  }

  .story-meter em {
    font-style: normal;
    opacity: 0.44;
  }

  .story-meter strong {
    margin-left: auto;
    color: var(--red);
    font-size: 0.48rem;
  }

  .scroll-story {
    position: relative;
    z-index: 0;
    pointer-events: none;
  }

  .scroll-story section {
    height: 100svh;
    position: relative;
    scroll-snap-align: start;
  }

  .scroll-story section > span {
    position: absolute;
    right: 1.5rem;
    top: 50%;
    color: rgba(25, 25, 21, 0.18);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.46rem;
    letter-spacing: 0.08em;
    writing-mode: vertical-rl;
  }

  .detail-card {
    width: min(370px, 100%);
    min-height: 350px;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border: 2px solid var(--ink);
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 9px 9px 0 var(--red);
  }

  .detail-card.is-active {
    animation: card-arrival 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .detail-card > button,
  .detail-card a {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--red);
  }

  .card-agent {
