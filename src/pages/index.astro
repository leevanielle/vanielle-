  .diagnostic-heading i {
    color: #e24738;
    font-style: normal;
  }
  .diagnostic-list {
    border-top: 1px solid #4e504a;
  }
  .diagnostic-list > div {
    --diagnostic-score: 0%;
    position: relative;
    min-height: 34px;
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 0.55rem;
    border-bottom: 1px solid #31332f;
    overflow: hidden;
    font-size: 0.55rem;
    text-transform: uppercase;
